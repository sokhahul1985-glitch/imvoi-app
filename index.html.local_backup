                <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap; width: 100%;">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <div style="font-size: 1.6rem;">👥</div>
                        <div>
                            <div style="font-weight: 800; font-size: 16.5px; color: #0284c7;" id="gmmTitle">📋 គ្រប់គ្រងសមាជិកក្រុម</div>
                            <div style="font-size: 12.5px; color: #475569; font-weight: 700;" id="gmmSubTitle">👤 គ្រប់គ្រងសមាជិកក្រុម: -</div>
                        </div>
                    </div>

                    <input type="hidden" id="gmmAgencyCompany" value="">

                    <div style="display: flex; align-items: center; gap: 10px; background: #ffffff; border: 2px solid #0284c7; border-radius: 8px; padding: 6px 12px; box-shadow: 0 2px 5px rgba(2,132,199,0.1); flex-wrap: wrap; flex: 1;">
                        <div style="display: flex; align-items: center; gap: 5px;">
                            <label id="gmmLblTravelDate" style="font-weight: 800; font-size: 13.5px; color: #0f172a; white-space: nowrap;">📅 ថ្ងៃធ្វើដំណើរ:</label>
                            <input type="date" id="gmmTravelDate" class="form-input" style="height: 34px; font-weight: 800; border: 1.5px solid #38bdf8; border-radius: 6px; padding: 3px 8px; font-size: 13.5px; color-scheme: light; cursor: pointer; color: #0f172a;" onclick="this.showPicker()" onkeydown="handleGmmHeaderKeydown(event, this)">
                        </div>
                        <div style="display: flex; align-items: center; gap: 5px;">
                            <label style="font-weight: 800; font-size: 13.5px; color: #0f172a; white-space: nowrap;">🧾 លេខវិក្កយបត្រ:</label>
                            <input type="text" id="gmmReceiptNo" class="form-input highlight-input" placeholder="INV 00001" style="height: 34px; font-weight: 800; border: 2px solid #0284c7; border-radius: 6px; padding: 3px 10px; font-size: 14px; width: 110px; background: #e0f2fe; color: #0369a1; text-align: center;" onfocus="this.select()" onkeydown="handleGmmHeaderKeydown(event, this)">
                        </div>
                        <div style="display: flex; align-items: center; gap: 5px;">
                            <label style="font-weight: 800; font-size: 13.5px; color: #0f172a; white-space: nowrap;">💱 អត្រាប្តូរប្រាក់:</label>
                            <input type="number" step="0.1" id="gmmExchangeRate" class="form-input highlight-input" placeholder="33.90" value="33.90" style="height: 34px; font-weight: 800; border: 2px solid #eab308; border-radius: 6px; padding: 3px 8px; font-size: 14px; width: 75px; text-align: center; background: #fef9c3; color: #854d0e;" onfocus="this.select()" onkeydown="handleGmmHeaderKeydown(event, this)">
                        </div>
                        <div style="display: flex; align-items: center; gap: 5px; flex: 1; min-width: 230px;">
                            <label style="font-weight: 800; font-size: 13.5px; color: #0f172a; white-space: nowrap;">👤 អ្នកនាំ/បញ្ជូន <span style="color: #ef4444; font-size: 15px;">*</span>:</label>
                            <input type="text" id="gmmSenderName" class="form-input" placeholder="បញ្ចូលឈ្មោះអ្នកនាំ..." required style="height: 34px; font-weight: 800; border: 2px solid #0284c7; border-radius: 6px; padding: 3px 12px; font-size: 14px; flex: 1; width: 100%; min-width: 180px; color: #0f172a;" onfocus="this.select()" onkeydown="handleGmmHeaderKeydown(event, this)">
                        </div>
                    </div>

