                            <th style="padding: 5px 2px; border: 1px solid #0284c7; width: 28px; text-align: center; white-space: nowrap;">No</th>
                            <th style="padding: 5px 6px; border: 1px solid #0284c7; text-align: left;">Customer Name</th>
