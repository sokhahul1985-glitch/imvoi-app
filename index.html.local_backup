                <!-- 3. Visa Services Poster Card -->
                <div id="posterCard_visa" class="vip-poster-card-container" style="display: none; width: 100%; max-width: 575px; background: linear-gradient(180deg, #071226 0%, #030814 60%, #02040a 100%); border: 2.5px solid transparent; background-image: linear-gradient(180deg, #071226, #02040a), linear-gradient(135deg, #10b981 0%, #06b6d4 35%, #ec4899 75%, #fbbf24 100%); background-origin: border-box; background-clip: padding-box, border-box; border-radius: 26px; padding: 0; box-shadow: 0 0 45px rgba(16, 185, 129, 0.38), 0 25px 60px rgba(0, 0, 0, 0.95); color: #ffffff; font-family: 'Montserrat', 'Noto Sans Khmer', sans-serif; box-sizing: border-box; position: relative; overflow: hidden; flex-shrink: 0;">
                    
