                <div style="display: flex; align-items: center; gap: 16px; flex-wrap: wrap;">
                    <div style="font-weight: 800; font-size: 15px; color: #059669;" id="gmmGrandTotalDisplay">💵 សរុបទឹកប្រាក់ក្នុងក្រុម: $0.00</div>
                </div>
                <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                    <button type="button" class="btn-sys" style="background: linear-gradient(135deg, #059669, #10b981); color: #ffffff; padding: 8px 20px; font-size: 14px; font-weight: 800; border-radius: 6px; border: none; cursor: pointer; display: flex; align-items: center; gap: 6px; box-shadow: 0 2px 6px rgba(5,150,105,0.3);" id="btnGmmSave" onclick="saveGroupMembersChanges()">💾 រក្សាទុក (Save Changes)</button>
                    <button type="button" class="btn-sys btn-dark" style="padding: 8px 16px; font-size: 14px; font-weight: 700; border-radius: 6px;" onclick="closeGroupMembersModal()">❌ បិទផ្ទាំង (Close)</button>
                </div>
            </div>
        </div>
    </div>


    <!-- Official Receipt Printable Modal Popup -->
