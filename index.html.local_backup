            </div>

        </div>
    </div>

    <!-- Save Destination Category Selection Modal -->
    <div id="saveCategoryConfirmModal" class="modal-overlay" style="display:none; align-items:center; justify-content:center; z-index:99999;">
        <div class="modal-card" style="max-width:460px; width:92%; background:#ffffff; color:#0f172a; border-radius:14px; box-shadow:0 25px 50px -12px rgba(0,0,0,0.4); padding:26px; text-align:center;">
            <div style="font-size:38px; margin-bottom:8px;">💾</div>
            <div style="font-size:18px; font-weight:800; color:#0f172a; margin-bottom:6px;">ជ្រើសរើសផ្នែកសម្រាប់រក្សាទុក</div>
            <div style="font-size:13px; color:#64748b; margin-bottom:20px; line-height:1.4;">តើលោកអ្នកចង់រក្សាទុកវិក្កយបត្រនេះទៅក្នុងផ្នែកសេវាកម្មមួយណា?</div>
            
            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:12px; margin-bottom:18px;">
                <button type="button" id="btnSaveToCar" onclick="confirmSaveWithCategory('car')" style="background:linear-gradient(135deg, #10b981, #059669); color:#ffffff; border:none; padding:18px 12px; border-radius:10px; font-weight:800; font-size:14px; cursor:pointer; display:flex; flex-direction:column; align-items:center; gap:6px; box-shadow:0 4px 12px rgba(16,185,129,0.3); transition:all 0.15s ease;">
                    <span style="font-size:26px;">🚗</span>
                    <span style="font-size:14px;">ផ្នែកឡាន (Car)</span>
                    <span style="font-size:11px; opacity:0.9; font-weight:500;">សេវាកម្មឡាន & ឡាយ</span>
                </button>
                <button type="button" id="btnSaveToVisa" onclick="confirmSaveWithCategory('visa')" style="background:linear-gradient(135deg, #6366f1, #4f46e5); color:#ffffff; border:none; padding:18px 12px; border-radius:10px; font-weight:800; font-size:14px; cursor:pointer; display:flex; flex-direction:column; align-items:center; gap:6px; box-shadow:0 4px 12px rgba(99,102,241,0.3); transition:all 0.15s ease;">
                    <span style="font-size:26px;">🛂</span>
                    <span style="font-size:14px;">ផ្នែកវីសា (Visa)</span>
                    <span style="font-size:11px; opacity:0.9; font-weight:500;">សេវាកម្មវីសា & VIP</span>
                </button>
            </div>
            
            <button type="button" onclick="closeSaveCategoryModal()" style="background:#f1f5f9; color:#475569; border:1px solid #cbd5e1; padding:8px 22px; border-radius:8px; font-weight:700; font-size:13px; cursor:pointer;">❌ បោះបង់ (Cancel)</button>
        </div>
    </div>

    <!-- Web App JavaScript Engine -->
    

<script>

        let allDatabaseRecords = [];
        let currentModalReceiptData = null;
        let currentServiceCategory = 'all'; // 'car', 'visa', 'passport', 'all'
        let currentTableFilterCategory = 'all'; // 'car', 'visa', 'passport', 'all'

        function toggleScannerCollapse() {
            const body = document.getElementById('scannerContentBody');
            const btn = document.getElementById('btnToggleScanner');
            if (!body) return;
            if (body.style.display === 'none') {
                body.style.display = 'block';
                if (btn) btn.textContent = '🔼 បង្រួម';
            } else {
                body.style.display = 'none';
                if (btn) btn.textContent = '🔽 បង្ហាញ';
            }
        }

        window.showCategorySelectionModal = function showCategorySelectionModal() {
            window.currentServiceCategory = "portal";

            sessionStorage.removeItem('imvoi_selected_service');
            const portal = document.getElementById('categorySelectionScreen');
            const ws = document.getElementById('mainWorkspaceContainer');
            if (portal) portal.style.display = 'flex';
            if (ws) ws.style.display = 'none';
        }

        function selectServiceCategory(cat) {
            try {
                currentServiceCategory = cat || 'car';
                currentTableFilterCategory = cat || 'car';
                try { sessionStorage.setItem('imvoi_selected_service', currentServiceCategory); } catch(e){}

                document.body.classList.remove('mode-car', 'mode-visa', 'mode-passport', 'mode-all', 'mode-quote');
                document.body.classList.add('mode-' + currentServiceCategory);

                const portal = document.getElementById('categorySelectionScreen');
                const ws = document.getElementById('mainWorkspaceContainer');
                const topNav = document.getElementById('topCategoryNavBar');
                const grid = document.getElementById('workspaceGrid');
                const quoteStudio = document.getElementById('quoteStudioContainer');
                const bottomDb = document.getElementById('bottomDbPanel');
                const mainActiveTab = document.getElementById('mainActiveCategoryTabBtn');

                if (portal) portal.style.display = 'none';
                if (ws) ws.style.display = 'flex';
                if (topNav) topNav.style.display = (currentServiceCategory === 'quote' ? 'none' : 'flex');

                // Update Active Tab Button color and text matching screenshots
                if (mainActiveTab) {
                    if (currentServiceCategory === 'car') {
                        mainActiveTab.innerHTML = '🚗 សេវាឡាន (Car)';
                        mainActiveTab.style.background = 'linear-gradient(135deg, #059669, #10b981)';
                        mainActiveTab.style.boxShadow = '0 2px 8px rgba(5, 150, 105, 0.35)';
                    } else if (currentServiceCategory === 'visa') {
                        mainActiveTab.innerHTML = '🛂 សេវាវីសា (Visa)';
                        mainActiveTab.style.background = 'linear-gradient(135deg, #4f46e5, #6366f1)';
                        mainActiveTab.style.boxShadow = '0 2px 8px rgba(79, 70, 229, 0.35)';
                    } else if (currentServiceCategory === 'passport') {
                        mainActiveTab.innerHTML = '🛅 គ្រប់គ្រងប៉ាស្ព័រ & ផ្សេងៗ (Passport)';
                        mainActiveTab.style.background = 'linear-gradient(135deg, #0284c7, #0ea5e9)';
                        mainActiveTab.style.boxShadow = '0 2px 8px rgba(2, 132, 199, 0.35)';
                    } else {
                        mainActiveTab.innerHTML = '📑 ទាំងអស់ (All)';
                        mainActiveTab.style.background = 'linear-gradient(135deg, #334155, #475569)';
                        mainActiveTab.style.boxShadow = 'none';
                    }
                }

                if (currentServiceCategory === 'quote') {
                    if (grid) grid.style.display = 'none';
                    if (quoteStudio) quoteStudio.style.display = 'flex';
                    if (bottomDb) bottomDb.style.display = 'none';
                    if (typeof window.selectQuoteCategoryTab === 'function') {
                        window.selectQuoteCategoryTab(window.currentQuoteCategory || 'car', false);
                    }
                    if (typeof window.syncAllQuotePrices === 'function') {
                        window.syncAllQuotePrices();
                    }
                } else if (currentServiceCategory === 'visa' || currentServiceCategory === 'passport') {
                    if (grid) grid.style.display = 'none';
                    if (quoteStudio) quoteStudio.style.display = 'none';
                    if (bottomDb) bottomDb.style.display = 'flex';
                } else {
                    // Car or All
                    if (grid) grid.style.display = 'grid';
                    if (quoteStudio) quoteStudio.style.display = 'none';
                    if (bottomDb) bottomDb.style.display = 'flex';
                }

                // Update date labels
                const lblDate = document.getElementById('lblTravelDate');
                if (lblDate) lblDate.textContent = (currentServiceCategory === 'visa' ? 'ថ្ងៃដាក់ទិដ្ឋាការ:' : (currentServiceCategory === 'passport' ? 'ថ្ងៃផុតកំណត់:' : 'ថ្ងៃធ្វើដំណើរ:'));
                const thDate = document.getElementById('thTravelDate');
                if (thDate) thDate.textContent = (currentServiceCategory === 'visa' ? 'ថ្ងៃដាក់ទិដ្ឋាការ' : (currentServiceCategory === 'passport' ? 'ថ្ងៃផុតកំណត់' : 'ថ្ងៃធ្វើដំណើរ'));
                const gmmLblDate = document.getElementById('gmmLblTravelDate');
                if (gmmLblDate) gmmLblDate.textContent = (currentServiceCategory === 'visa' ? '📅 ថ្ងៃដាក់ទិដ្ឋាការ:' : (currentServiceCategory === 'passport' ? '📅 ថ្ងៃផុតកំណត់:' : '📅 ថ្ងៃធ្វើដំណើរ:'));

                try { updateFormCategoryTheme(); } catch(e){}
                try { if (typeof fetchNextReceiptNo === 'function') fetchNextReceiptNo(currentServiceCategory === 'visa' ? 'visa' : (currentServiceCategory === 'passport' ? 'passport' : 'car')); } catch(e){}
                try { if (typeof renderDatabaseTable === 'function') renderDatabaseTable(); } catch(e){}
                try { if (typeof loadDatabaseRecords === 'function') loadDatabaseRecords(); } catch(e){}
            } catch(err) {
                console.error("selectServiceCategory error:", err);
            }
        }
        
        function updateFormCategoryTheme() {
            const carFeeInput = document.getElementById('feeCar');
            const visaFeeInput = document.getElementById('feeVisa');
            const evisaFeeInput = document.getElementById('feeEvisa');
            const vipFeeInput = document.getElementById('feeVip');

            // Reset styles
            [carFeeInput, visaFeeInput, evisaFeeInput, vipFeeInput].forEach(inp => {
                if (inp) {
                    inp.style.border = '';
                    inp.style.background = '';
                    inp.style.boxShadow = '';
                }
            });

            if (currentServiceCategory === 'car') {
                if (carFeeInput) {
                    carFeeInput.style.border = '2px solid #10b981';
                    carFeeInput.style.background = '#ecfdf5';
                    carFeeInput.style.boxShadow = '0 0 6px rgba(16, 185, 129, 0.3)';
                }
            } else if (currentServiceCategory === 'visa') {
                if (visaFeeInput) {
                    visaFeeInput.style.border = '2px solid #6366f1';
                    visaFeeInput.style.background = '#eef2ff';
                    visaFeeInput.style.boxShadow = '0 0 6px rgba(99, 102, 241, 0.3)';
                }
                if (vipFeeInput) {
                    vipFeeInput.style.border = '2px solid #6366f1';
                    vipFeeInput.style.background = '#eef2ff';
                    vipFeeInput.style.boxShadow = '0 0 6px rgba(99, 102, 241, 0.3)';
                }
            } else if (currentServiceCategory === 'passport') {
                if (vipFeeInput) {
                    vipFeeInput.style.border = '2px solid #0284c7';
                    vipFeeInput.style.background = '#f0f9ff';
                    vipFeeInput.style.boxShadow = '0 0 6px rgba(2, 132, 199, 0.3)';
                }
            }
        }

        function getFeeNum(val) {
            if (val === null || val === undefined) return 0;
            if (typeof val === 'number') return isNaN(val) ? 0 : val;
            const cleaned = String(val).replace(/[^0-9\.-]/g, '');
            const parsed = parseFloat(cleaned);
            return isNaN(parsed) ? 0 : parsed;
        }

        function isCarRecord(item) {
            if (!item) return false;
            const cat = String(item.service_category || item.group_info?.service_category || item.service_type || item.group_info?.service_type || '').toLowerCase().trim();
            if (cat === 'car' || cat === 'line') return true;
            if (cat === 'visa' || cat === 'passport' || cat === 'other' || cat === 'pass') return false;

            // Telegram bot data is ALWAYS strictly Car Service
            if (item.chat_id || item.sender === 'Telegram Booking' || String(item.sender_name || '').toLowerCase().includes('telegram') || String(item.sender || '').toLowerCase().includes('telegram')) return true;

            const rNo = String(item.receipt_no || item.group_info?.receipt_no || item.group_data?.receipt_no || '').toUpperCase();
            if (rNo.startsWith('VISA') || rNo.startsWith('PASS')) return false;

            const sender = String(item.sender || item.sender_name || item.group_info?.sender_name || item.group_name || '').toLowerCase();
            if (sender.includes('visa') || sender.includes('វីសា') || sender.includes('passport') || sender.includes('ប៉ាសស្ព័រ') || sender.includes('ផ្សេងៗ')) return false;

            const members = item.members || item.group_data?.items || [];
            if (Array.isArray(members) && members.some(m => (parseFloat(m.visa_fee || m.visa || 0) > 0 || parseFloat(m.work_permit || 0) > 0 || m.extension_months))) {
                return false;
            }

            return true;
        }

        function isVisaRecord(item) {
            if (!item) return false;
            const cat = String(item.service_category || item.group_info?.service_category || item.service_type || item.group_info?.service_type || '').toLowerCase().trim();
            if (cat === 'visa') return true;
            if (cat === 'car' || cat === 'line' || cat === 'passport' || cat === 'other' || cat === 'pass') return false;

            // Telegram Bot scans belong exclusively to Car section, NEVER Visa
            if (item.chat_id || item.sender === 'Telegram Booking' || String(item.sender_name || '').toLowerCase().includes('telegram') || String(item.sender || '').toLowerCase().includes('telegram')) return false;

            const rNo = String(item.receipt_no || item.group_info?.receipt_no || item.group_data?.receipt_no || '').toUpperCase();
            if (rNo.startsWith('VISA')) return true;
            if (rNo.startsWith('PASS')) return false;

            const sender = String(item.sender || item.sender_name || item.group_info?.sender_name || item.group_name || '').toLowerCase();
            if (sender.includes('visa') || sender.includes('វីសា')) return true;
            if (sender.includes('passport') || sender.includes('ប៉ាសស្ព័រ') || sender.includes('ផ្សេងៗ')) return false;

            const members = item.members || item.group_data?.items || [];
            if (Array.isArray(members) && members.some(m => (parseFloat(m.visa_fee || m.visa || 0) > 0 || parseFloat(m.work_permit || 0) > 0 || m.extension_months))) {
                return true;
            }

            return false;
        }

        function isPassportRecord(item) {
            if (!item) return false;
            const cat = String(item.service_category || item.group_info?.service_category || item.service_type || item.group_info?.service_type || '').toLowerCase().trim();
            if (cat === 'passport' || cat === 'other' || cat === 'pass') return true;
            if (cat === 'car' || cat === 'line' || cat === 'visa') return false;

            const rNo = String(item.receipt_no || item.group_info?.receipt_no || item.group_data?.receipt_no || '').toUpperCase();
            if (rNo.startsWith('PASS')) return true;

            const sender = String(item.sender || item.sender_name || item.group_info?.sender_name || item.group_name || '').toLowerCase();
            if (sender.includes('passport') || sender.includes('ប៉ាសស្ព័រ') || sender.includes('ផ្សេងៗ')) return true;

            return false;
        }

        
        function doUpdatePaxCount(val) {
            const el = document.getElementById('paxCountLabel');
            if (el) el.textContent = val;
        }

        document.addEventListener('DOMContentLoaded', () => {
            const now = new Date();
            const yyyy = now.getFullYear();
            const mm = String(now.getMonth() + 1).padStart(2, '0');
            const dd = String(now.getDate()).padStart(2, '0');
            document.getElementById('travelDate').value = `${yyyy}-${mm}-${dd}`;

            fetchNextReceiptNo();
            setPaxRows();
            loadDatabaseRecords();
            setupDropZone();

            // Always show the welcome category selection screen on initial load
            showCategorySelectionModal();

            const dbSearchHeader = document.getElementById('dbSearchHeader');
            const dbTableContainer = document.getElementById('dbTableContainer');
            if (dbSearchHeader && dbTableContainer) {
                dbSearchHeader.addEventListener('wheel', function(e) {
                    e.preventDefault();
                    dbTableContainer.scrollTop += e.deltaY;
                }, { passive: false });
            }
        });

        function fetchNextReceiptNo(category) {
            const cat = category || (currentServiceCategory === 'visa' ? 'visa' : 'car');
            fetch('/api/next_no?category=' + cat)
                .then(r => r.json())
                .then(d => {
                    if (d.next_no && document.getElementById('receiptNo')) {
                        document.getElementById('receiptNo').value = d.next_no;
                    }
                });
        }

        function setPaxRows() {
            const count = parseInt(document.getElementById('paxInput').value || 3);
            const tbody = document.getElementById('groupMembersBody');
            tbody.innerHTML = '';

            for (let i = 1; i <= count; i++) {
                addMemberRow(i);
            }

            doUpdatePaxCount(count);
            calcTotals();
        }

        function handleTableKeydown(event, input) {
            const key = event.key;
            if (!['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'Enter'].includes(key)) return;

            const tr = input.closest('tr');
            if (!tr) return;
            const tbody = tr.parentElement;
            if (!tbody) return;

            const inputsInRow = Array.from(tr.querySelectorAll('input:not([readonly])'));
            const colIndex = inputsInRow.indexOf(input);
            if (colIndex === -1) return;

            if (key === 'ArrowDown' || key === 'Enter') {
                event.preventDefault();
                let nextTr = tr.nextElementSibling;
                if (!nextTr && key === 'Enter') {
                    if (typeof addMemberRow === 'function') addMemberRow();
                    else if (typeof addNewGmmMemberRow === 'function') addNewGmmMemberRow();
                    nextTr = tbody.lastElementChild;
                    const paxInput = document.getElementById('paxInput');
                    if (paxInput && tbody) {
                        paxInput.value = tbody.children.length;
                    }
                    const countLbl = document.getElementById('paxCountLabel');
                    if (countLbl && tbody) {
                        countLbl.textContent = tbody.children.length;
                    }
                }
                if (nextTr) {
                    const inputsNext = Array.from(nextTr.querySelectorAll('input:not([readonly])'));
                    const target = inputsNext[colIndex] || inputsNext[0];
                    if (target) {
                        target.focus();
                        setTimeout(() => target.select(), 10);
                    }
                }
            } else if (key === 'ArrowUp') {
                event.preventDefault();
                const prevTr = tr.previousElementSibling;
                if (prevTr) {
                    const inputsPrev = Array.from(prevTr.querySelectorAll('input:not([readonly])'));
                    const target = inputsPrev[colIndex] || inputsPrev[0];
                    if (target) {
                        target.focus();
                        setTimeout(() => target.select(), 10);
                    }
                }
            } else if (key === 'ArrowRight') {
                const isText = input.type === 'text';
                const selectionEmpty = input.selectionStart === input.selectionEnd;
                const atEnd = !isText || !selectionEmpty || input.selectionEnd === input.value.length;
                if (atEnd && colIndex < inputsInRow.length - 1) {
                    event.preventDefault();
                    const target = inputsInRow[colIndex + 1];
                    target.focus();
                    setTimeout(() => target.select(), 10);
                } else if (atEnd && colIndex === inputsInRow.length - 1 && tr.nextElementSibling) {
                    event.preventDefault();
                    const inputsNext = Array.from(tr.nextElementSibling.querySelectorAll('input:not([readonly])'));
                    if (inputsNext[0]) {
                        inputsNext[0].focus();
                        setTimeout(() => inputsNext[0].select(), 10);
                    }
                }
            } else if (key === 'ArrowLeft') {
                const isText = input.type === 'text';
                const selectionEmpty = input.selectionStart === input.selectionEnd;
                const atStart = !isText || !selectionEmpty || input.selectionStart === 0;
                if (atStart && colIndex > 0) {
                    event.preventDefault();
                    const target = inputsInRow[colIndex - 1];
                    target.focus();
                    setTimeout(() => target.select(), 10);
                } else if (atStart && colIndex === 0 && tr.previousElementSibling) {
                    event.preventDefault();
                    const inputsPrev = Array.from(tr.previousElementSibling.querySelectorAll('input:not([readonly])'));
                    const lastTarget = inputsPrev[inputsPrev.length - 1];
                    if (lastTarget) {
                        lastTarget.focus();
                        setTimeout(() => lastTarget.select(), 10);
                    }
                }
            }
        }

        function handleNameKeydown(event, input) {
            handleTableKeydown(event, input);
        }

        function addMemberRow(rowNum, name = '', pass = '') {
            const tbody = document.getElementById('groupMembersBody');
            if (!tbody) return;
            const num = rowNum || (tbody.children.length + 1);
            let cleanName = (name || '')
                .replace(/^\d+[\.\)]\s*/, '')
                .replace(/\s*\(\+\d+\s*នាក់\)/gi, '')
                .replace(/\s*\(\+\d+\s*Pax\)/gi, '')
                .replace(/\s+/g, ' ')
                .trim();

            const visa = parseFloat(document.getElementById('feeVisa')?.value || 0);
            const evisa = parseFloat(document.getElementById('feeEvisa')?.value || 0);
            const vip = parseFloat(document.getElementById('feeVip')?.value || 0);
            const car = parseFloat(document.getElementById('feeCar')?.value || 0);
            const clearance = parseFloat(document.getElementById('feeClearance')?.value || 0);
            const work = parseFloat(document.getElementById('feeWork')?.value || 0);
            const fine = parseFloat(document.getElementById('feeFine')?.value || 0);
            const fmtVal = v => (v > 0 ? (v % 1 === 0 ? v : v.toFixed(2)) : '');
            const rowSum = (isNaN(visa)?0:visa) + (isNaN(evisa)?0:evisa) + (isNaN(vip)?0:vip) + (isNaN(car)?0:car) + (isNaN(clearance)?0:clearance) + (isNaN(work)?0:work) + (isNaN(fine)?0:fine);

            const placeholderText = (num === 1) 
                ? "ឈ្មោះតាម Passport (ឧ. SOMCHAI SUWANNAKOT)..." 
                : `ឈ្មោះតាម Passport ${num}...`;

            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td class="text-center font-bold" style="text-align:center; padding: 2px 4px; font-size: 11.5px;">${num}</td>
                <td style="padding: 2px 4px;"><input type="text" class="form-input input-m-name" value="${cleanName}" placeholder="${placeholderText}" oninput="calcTotals()" onfocus="this.select()" onkeydown="handleTableKeydown(event, this)" style="height: 25px; font-size: 11.5px; padding: 1px 6px;"></td>
                <td class="fee-col-vip" style="padding: 2px 4px;"><input type="number" step="0.01" class="form-input input-m-vip num-input" value="${fmtVal(vip)}" placeholder="" oninput="calcMemberTotal(this)" onfocus="this.select()" onkeydown="handleTableKeydown(event, this)" style="height: 25px; font-size: 11.5px; padding: 1px 4px; text-align: center;"></td>
                <td class="fee-col-car" style="padding: 2px 4px;"><input type="number" step="0.01" class="form-input input-m-car num-input" value="${fmtVal(car)}" placeholder="" oninput="calcMemberTotal(this)" onfocus="this.select()" onkeydown="handleTableKeydown(event, this)" style="height: 25px; font-size: 11.5px; padding: 1px 4px; text-align: center;"></td>
                <td class="fee-col-clearance" style="padding: 2px 4px;"><input type="number" step="0.01" class="form-input input-m-clearance num-input" value="${fmtVal(clearance)}" placeholder="" oninput="calcMemberTotal(this)" onfocus="this.select()" onkeydown="handleTableKeydown(event, this)" style="height: 25px; font-size: 11.5px; padding: 1px 4px; text-align: center;"></td>
                <td class="fee-col-evisa" style="padding: 2px 4px;"><input type="number" step="0.01" class="form-input input-m-evisa num-input" value="${fmtVal(evisa)}" placeholder="" oninput="calcMemberTotal(this)" onfocus="this.select()" onkeydown="handleTableKeydown(event, this)" style="height: 25px; font-size: 11.5px; padding: 1px 4px; text-align: center;"></td>
                <td class="fee-col-visa" style="padding: 2px 4px;"><input type="number" step="0.01" class="form-input input-m-visa num-input" value="${fmtVal(visa)}" placeholder="" oninput="calcMemberTotal(this)" onfocus="this.select()" onkeydown="handleTableKeydown(event, this)" style="height: 25px; font-size: 11.5px; padding: 1px 4px; text-align: center;"></td>
                <td class="fee-col-work" style="padding: 2px 4px;"><input type="number" step="0.01" class="form-input input-m-work num-input" value="${fmtVal(work)}" placeholder="" oninput="calcMemberTotal(this)" onfocus="this.select()" onkeydown="handleTableKeydown(event, this)" style="height: 25px; font-size: 11.5px; padding: 1px 4px; text-align: center;"></td>
                <td class="fee-col-fine" style="padding: 2px 4px;"><input type="number" step="0.01" class="form-input input-m-fine num-input" value="${fmtVal(fine)}" placeholder="" oninput="calcMemberTotal(this)" onfocus="this.select()" onkeydown="handleTableKeydown(event, this)" style="height: 25px; font-size: 11.5px; padding: 1px 4px; text-align: center;"></td>
                <td style="padding: 2px 4px;"><input type="number" step="0.01" class="form-input input-m-total num-input" value="${fmtVal(rowSum)}" readonly style="height: 25px; font-size: 11.5px; padding: 1px 4px; text-align: center; font-weight: 800; color: #0284c7; background: #f0f9ff;"></td>
            `;
            tbody.appendChild(tr);
            const countLbl = document.getElementById('paxCountLabel');
            if (countLbl) countLbl.textContent = tbody.children.length;
        }



        function removeLastPaxRow() {
            const tbody = document.getElementById('groupMembersBody');
            if (tbody.children.length <= 1) return;
            tbody.lastElementChild.remove();
            document.getElementById('paxInput').value = tbody.children.length;
            doUpdatePaxCount(tbody.children.length);
            calcTotals();
        }

        function updateMemberFeesDefaults(targetField) {
            const visa = parseFloat(document.getElementById('feeVisa')?.value || 0);
            const evisa = parseFloat(document.getElementById('feeEvisa')?.value || 0);
            const vip = parseFloat(document.getElementById('feeVip')?.value || 0);
            const car = parseFloat(document.getElementById('feeCar')?.value || 0);
            const clearance = parseFloat(document.getElementById('feeClearance')?.value || 0);
            const work = parseFloat(document.getElementById('feeWork')?.value || 0);
            const fine = parseFloat(document.getElementById('feeFine')?.value || 0);
            const fmtVal = v => (v > 0 ? (v % 1 === 0 ? v : v.toFixed(2)) : '');

            document.querySelectorAll('#groupMembersBody tr').forEach(r => {
                if (!targetField || targetField === 'visa') {
                    if (r.querySelector('.input-m-visa')) r.querySelector('.input-m-visa').value = fmtVal(visa);
                }
                if (!targetField || targetField === 'evisa') {
                    if (r.querySelector('.input-m-evisa')) r.querySelector('.input-m-evisa').value = fmtVal(evisa);
                }
                if (!targetField || targetField === 'vip') {
                    if (r.querySelector('.input-m-vip')) r.querySelector('.input-m-vip').value = fmtVal(vip);
                }
                if (!targetField || targetField === 'car') {
                    if (r.querySelector('.input-m-car')) r.querySelector('.input-m-car').value = fmtVal(car);
                }
                if (!targetField || targetField === 'clearance') {
                    if (r.querySelector('.input-m-clearance')) r.querySelector('.input-m-clearance').value = fmtVal(clearance);
                }
                if (!targetField || targetField === 'work') {
                    if (r.querySelector('.input-m-work')) r.querySelector('.input-m-work').value = fmtVal(work);
                }
                if (!targetField || targetField === 'fine') {
                    if (r.querySelector('.input-m-fine')) r.querySelector('.input-m-fine').value = fmtVal(fine);
                }
                calcMemberTotal(r.querySelector('.input-m-vip') || r.querySelector('.input-m-name'));
            });
        }

        function adjustPaxRows() {
            const targetCount = parseInt(document.getElementById('paxInput').value || 1);
            const tbody = document.getElementById('groupMembersBody');
            if (!tbody || targetCount < 1) return;
            const currentCount = tbody.children.length;

            if (targetCount > currentCount) {
                for (let i = currentCount + 1; i <= targetCount; i++) {
                    addMemberRow(i);
                }
            } else if (targetCount < currentCount) {
                for (let i = currentCount; i > targetCount; i--) {
                    if (tbody.lastElementChild) tbody.lastElementChild.remove();
                }
            }
            doUpdatePaxCount(tbody.children.length);
            calcTotals();
        }

        function calcMemberTotal(el) {
            const row = el.closest('tr');
            const getV = sel => parseFloat(row.querySelector(sel)?.value || 0);
            const total = getV('.input-m-visa') + getV('.input-m-evisa') + getV('.input-m-vip') + getV('.input-m-car') + getV('.input-m-clearance') + getV('.input-m-work') + getV('.input-m-fine');
            const fmtVal = v => (v > 0 ? (v % 1 === 0 ? v : v.toFixed(2)) : '');
            row.querySelector('.input-m-total').value = fmtVal(total);
            calcTotals();
        }

        function calcTotals() {
            // Handled automatically
        }

        function syncNameHeader(val) {
            const el = document.getElementById('custNamePassportHeader');
            if (el && el.value !== val) el.value = val;
        }

        function syncNameControlBar(val) {
            const el = document.getElementById('custNamePassport');
            if (el && el.value !== val) el.value = val;
        }

        function setCustNamePassportValue(val) {
            const el1 = document.getElementById('custNamePassport');
            const el2 = document.getElementById('custNamePassportHeader');
            if (el1) el1.value = val;
            if (el2) el2.value = val;
        }

        function formatGroupCustomerNames(members) {
            if (!members) return '';
            let nameList = [];
            if (Array.isArray(members)) {
                nameList = members.map(m => {
                    let n = (typeof m === 'string') ? m : (m.full_english_name || m.english_name || m.name || m.passport_name || '');
                    if (!n) return '';
                    return n.replace(/^\d+[\.\)]\s*/, '').replace(/\s*\(\+\d+\s*នាក់\)/gi, '').replace(/\s*\(\+\d+\s*Pax\)/gi, '').trim();
                }).filter(n => n.length > 0);
            } else if (typeof members === 'string') {
                nameList = members.split(/(?:\r?\n|;|,|\b\d+\.\s*)/)
                    .map(n => n.replace(/^\d+[\.\)]\s*/, '').replace(/\s*\(\+\d+\s*នាក់\)/gi, '').replace(/\s*\(\+\d+\s*Pax\)/gi, '').trim())
                    .filter(n => n.length > 0);
            }

            if (nameList.length === 0) return '';
            if (nameList.length === 1) return nameList[0];

            return nameList.map((name, idx) => `${idx + 1}. ${name}`).join(', ');
        }

        function populateCustomerSuggestions() {
            const list = document.getElementById('customerNameSuggestions');
            if (!list || typeof allDatabaseRecords === 'undefined' || !Array.isArray(allDatabaseRecords)) return;
            
            const uniqueOptions = new Set();
            allDatabaseRecords.forEach(item => {
                const rNo = item.group_data?.receipt_no || item.customer?.receipt_no;
                const sender = item.group_info?.group_name || item.group_info?.sender_name || item.customer?.full_english_name;
                const cust = item.group_info?.customer_name || item.customer?.full_english_name;
                if (rNo) uniqueOptions.add(rNo);
                if (sender && sender !== 'N/A') uniqueOptions.add(sender);
                if (cust && cust !== '-' && cust !== sender) uniqueOptions.add(cust);
                
                (item.members || []).forEach(m => {
                    const mName = m.full_english_name || m.english_name || m.passport_name || m.name;
                    if (mName && mName !== 'Passport Name') uniqueOptions.add(mName);
                });
            });

            list.innerHTML = Array.from(uniqueOptions).map(opt => `<option value="${opt.replace(/"/g, '&quot;')}">`).join('');
        }

        function addPassportMember() {
            const el = document.getElementById('custNamePassport');
            const rawVal = el ? el.value.trim() : '';
            if (!rawVal) {
                if (el) el.focus();
                return;
            }

            const query = rawVal.toLowerCase();
            const tbody = document.getElementById('groupMembersBody');
            let foundExistingRow = false;

            // 1. Check if name already exists in the Yellow Pax table rows
            if (tbody) {
                const rows = tbody.querySelectorAll('tr');
                for (let r of rows) {
                    const nameInp = r.querySelector('.input-m-name');
                    if (nameInp) {
                        const val = nameInp.value.trim().toLowerCase();
                        if (val && val !== 'passport name' && (val === query || val.includes(query) || query.includes(val))) {
                            r.scrollIntoView({ behavior: 'smooth', block: 'center' });
                            nameInp.focus();
                            nameInp.select();
                            
                            const origBg = nameInp.style.backgroundColor;
                            nameInp.style.transition = 'background-color 0.3s ease, transform 0.2s ease';
                            nameInp.style.backgroundColor = '#fef08a';
                            nameInp.style.transform = 'scale(1.02)';
                            setTimeout(() => {
                                nameInp.style.backgroundColor = origBg || '';
                                nameInp.style.transform = '';
                            }, 1500);

                            foundExistingRow = true;
                            break;
                        }
                    }
                }
            }

            if (foundExistingRow) {
                setCustNamePassportValue('');
                return;
            }

            // 2. Extract individual clean names (handles "1. Name1, 2. Name2" or newlines/commas)
            const names = rawVal.split(/(?:\r?\n|;|,|\b\d+\.\s*)/)
                .map(n => n.replace(/^\d+[\.\)]\s*/, '').replace(/\s*\(\+\d+\s*នាក់\)/gi, '').trim())
                .filter(n => n.length > 0);

            if (names.length === 0) return;

            if (tbody) {
                names.forEach(name => {
                    let emptyRow = null;
                    tbody.querySelectorAll('tr').forEach(r => {
                        const nameInp = r.querySelector('.input-m-name');
                        if (nameInp && (!nameInp.value.trim() || nameInp.value.trim() === 'Passport Name') && !emptyRow) {
                            emptyRow = r;
                        }
                    });

                    if (emptyRow) {
                        const nameInp = emptyRow.querySelector('.input-m-name');
                        nameInp.value = name;
                        calcMemberTotal(nameInp);
                    } else {
                        addMemberRow(tbody.children.length + 1, name);
                    }
                });

                const paxInput = document.getElementById('paxInput');
                if (paxInput) paxInput.value = tbody.children.length;
                const countLbl = document.getElementById('paxCountLabel');
                if (countLbl) countLbl.textContent = tbody.children.length;
            }

            const currentMemberRows = Array.from(tbody.querySelectorAll('.input-m-name')).map(inp => inp.value.trim()).filter(n => n.length > 0);
            if (currentMemberRows.length > 0) {
                setCustNamePassportValue(currentMemberRows[0]);
            } else {
                setCustNamePassportValue('');
            }
            if (el) el.focus();
        }

        function applyQuickFeePreset(vip, clearance, car, evisa) {
            const tbody = document.getElementById('groupMembersBody');
            if (!tbody) return;
            const rows = tbody.querySelectorAll('tr');
            rows.forEach(r => {
                const inpCar = r.querySelector('.input-m-car');
                const inpEvisa = r.querySelector('.input-m-evisa');
                const inpVip = r.querySelector('.input-m-vip');
                const inpClearance = r.querySelector('.input-m-clearance');

                if (inpCar) inpCar.value = car ? car.toFixed(2) : '';
                if (inpEvisa) inpEvisa.value = evisa ? evisa.toFixed(2) : '';
                if (inpVip) inpVip.value = vip ? vip.toFixed(2) : '';
                if (inpClearance) inpClearance.value = clearance ? clearance.toFixed(2) : '';

                const nameInp = r.querySelector('.input-m-name');
                if (nameInp) calcMemberTotal(nameInp);
            });
            calcTotals();
        }

        let currentEditingReceiptNo = null;
        function clearGroupForm() {
            currentEditingReceiptNo = null;
            const senderInp = document.getElementById('senderName');
            if (senderInp) senderInp.value = '';
            const custInp = document.getElementById('custNamePassport');
            if (custInp) custInp.value = '';
            const agencyInp = document.getElementById('agencyCompany');
            if (agencyInp) agencyInp.value = '';
            const rateInp = document.getElementById('exchangeRate');
            if (rateInp) rateInp.value = '33.90';

            ['feeVip', 'feeCar', 'feeClearance', 'feeFine', 'feeVisa', 'feeEvisa', 'feeWork'].forEach(id => {
                const el = document.getElementById(id);
                if (el) el.value = '';
            });

            const paxInp = document.getElementById('paxInput');
            if (paxInp) paxInp.value = 3;
            setPaxRows();
        }

        let pendingSavePayload = null;
        let pendingSaveType = 'form'; // 'form' or 'modal'
        let pendingGmmSavePayload = null;

        function openSaveCategoryModal() {
            const modal = document.getElementById('saveCategoryConfirmModal');
            if (modal) {
                modal.style.display = 'flex';
                modal.classList.add('active');
            }
        }

        function closeSaveCategoryModal() {
            const modal = document.getElementById('saveCategoryConfirmModal');
            if (modal) {
                modal.classList.remove('active');
                modal.style.display = 'none';
            }
        }

        function saveGroupRecord() {
            const sender = document.getElementById('senderName').value.trim();
            if (!sender) {
                alert('⚠️ សូមបញ្ចូលឈ្មោះអ្នកផ្ញើ / អ្នកនាំ (Sender Name) ជាមុនសិន ទើបអាចរក្សាទុកបាន!');
                document.getElementById('senderName').focus();
                return;
            }
            const rawDate = document.getElementById('travelDate').value.trim();
            let travelDate = rawDate;
            if (rawDate && rawDate.includes('-')) {
                const parts = rawDate.split('-');
                if (parts.length === 3 && parts[0].length === 4) {
                    travelDate = `${parts[2]}-${parts[1]}-${parts[0]}`;
                }
            }
            const agency = document.getElementById('agencyCompany').value.trim();
            const rate = parseFloat(document.getElementById('exchangeRate').value || 33.90);

            const members = [];
            document.querySelectorAll('#groupMembersBody tr').forEach(r => {
                const name = r.querySelector('.input-m-name').value.trim();
                if (name) {
                    members.push({
                        name: name,
                        visa_fee: parseFloat(r.querySelector('.input-m-visa')?.value || 0),
                        evisa: parseFloat(r.querySelector('.input-m-evisa')?.value || 0),
                        vip: parseFloat(r.querySelector('.input-m-vip')?.value || 0),
                        car_fee: parseFloat(r.querySelector('.input-m-car')?.value || 0),
                        clearance: parseFloat(r.querySelector('.input-m-clearance')?.value || 0),
                        work_permit: parseFloat(r.querySelector('.input-m-work')?.value || 0),
                        overstay: parseFloat(r.querySelector('.input-m-fine')?.value || 0),
                        fine_fee: parseFloat(r.querySelector('.input-m-fine')?.value || 0)
                    });
                }
            });

            if (members.length === 0) {
                alert('សូមបញ្ចូលឈ្មោះសមាជិកយ៉ាងហោចណាស់ 1 នាក់!');
                return;
            }

            const now = new Date();
            const dateSaved = `${String(now.getDate()).padStart(2,'0')}/${String(now.getMonth()+1).padStart(2,'0')}/${now.getFullYear()} ${String(now.getHours()).padStart(2,'0')}:${String(now.getMinutes()).padStart(2,'0')}`;

            const firstCustomerName = (members[0] ? (members[0].name || members[0].full_english_name || members[0].english_name || '') : sender).replace(/^\d+[\.\)]\s*/, '').replace(/\s*\(\+\d+\s*នាក់\)/gi, '').trim();
            pendingSavePayload = {
                receipt_no: currentEditingReceiptNo || '',
                group_name: sender,
                customer_name: firstCustomerName,
                agency_company: agency,
                travel_date: travelDate,
                exchange_rate: rate,
                payment_status: 'UNPAID',
                date_saved: encodeURIComponent(dateSaved),
                members: members
            };
            pendingSaveType = 'form';

            let autoCategory = currentServiceCategory;
            if (!autoCategory || autoCategory === 'all') {
                if (currentEditingReceiptNo) {
                    const existing = (allDatabaseRecords || []).find(r => r.receipt_no === currentEditingReceiptNo);
                    if (existing && existing.service_category) {
                        autoCategory = existing.service_category;
                    } else if (existing) {
                        autoCategory = isCarRecord(existing) ? 'car' : (isPassportRecord(existing) ? 'passport' : 'visa');
                    }
                }
                if (!autoCategory || autoCategory === 'all') {
                    autoCategory = isCarRecord(pendingSavePayload) ? 'car' : (isPassportRecord(pendingSavePayload) ? 'passport' : 'visa');
                }
            }
            confirmSaveWithCategory(autoCategory || 'passport');
        }

        function confirmSaveWithCategory(chosenCategory) {
            closeSaveCategoryModal();

            if (pendingSaveType === 'modal') {
                executeGroupMembersModalSave(chosenCategory);
                return;
            }

            if (!pendingSavePayload) return;

            pendingSavePayload.service_category = chosenCategory;

            fetch('/api/save_group', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(pendingSavePayload)
            })
            .then(r => r.json())
            .then(res => {
                if (res.success) {
                    const catNameKh = chosenCategory === 'car' ? 'ផ្នែកឡាន (Car)' : (chosenCategory === 'passport' ? 'ផ្នែកប៉ាសស្ព័រ & ផ្សេងៗ (Passport)' : 'ផ្នែកវីសា (Visa)');
                    alert(currentEditingReceiptNo ? `🎉 បានធ្វើបច្ចុប្បន្នភាពទិន្នន័យវិក្កយបត្រ ${currentEditingReceiptNo} ក្នុង${catNameKh} បានជោគជ័យ!` : `🎉 រក្សាទុកទិន្នន័យក្រុមទៅក្នុង${catNameKh} បានជោគជ័យ!`);
                    currentEditingReceiptNo = null;
                    pendingSavePayload = null;
                    fetchNextReceiptNo();
                    clearGroupForm();
                    loadDatabaseRecords();
                } else {
                    alert('បរាជ័យក្នុងការរក្សាទុក៖ ' + (res.error || ''));
                }
            })
            .catch(err => {
                alert('កំហុសក្នុងការតភ្ជាប់៖ ' + err.message);
            });
        }

        /* Database Records Loader & Table Renderer */
        function loadDatabaseRecords(callback) {
            fetch('/api/invoices?t=' + Date.now())
                .then(r => r.json())
                .then(d => {
                    if (d && d.success) {
                        allDatabaseRecords = d.invoices || d.records || [];
                    } else if (Array.isArray(d)) {
                        allDatabaseRecords = d;
                    } else {
                        allDatabaseRecords = [];
                    }
                    renderDatabaseTable();
                    if (typeof callback === 'function') callback();
                })
                .catch(err => {
                    console.log("Database load fallback:", err);
                    renderDatabaseTable();
                    if (typeof callback === 'function') callback();
                });
        }

        function updateCarDashboardSummary() {
            try {
                const allRecs = (typeof allDatabaseRecords !== 'undefined' && Array.isArray(allDatabaseRecords) ? allDatabaseRecords : []);
                const carRecords = allRecs.filter(isCarRecord);

                let totalInvoices = carRecords.length;
                let totalPax = 0;
                let totalUsd = 0;
                let totalThb = 0;
                let totalCarFee = 0;
                let totalClearanceFee = 0;
                let totalVipFee = 0;
                let totalFineFee = 0;
                let paidCount = 0;
                let unpaidCount = 0;

                carRecords.forEach(item => {
                    if (!item) return;
                    const members = item.members || [];
                    totalPax += (Array.isArray(members) && members.length > 0 ? members.length : 1);

                    const usd = parseFloat(item.total_usd || item.grand_total_usd || item.amount || 0);
                    const thb = parseFloat(item.total_thb || item.grand_total_thb || 0);
                    totalUsd += isNaN(usd) ? 0 : usd;
                    totalThb += isNaN(thb) ? 0 : thb;

                    if (Array.isArray(members)) {
                        members.forEach(m => {
                            if (!m) return;
                            totalCarFee += parseFloat(m.car_fee || m.car || 0) || 0;
                            totalClearanceFee += parseFloat(m.clearance_fee || m.clearance || 0) || 0;
                            totalVipFee += parseFloat(m.vip || 0) || 0;
                            totalFineFee += parseFloat(m.overstay || m.fine_fee || 0) || 0;
                        });
                    }

                    const status = String(item.payment_status || item.status || '').toLowerCase();
                    if (status.includes('បង់') || status.includes('paid')) {
                        paidCount++;
                    } else {
                        unpaidCount++;
                    }
                });

                const setTxt = (id, txt) => {
                    const el = document.getElementById(id);
                    if (el) el.textContent = txt;
                };

                setTxt('dashCarInvoices', totalInvoices);
                setTxt('dashCarPax', totalPax);
                setTxt('dashCarTotalUsd', '$' + totalUsd.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
                setTxt('dashCarTotalThb', totalThb.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ฿');
                setTxt('dashCarTotalCarFee', '$' + totalCarFee.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
                setTxt('dashCarTotalClearance', '$' + totalClearanceFee.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
                setTxt('dashCarTotalVip', '$' + totalVipFee.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
                setTxt('dashCarTotalFine', '$' + totalFineFee.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
                setTxt('dashCarPaidCount', paidCount);
                setTxt('dashCarUnpaidCount', unpaidCount);
            } catch (e) {
                console.error("Dashboard summary error:", e);
            }
        }

        function renderDatabaseTable() {
            const tbody = document.getElementById('databaseTableBody');
            if (!tbody) return;

            try {
                updateCarDashboardSummary();
            } catch (e) {
                console.error(e);
            }

            try {
                if (typeof populateCustomerSuggestions === 'function') {
                    populateCustomerSuggestions();
                }
            } catch (e) {
                console.error(e);
            }

            try {
                const searchInput = document.getElementById('searchInput');
                const search = searchInput ? searchInput.value.toLowerCase().trim() : '';

                const allRecs = (typeof allDatabaseRecords !== 'undefined' && Array.isArray(allDatabaseRecords) ? allDatabaseRecords : []);
                
                let filtered = allRecs.filter(item => {
                    if (!item) return false;
                    if (currentServiceCategory === 'car') {
                        if (!isCarRecord(item)) return false;
                    } else if (currentServiceCategory === 'visa') {
                        if (!isVisaRecord(item)) return false;
                    } else if (currentServiceCategory === 'passport') {
                        if (!isPassportRecord(item)) return false;
                    }
                    if (!search) return true;
                    try {
                        return JSON.stringify(item).toLowerCase().includes(search);
                    } catch (e) {
                        return false;
                    }
                });

                const totalLabel = document.getElementById('totalRecordsLabel');
                if (totalLabel) {
                    let catSuffix = '';
                    if (currentServiceCategory === 'car') catSuffix = ' - សេវាឡាន';
                    else if (currentServiceCategory === 'visa') catSuffix = ' - សេវាវីសា';
                    else if (currentServiceCategory === 'passport') catSuffix = ' - ប៉ាសស្ព័រ & ផ្សេងៗ';
                    totalLabel.textContent = `សរុប: ${filtered.length} ត្រា${catSuffix} (Total Records: ${filtered.length})`;
                }

                if (filtered.length === 0) {
                    const emptyMsg = currentServiceCategory === 'car' ? 'មិនមានទិន្នន័យសេវាកម្មឡានឡើយ' : (currentServiceCategory === 'visa' ? 'មិនមានទិន្នន័យសេវាកម្មវីសាឡើយ' : (currentServiceCategory === 'passport' ? 'មិនមានទិន្នន័យសេវាកម្មប៉ាសស្ព័រ & ផ្សេងៗឡើយ' : 'មិនមានទិន្នន័យអតិថិជនឡើយ'));
                    tbody.innerHTML = `<tr><td colspan="8" style="text-align:center; padding:20px; color:var(--text-sub);">${emptyMsg}</td></tr>`;
                    return;
                }

                let html = '';
                filtered.forEach((item, idx) => {
                    const originalIdx = (typeof allDatabaseRecords !== 'undefined' && Array.isArray(allDatabaseRecords)) ? allDatabaseRecords.indexOf(item) : idx;
                    const realIdx = originalIdx !== -1 ? originalIdx : idx;
                    const itemId = item.id || '';
                    const rNo = item.receipt_no || item.group_data?.receipt_no || item.customer?.receipt_no || (item.passport_no ? `🛂 ${item.passport_no}` : 'N/A');
                    const rawTravel = item.travel_date || item.group_info?.travel_date || item.group_data?.travel_date || item.group_data?.date_str || item.customer?.date_saved || item.updated_at || '-';
                    const travelDate = formatDisplayDate(rawTravel);
                    const sender = item.sender || item.group_info?.sender_name || item.group_data?.sender_name || item.group_info?.group_name || item.sender_name || item.customer?.full_english_name || item.customer_name || 'Telegram User';
                    const custName = item.customer_name || item.full_english_name || item.group_info?.customer_name || item.customer?.full_english_name || '-';
                    const members = item.members || [];
                    const paxCount = (Array.isArray(members) && members.length > 0) ? members.length : 1;
                    const isGroup = paxCount > 1;
                    
                    let firstCust = '';
                    if (Array.isArray(members) && members.length > 0) {
                        firstCust = members[0]?.full_english_name || members[0]?.english_name || members[0]?.name || '';
                    }
                    if (!firstCust || firstCust === '-' || firstCust === 'Passport Name') {
                        firstCust = item.group_info?.customer_name || item.customer_name || item.customer?.full_english_name || '';
                    }
                    if (firstCust) {
                        if (firstCust.includes(',')) firstCust = firstCust.split(',')[0];
                        firstCust = firstCust.replace(/^\d+[\.\)]\s*/, '').replace(/\s*\(\+\d+\s*នាក់\)/gi, '').replace(/\s*\(\+\d+\s*Pax\)/gi, '').trim();
                    }
                    if (!firstCust || firstCust === '-' || /^[A-Z]{1,2}\d{6,9}$/i.test(firstCust)) {
                        firstCust = sender || 'Customer';
                    }

                    const custLabel = isGroup ? `${firstCust} (+${paxCount-1} នាក់)` : firstCust;
                    const usdTotal = parseFloat(item.totals?.usd || item.group_data?.totals?.usd || item.totals?.usd || (item.passport_no ? 200.00 : 0)) || 0;
                    const status = (item.payment_status || 'UNPAID').toUpperCase();

                    const icon = isGroup ? '👥' : '👤';
                    const isVisa = isVisaRecord(item);
                    let visaStatusBadge = '';
                    if (isVisa && Array.isArray(members) && members.length > 0) {
                        const issuedCount = members.filter(m => m.visa_issued === true || m.visa_issued === 'true' || m.visa_status === 'issued').length;
                        if (issuedCount === members.length) {
                            visaStatusBadge = `<span style="font-size:11px; padding:2px 6px; border-radius:4px; background:#ecfdf5; color:#047857; border:1px solid #10b981; font-weight:800; white-space:nowrap;">✅ វីសាចេញរួច</span>`;
                        } else if (issuedCount > 0) {
                            visaStatusBadge = `<span style="font-size:11px; padding:2px 6px; border-radius:4px; background:#eff6ff; color:#1d4ed8; border:1px solid #60a5fa; font-weight:800; white-space:nowrap;">🛂 ចេញ ${issuedCount}/${members.length}</span>`;
                        } else {
                            visaStatusBadge = `<span style="font-size:11px; padding:2px 6px; border-radius:4px; background:#fef2f2; color:#dc2626; border:1px solid #f87171; font-weight:800; white-space:nowrap;">⏳ រង់ចាំវីសា</span>`;
                        }
                    }

                    const custContent = `
                        <div style="display:flex; align-items:center; justify-content:space-between; gap:6px; padding:2px 4px;">
                            <div style="display:flex; align-items:center; gap:6px;">
                                <span style="font-weight:800; color:#0f172a;">${icon} ${custLabel}</span>
                                ${visaStatusBadge}
                            </div>
                            <div style="display:flex; gap:4px; align-items:center; flex-shrink:0;">
                                <button type="button" class="btn-sys btn-indigo btn-action-sm" style="font-size:11.5px; padding:4px 8px; font-weight:700; line-height:1.4; white-space:nowrap; background: linear-gradient(135deg, #0284c7, #2563eb); border: 1px solid #38bdf8; color: #ffffff; min-height: 26px;" onclick="event.stopPropagation(); openGroupMembersModal('${encodeURIComponent(rNo)}', ${realIdx})">👁️ មើលលម្អិត (${paxCount})</button>
                                <button type="button" class="btn-sys btn-amber btn-action-sm" style="font-size:11.5px; padding:4px 8px; font-weight:700; line-height:1.4; white-space:nowrap; min-height: 26px;" onclick="event.stopPropagation(); (currentServiceCategory === 'car' ? loadRecordIntoForm('${encodeURIComponent(rNo)}', ${realIdx}) : openGroupMembersModal('${encodeURIComponent(rNo)}', ${realIdx}))">✏️ កែប្រែ</button>
                            </div>
                        </div>
                    `;

                    const isPassport = isPassportRecord(item);
                    const totalDisplay = isPassport 
                        ? `฿${(item.totals?.baht || item.totals?.usd || usdTotal).toLocaleString('en-US')}` 
                        : `$${usdTotal.toFixed(2)}`;

                    html += `
                        <tr style="cursor:pointer; vertical-align:middle;" title="ចុចទីនេះដើម្បីមើលសមាជិកក្រុម" onclick="openGroupMembersModal('${encodeURIComponent(rNo)}', ${realIdx})">
                            <td style="text-align:center; font-weight:800; color:#0f172a; padding:5px 4px;">${idx + 1}</td>
                            <td style="text-align:center; font-weight:800; color:#0284c7; padding:5px 4px;">${rNo}</td>
                            <td style="text-align:center; font-weight:700; color:#0f172a; padding:5px 4px; white-space:nowrap;">${travelDate}</td>
                            <td style="padding:5px 6px;"><strong style="color:#0f172a; font-weight:800;">${sender}</strong></td>
                            <td style="text-align:right; font-weight:800; color:#059669; padding:5px 6px;">${totalDisplay}</td>
                            <td style="text-align:center; padding:5px 4px;" onclick="event.stopPropagation()">
                                <span class="badge-status ${status==='PAID'?'badge-paid-st':'badge-unpaid-st'}" style="font-size:11.5px; padding:4px 8px; min-height:26px;" onclick="toggleStatus('${encodeURIComponent(rNo)}', '${status==='PAID'?'UNPAID':'PAID'}', ${realIdx})">
                                    ${status==='PAID'?'✅ បង់រួច':'❌ មិនទាន់បង់'}
                                </span>
                            </td>
                            <td style="text-align:center; white-space:nowrap; padding:5px 4px;" onclick="event.stopPropagation()">
                                <button type="button" class="btn-sys btn-purple btn-action-sm" style="font-size:11px; padding:4px 8px; min-height:26px;" onclick="openShareAction('${encodeURIComponent(rNo)}', ${realIdx})">✈️ Share</button>
                                <button type="button" class="btn-sys btn-indigo btn-action-sm" style="font-size:11px; padding:4px 8px; min-height:26px; background:#0284c7; color:#fff;" onclick="openReceiptModal('${encodeURIComponent(rNo)}', ${realIdx})">👁️ មើល</button>
                                <button type="button" class="btn-sys btn-rose btn-action-sm" style="font-size:11px; padding:4px 8px; min-height:26px;" onclick="deleteRecord('${encodeURIComponent(rNo)}', '${encodeURIComponent(itemId)}', ${realIdx})">🗑️ លុប</button>
                            </td>
                            <td style="padding:5px 6px;" onclick="event.stopPropagation()">${custContent}</td>
                        </tr>
                    `;
                });

                tbody.innerHTML = html;
            } catch (err) {
                console.error("renderDatabaseTable error:", err);
                tbody.innerHTML = `<tr><td colspan="8" style="text-align:center; padding:20px; color:#ef4444;">កំហុសក្នុងការបង្ហាញទិន្នន័យ៖ ${err.message || err}</td></tr>`;
            }
        }

        async function exportCSV() {
            const records = Array.isArray(allDatabaseRecords) ? allDatabaseRecords : [];
            if (records.length === 0) {
                alert('⚠️ មិនមានទិន្នន័យសម្រាប់ Export ទេ!');
                return;
            }

            // Filter records according to active category if user is viewing specific category
            let exportData = records;
            if (currentServiceCategory === 'car') {
                exportData = records.filter(item => isCarRecord(item));
            } else if (currentServiceCategory === 'visa') {
                exportData = records.filter(item => isVisaRecord(item));
            } else if (currentServiceCategory === 'passport') {
                exportData = records.filter(item => isPassportRecord(item));
            }

            if (exportData.length === 0) {
                exportData = records;
            }

            const escapeCSV = val => {
                if (val === null || val === undefined) return '""';
                let str = String(val).replace(/"/g, '""');
                return `"${str}"`;
            };

            const headers = [
                'No',
                'Receipt No',
                'Category',
                'Date',
                'Sender / Group Name',
                'Agency / Company',
                'Pax Count',
                'Customer / Members List',
                'Total USD ($)',
                'Total Baht (THB)',
                'Payment Status',
                'Date Saved'
            ];

            const rows = [headers.join(',')];

            exportData.forEach((item, idx) => {
                const rNo = item.receipt_no || item.group_info?.receipt_no || item.group_data?.receipt_no || item.customer?.receipt_no || (item.passport_no ? ('PASSPORT: ' + item.passport_no) : `INV ${idx + 1}`);
                const isVisa = isVisaRecord(item);
                const isPass = isPassportRecord(item);
                const category = isVisa ? 'VISA' : (isPass ? 'PASSPORT' : 'CAR');
                const travelDate = formatDisplayDate(item.group_info?.travel_date || item.group_data?.travel_date || item.travel_date || '-');
                const sender = item.group_info?.sender_name || item.group_info?.group_name || item.group_data?.sender_name || item.sender_name || item.sender || '-';
                const agency = item.group_info?.agency_company || item.group_data?.agency_company || item.agency_company || item.customer?.agency_company || '-';
                
                const members = item.members || item.group_data?.items || [];
                const paxCount = members.length > 0 ? members.length : 1;
                
                let memberNames = [];
                if (members.length > 0) {
                    memberNames = members.map((m, i) => `${i + 1}. ${m.full_english_name || m.english_name || m.name || m.description || 'Guest'} ($${(parseFloat(m.usd) || 0).toFixed(0)})`);
                } else {
                    memberNames = [item.customer_name || item.customer?.full_english_name || '-'];
                }
                const membersStr = memberNames.join(' | ');

                const rate = parseFloat(item.group_data?.exchange_rate || item.fees?.exchange_rate || item.exchange_rate || 33.90);
                const usdTotal = parseFloat(item.group_data?.totals?.usd || item.totals?.usd || 0);
                const bahtTotal = parseFloat(item.group_data?.totals?.baht || item.totals?.baht || (usdTotal * rate));
                const status = (item.payment_status || 'UNPAID').toUpperCase() === 'PAID' ? 'PAID (បង់រួច)' : 'UNPAID (មិនទាន់បង់)';
                const dateSaved = decodeURIComponent(item.date_saved || item.updated_at || '');

                const row = [
                    idx + 1,
                    escapeCSV(rNo),
                    escapeCSV(category),
                    escapeCSV(travelDate),
                    escapeCSV(sender),
                    escapeCSV(agency),
                    paxCount,
                    escapeCSV(membersStr),
                    usdTotal.toFixed(2),
                    bahtTotal.toFixed(2),
                    escapeCSV(status),
                    escapeCSV(dateSaved)
                ];
                rows.push(row.join(','));
            });

            // Add UTF-8 BOM for Microsoft Excel compatibility
            const csvContent = '\uFEFF' + rows.join('\r\n');
            const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            
            const today = new Date();
            const dateStr = `${String(today.getDate()).padStart(2,'0')}-${String(today.getMonth()+1).padStart(2,'0')}-${today.getFullYear()}`;
            const fileName = `Imvoi_Export_${currentServiceCategory.toUpperCase()}_${dateStr}.csv`;

            // Prompt Save dialog if supported
            if ('showSaveFilePicker' in window) {
                try {
                    const handle = await window.showSaveFilePicker({
                        suggestedName: fileName,
                        types: [{
                            description: 'CSV File (*.csv)',
                            accept: { 'text/csv': ['.csv'] }
                        }]
                    });
                    const writable = await handle.createWritable();
                    await writable.write(blob);
                    await writable.close();
                    if (typeof showToast === 'function') {
                        showToast('🎉 បាន Export CSV ដោយជោគជ័យ!');
                    }
                    return;
                } catch (err) {
                    if (err.name === 'AbortError') return;
                    console.warn('showSaveFilePicker CSV error:', err);
                }
            }

            // Fallback download link
            const url = URL.createObjectURL(blob);
            const link = document.createElement('a');
            link.setAttribute('href', url);
            link.setAttribute('download', fileName);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            URL.revokeObjectURL(url);
            if (typeof showToast === 'function') {
                showToast('🎉 បាន Export CSV ដោយជោគជ័យ!');
            }
        }

        async function backupDatabaseJSON() {
            const records = Array.isArray(allDatabaseRecords) ? allDatabaseRecords : [];
            if (records.length === 0) {
                alert('⚠️ មិនមានទិន្នន័យសម្រាប់ Backup ទេ!');
                return;
            }

            const jsonStr = JSON.stringify(records, null, 2);
            const blob = new Blob([jsonStr], { type: 'application/json;charset=utf-8;' });
            
            const today = new Date();
            const dateStr = `${String(today.getDate()).padStart(2,'0')}-${String(today.getMonth()+1).padStart(2,'0')}-${today.getFullYear()}`;
            const fileName = `saved_customers_backup_${dateStr}.json`;

            if ('showSaveFilePicker' in window) {
                try {
                    const handle = await window.showSaveFilePicker({
                        suggestedName: fileName,
                        types: [{
                            description: 'JSON Database (*.json)',
                            accept: { 'application/json': ['.json'] }
                        }]
                    });
                    const writable = await handle.createWritable();
                    await writable.write(blob);
                    await writable.close();
                    if (typeof showToast === 'function') {
                        showToast('🎉 បាន Backup Database JSON ដោយជោគជ័យ!');
                    }
                    return;
                } catch (err) {
                    if (err.name === 'AbortError') return;
                }
            }

            const url = URL.createObjectURL(blob);
            const link = document.createElement('a');
            link.setAttribute('href', url);
            link.setAttribute('download', fileName);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            URL.revokeObjectURL(url);
            if (typeof showToast === 'function') {
                showToast('🎉 បាន Backup Database JSON ដោយជោគជ័យ!');
            }
        }

        function handleRestoreJSONFile(event) {
            const file = event.target?.files?.[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(e) {
                try {
                    const data = JSON.parse(e.target.result);
                    let records = [];
                    if (Array.isArray(data)) {
                        records = data;
                    } else if (data && Array.isArray(data.records)) {
                        records = data.records;
                    } else if (data && Array.isArray(data.invoices)) {
                        records = data.invoices;
                    }

                    if (records.length === 0) {
                        alert('⚠️ ឯកសារ JSON នេះមិនមានទិន្នន័យត្រឹមត្រូវឡើយ!');
                        event.target.value = '';
                        return;
                    }

                    if (!confirm(`⚠️ តើអ្នកពិតជាចង់បញ្ចូលទិន្នន័យ (Restore) ចំនួន ${records.length} ត្រា នេះចូលទៅក្នុងប្រព័ន្ធមែនទេ?`)) {
                        event.target.value = '';
                        return;
                    }

                    fetch('/api/restore_database', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ records: records })
                    })
                    .then(r => r.json())
                    .then(res => {
                        event.target.value = '';
                        if (res.success) {
                            alert(`🎉 បានបញ្ចូលទិន្នន័យ (Restore) ដោយជោគជ័យ៖ សរុប ${res.count} ត្រា!`);
                            loadDatabaseRecords();
                        } else {
                            alert('បរាជ័យក្នុងការ Restore៖ ' + (res.error || ''));
                        }
                    })
                    .catch(err => {
                        event.target.value = '';
                        alert('កំហុសក្នុងការតភ្ជាប់៖ ' + err.message);
                    });
                } catch (err) {
                    event.target.value = '';
                    alert('កំហុសក្នុងការអានឯកសារ JSON៖ ' + err.message);
                }
            };
            reader.readAsText(file);
        }

        function formatNumNoZero(val) {
            if (val === undefined || val === null || val === "" || val === 0 || val === "0" || val === "0.00") return "";
            const num = parseFloat(val);
            if (isNaN(num) || num === 0) return "";
            if (num % 1 === 0) return num.toString();
            return parseFloat(num.toFixed(2)).toString();
        }

        function formatCurrencyUSD(val) {
            const num = parseFloat(val || 0);
            if (isNaN(num) || num === 0) return "0";
            if (num % 1 === 0) return num.toString();
            return parseFloat(num.toFixed(2)).toString();
        }

        function formatDisplayDate(dateStr) {
            if (!dateStr || typeof dateStr !== 'string') return '';
            const cleanStr = dateStr.trim().split(' ')[0];
            const parts = cleanStr.split(/[-/.]/);
            if (parts.length === 3) {
                if (parts[0].length === 4) {
                    return `${parts[2].padStart(2, '0')}-${parts[1].padStart(2, '0')}-${parts[0]}`;
                } else if (parts[2].length === 4) {
                    return `${parts[0].padStart(2, '0')}-${parts[1].padStart(2, '0')}-${parts[2]}`;
                }
            }
            return cleanStr;
        }

        function formatIsoDateForInput(dateStr) {
            if (!dateStr || typeof dateStr !== 'string') return '';
            const cleanStr = dateStr.trim().split(' ')[0];
            const parts = cleanStr.split(/[-/.]/);
            if (parts.length === 3) {
                if (parts[0].length === 4) {
                    return `${parts[0]}-${parts[1].padStart(2, '0')}-${parts[2].padStart(2, '0')}`;
                } else if (parts[2].length === 4) {
                    return `${parts[2]}-${parts[1].padStart(2, '0')}-${parts[0].padStart(2, '0')}`;
                }
            }
            return cleanStr;
        }

        let currentGmmReceiptNo = '';

        function getItemByRef(rNoEnc, idx) {
            if (typeof allDatabaseRecords === 'undefined' || !Array.isArray(allDatabaseRecords) || allDatabaseRecords.length === 0) return null;
            const cleanNo = decodeURIComponent(rNoEnc || '').trim();
            
            // 1. Match by cleanNo if valid
            if (cleanNo && cleanNo !== 'N/A' && cleanNo !== '-') {
                const found = allDatabaseRecords.find(i => {
                    const no = (i.receipt_no || i.group_data?.receipt_no || i.customer?.receipt_no || (i.passport_no ? `🛂 ${i.passport_no}` : '') || '').trim();
                    const sender = (i.sender || i.group_info?.sender_name || i.group_name || '').trim();
                    return no === cleanNo || (i.passport_no && (i.passport_no === cleanNo || ('🛂 ' + i.passport_no) === cleanNo)) || (i.id && String(i.id) === cleanNo) || sender === cleanNo;
                });
                if (found) return found;
            }

            // 2. Match by index
            if (idx !== undefined && idx !== null && idx >= 0 && allDatabaseRecords[idx]) {
                return allDatabaseRecords[idx];
            }

            return null;
        }

        function openNewGroupModal() {
            const cat = (currentServiceCategory === 'visa') ? 'visa' : (currentServiceCategory === 'passport' ? 'passport' : 'car');
            fetch('/api/next_no?category=' + cat)
                .then(r => r.json())
                .then(d => {
                    const nextNo = d.next_no || (cat === 'visa' ? 'VISA 00001' : 'INV 00001');
                    currentGmmReceiptNo = nextNo;

                    const titleElem = document.getElementById('gmmTitle');
                    const subTitleElem = document.getElementById('gmmSubTitle');
                    if (titleElem) titleElem.textContent = `📋 បង្កើតទិន្នន័យក្រុមថ្មី (${nextNo})`;
                    if (subTitleElem) subTitleElem.textContent = `👤 បញ្ចូលព័ត៌មានអ្នកនាំ និងសមាជិកក្រុមថ្មី`;

                    // Set default today's date
                    const today = new Date();
                    const yyyy = today.getFullYear();
                    const mm = String(today.getMonth() + 1).padStart(2, '0');
                    const dd = String(today.getDate()).padStart(2, '0');
                    const dateInput = document.getElementById('gmmTravelDate');
                    if (dateInput) dateInput.value = `${yyyy}-${mm}-${dd}`;

                    const rNoInput = document.getElementById('gmmReceiptNo');
                    if (rNoInput) rNoInput.value = nextNo;

                    const rateInput = document.getElementById('gmmExchangeRate');
                    if (rateInput) rateInput.value = '33.90';

                    // Clear sender & agency
                    const senderInp = document.getElementById('gmmSenderName');
                    if (senderInp) senderInp.value = '';
                    const agencyInp = document.getElementById('gmmAgencyCompany');
                    if (agencyInp) agencyInp.value = '';

                    // Clear tbody first
                    const tbody = document.getElementById('gmmMembersBody');
                    if (tbody) tbody.innerHTML = '';

                    // Set mode based on active category with explicit empty list
                    const initialMode = (currentServiceCategory === 'visa') ? 'visa' : (currentServiceCategory === 'passport' ? 'passport' : 'line');
                    currentGmmCachedItem = null;
                    switchGmmMode(initialMode, []);

                    // Clear bulk fee inputs
                    ['gmmFeePassport', 'gmmFeeNamelist', 'gmmFeeVisa', 'gmmFeeMissingDoc', 'gmmFeeStamping', 'gmmFeeVip', 'gmmFeeCar', 'gmmFeeClearance', 'gmmFeeWork', 'gmmFeeFine'].forEach(id => {
                        const el = document.getElementById(id);
                        if (el) el.value = '';
                    });

                    // Set button text to: 💾 រក្សាទុក (Save Changes)
                    const btnSave = document.getElementById('btnGmmSave');
                    if (btnSave) {
                        btnSave.textContent = '💾 រក្សាទុក (Save Changes)';
                    }

                    // Add 2 initial completely blank member rows ready for typing
                    if (tbody) {
                        tbody.innerHTML = '';
                        addNewGmmMemberRow();
                        addNewGmmMemberRow();
                    }

                    calculateGmmTotal();

                    // Open modal
                    const modal = document.getElementById('groupMembersModal');
                    if (modal) {
                        modal.style.display = 'flex';
                        modal.classList.add('active');
                    }

                    // Focus sender name input
                    setTimeout(() => {
                        if (senderInp) senderInp.focus();
                    }, 100);
                })
                .catch(() => {
                    const nextNo = (currentServiceCategory === 'visa' ? 'VISA ' : 'INV ') + String(Date.now()).slice(-5);
                    currentGmmReceiptNo = nextNo;
                    const rNoInput = document.getElementById('gmmReceiptNo');
                    if (rNoInput) rNoInput.value = nextNo;
                    const modal = document.getElementById('groupMembersModal');
                    if (modal) {
                        modal.style.display = 'flex';
                        modal.classList.add('active');
                    }
                });
        }

        let currentGmmMode = 'line'; // 'visa', 'passport', or 'line'
        let currentGmmCachedItem = null;

        function switchGmmMode(newMode, explicitMembers) {
            currentGmmMode = newMode || 'line';
            
            const exRateBox = document.getElementById('gmmExRateContainer');
            const currBadge = document.getElementById('gmmCurrencyBadge');
            if (exRateBox && currBadge) {
                if (currentGmmMode === 'passport') {
                    exRateBox.style.display = 'none';
                    currBadge.style.display = 'inline-flex';
                } else {
                    exRateBox.style.display = 'flex';
                    currBadge.style.display = 'none';
                }
            }
            
            // Update GMM date label based on mode
            const gmmLblDate = document.getElementById('gmmLblTravelDate');
            if (gmmLblDate) gmmLblDate.textContent = (currentGmmMode === 'visa' ? '📅 ថ្ងៃដាក់វីសា:' : (currentGmmMode === 'passport' ? '📅 កាលបរិច្ឆេទ:' : '📅 ថ្ងៃធ្វើដំណើរ:'));
            
            // Update tab styles
            const tabVisa = document.getElementById('gmmTabVisa');
            const tabLine = document.getElementById('gmmTabLine');
            if (tabVisa) {
                if (currentGmmMode === 'visa') {
                    tabVisa.style.background = '#6366f1';
                    tabVisa.style.color = '#ffffff';
                    tabVisa.style.border = '1px solid #4f46e5';
                    tabVisa.style.boxShadow = '0 1px 3px rgba(99,102,241,0.3)';
                } else {
                    tabVisa.style.background = '#f1f5f9';
                    tabVisa.style.color = '#475569';
                    tabVisa.style.border = '1px solid #cbd5e1';
                    tabVisa.style.boxShadow = 'none';
                }
            }
            if (tabLine) {
                if (currentGmmMode === 'line') {
                    tabLine.style.background = '#10b981';
                    tabLine.style.color = '#ffffff';
                    tabLine.style.border = '1px solid #059669';
                    tabLine.style.boxShadow = '0 1px 3px rgba(16,185,129,0.3)';
                } else {
                    tabLine.style.background = '#f1f5f9';
                    tabLine.style.color = '#475569';
                    tabLine.style.border = '1px solid #cbd5e1';
                    tabLine.style.boxShadow = 'none';
                }
            }

            let membersList = [];
            if (explicitMembers && Array.isArray(explicitMembers) && explicitMembers.length > 0) {
                membersList = explicitMembers;
            } else {
                const currentRows = document.querySelectorAll('#gmmMembersBody .gmm-row');
                if (currentRows.length > 0) {
                    currentRows.forEach(r => {
                        const name = r.querySelector('.gmm-input-name')?.value || '';
                        const passport = parseFloat(r.querySelector('.gmm-input-passport')?.value || 0);
                        const namelist = parseFloat(r.querySelector('.gmm-input-namelist')?.value || 0);
                        const missingDoc = parseFloat(r.querySelector('.gmm-input-missing-doc')?.value || 0);
                        const stamping = parseFloat(r.querySelector('.gmm-input-stamping')?.value || 0);
                        const visa = parseFloat(r.querySelector('.gmm-input-visa')?.value || 0);
                        const permit = parseFloat(r.querySelector('.gmm-input-permit')?.value || 0);
                        const vip = parseFloat(r.querySelector('.gmm-input-vip')?.value || 0);
                        const clearance = parseFloat(r.querySelector('.gmm-input-clearance')?.value || 0);
                        const car = parseFloat(r.querySelector('.gmm-input-car')?.value || 0);
                        const fine = parseFloat(r.querySelector('.gmm-input-fine')?.value || 0);
                        const usd = parseFloat(r.querySelector('.gmm-input-usd')?.value || 0);
                        if (name || passport || namelist || missingDoc || stamping || visa || permit || vip || clearance || car || fine || usd) {
                            membersList.push({
                                full_english_name: name,
                                name: name,
                                passport_fee: passport,
                                namelist_fee: namelist,
                                missing_doc_fee: missingDoc,
                                visa_stamping_fee: stamping,
                                visa_fee: visa,
                                work_permit: permit,
                                vip: vip,
                                clearance_fee: clearance,
                                car_fee: car,
                                overstay: fine,
                                fine_fee: fine,
                                usd: usd
                            });
                        }
                    });
                } else if (currentGmmCachedItem && currentGmmCachedItem.members && currentGmmCachedItem.members.length > 0) {
                    membersList = currentGmmCachedItem.members;
                }
            }

            renderGmmBulkFeeBox(currentGmmMode, membersList.length > 0 ? membersList[0] : null);
            renderGmmTableHeader(currentGmmMode);
            renderGmmRows(membersList, currentGmmMode);
        }

        function renderGmmBulkFeeBox(mode, sampleMember) {
            const box = document.getElementById('gmmBulkFeeBox');
            if (!box) return;

            const inputStyle = `height: 28px; width: 62px; font-weight: 800; border: 1.2px solid #0284c7; border-radius: 5px; padding: 2px 4px; font-size: 12px; text-align: right; color: #0f172a; background: #ffffff;`;
            const lblStyle = `font-weight: 700; font-size: 11.5px; color: #0f172a; white-space: nowrap;`;

            const defPassport = sampleMember ? formatNumNoZero(parseFloat(sampleMember.passport_fee || 0)) : '';
            const defNamelist = sampleMember ? formatNumNoZero(parseFloat(sampleMember.namelist_fee || 0)) : '';
            const defVisa = sampleMember ? formatNumNoZero(parseFloat(sampleMember.visa_fee || 0)) : '';
            const defMissingDoc = sampleMember ? formatNumNoZero(parseFloat(sampleMember.missing_doc_fee || sampleMember.doc_fee || 0)) : '';
            const defStamping = sampleMember ? formatNumNoZero(parseFloat(sampleMember.visa_stamping_fee || sampleMember.stamping_fee || 0)) : '';

            const defMonths = sampleMember ? (sampleMember.extension_months || sampleMember.months || sampleMember.visa_months || '') : '';
            const defWork = sampleMember ? formatNumNoZero(parseFloat(sampleMember.work_permit || 0)) : '';
            const defVip = sampleMember ? formatNumNoZero(parseFloat(sampleMember.vip || 0)) : '';
            const defClearance = sampleMember ? formatNumNoZero(parseFloat(sampleMember.clearance_fee || sampleMember.clearance || 0)) : '';
            const defCar = sampleMember ? formatNumNoZero(parseFloat(sampleMember.car_fee || sampleMember.car || 0)) : '';
            const defFine = sampleMember ? formatNumNoZero(parseFloat(sampleMember.overstay || sampleMember.fine_fee || 0)) : '';

            if (mode === 'passport') {
                box.innerHTML = `
                    <div style="display: flex; align-items: center; gap: 3px;">
                        <label style="${lblStyle}">ថ្លៃប៉ាស្ព័រ (฿):</label>
                        <input type="number" step="1" id="gmmFeePassport" class="form-input num-input" placeholder="0" style="${inputStyle}" value="${defPassport}" oninput="updateGmmMemberFeesDefaults('passport')" onfocus="this.select()" onkeydown="handleGmmBulkKeydown(event, this)">
                    </div>
                    <div style="display: flex; align-items: center; gap: 3px;">
                        <label style="${lblStyle}">ថ្លៃនែមលិស (฿):</label>
                        <input type="number" step="1" id="gmmFeeNamelist" class="form-input num-input" placeholder="0" style="${inputStyle}" value="${defNamelist}" oninput="updateGmmMemberFeesDefaults('namelist')" onfocus="this.select()" onkeydown="handleGmmBulkKeydown(event, this)">
                    </div>
                    <div style="display: flex; align-items: center; gap: 3px;">
                        <label style="${lblStyle}">ថ្លៃវីសា (฿):</label>
                        <input type="number" step="1" id="gmmFeeVisa" class="form-input num-input" placeholder="0" style="${inputStyle}" value="${defVisa}" oninput="updateGmmMemberFeesDefaults('visa')" onfocus="this.select()" onkeydown="handleGmmBulkKeydown(event, this)">
                    </div>
                    <div style="display: flex; align-items: center; gap: 3px;">
                        <label style="${lblStyle}">ខ្វះឯកសារ (฿):</label>
                        <input type="number" step="1" id="gmmFeeMissingDoc" class="form-input num-input" placeholder="0" style="${inputStyle}" value="${defMissingDoc}" oninput="updateGmmMemberFeesDefaults('missing_doc')" onfocus="this.select()" onkeydown="handleGmmBulkKeydown(event, this)">
                    </div>
                    <div style="display: flex; align-items: center; gap: 3px;">
                        <label style="${lblStyle}">ថ្លៃវាយបិទវីសា (฿):</label>
                        <input type="number" step="1" id="gmmFeeStamping" class="form-input num-input" placeholder="0" style="${inputStyle}" value="${defStamping}" oninput="updateGmmMemberFeesDefaults('stamping')" onfocus="this.select()" onkeydown="handleGmmBulkKeydown(event, this)">
                    </div>
                `;
            } else if (mode === 'visa') {
                box.innerHTML = `
                    <div style="display: flex; align-items: center; gap: 3px;">
                        <label style="${lblStyle}">ថ្លៃ VISA ($):</label>
                        <input type="number" step="0.01" id="gmmFeeVisa" class="form-input num-input" placeholder="0" style="${inputStyle}" value="${defVisa}" oninput="updateGmmMemberFeesDefaults('visa')" onfocus="this.select()" onkeydown="handleGmmBulkKeydown(event, this)">
                    </div>
                    <div style="display: flex; align-items: center; gap: 3px;">
                        <label style="${lblStyle}">ចំនួនខែ:</label>
                        <input type="text" id="gmmFeeMonths" class="form-input" placeholder="1 ខែ" style="${inputStyle}; width: 50px; text-align: center;" value="${defMonths}" oninput="updateGmmMemberFeesDefaults('months')" onfocus="this.select()" onkeydown="handleGmmBulkKeydown(event, this)">
                    </div>
                    <div style="display: flex; align-items: center; gap: 3px;">
                        <label style="${lblStyle}">ថ្លៃវើក ($):</label>
                        <input type="number" step="0.01" id="gmmFeeWork" class="form-input num-input" placeholder="0" style="${inputStyle}" value="${defWork}" oninput="updateGmmMemberFeesDefaults('work')" onfocus="this.select()" onkeydown="handleGmmBulkKeydown(event, this)">
                    </div>
                    <div style="display: flex; align-items: center; gap: 3px;">
                        <label style="${lblStyle}">ថ្លៃ VIP ($):</label>
                        <input type="number" step="0.01" id="gmmFeeVip" class="form-input num-input" placeholder="0" style="${inputStyle}" value="${defVip}" oninput="updateGmmMemberFeesDefaults('vip')" onfocus="this.select()" onkeydown="handleGmmBulkKeydown(event, this)">
                    </div>
                    <div style="display: flex; align-items: center; gap: 3px;">
                        <label style="${lblStyle}">ថ្លៃពិន័យ ($):</label>
                        <input type="number" step="0.01" id="gmmFeeFine" class="form-input num-input" placeholder="0" style="${inputStyle}" value="${defFine}" oninput="updateGmmMemberFeesDefaults('fine')" onfocus="this.select()" onkeydown="handleGmmBulkKeydown(event, this)">
                    </div>
                `;
            } else {
                box.innerHTML = `
                    <div style="display: flex; align-items: center; gap: 3px;">
                        <label style="${lblStyle}">ថ្លៃ VIP ($):</label>
                        <input type="number" step="0.01" id="gmmFeeVip" class="form-input num-input" placeholder="0" style="${inputStyle}" value="${defVip}" oninput="updateGmmMemberFeesDefaults('vip')" onfocus="this.select()" onkeydown="handleGmmBulkKeydown(event, this)">
                    </div>
                    <div style="display: flex; align-items: center; gap: 3px;">
                        <label style="${lblStyle}">ថ្លៃក្លៀផ្លូវ ($):</label>
                        <input type="number" step="0.01" id="gmmFeeClearance" class="form-input num-input" placeholder="0" style="${inputStyle}" value="${defClearance}" oninput="updateGmmMemberFeesDefaults('clearance')" onfocus="this.select()" onkeydown="handleGmmBulkKeydown(event, this)">
                    </div>
                    <div style="display: flex; align-items: center; gap: 3px;">
                        <label style="${lblStyle}">ថ្លៃឡាន ($):</label>
                        <input type="number" step="0.01" id="gmmFeeCar" class="form-input num-input" placeholder="0" style="${inputStyle}" value="${defCar}" oninput="updateGmmMemberFeesDefaults('car')" onfocus="this.select()" onkeydown="handleGmmBulkKeydown(event, this)">
                    </div>
                    <div style="display: flex; align-items: center; gap: 3px;">
                        <label style="${lblStyle}">ថ្លៃពិន័យ ($):</label>
                        <input type="number" step="0.01" id="gmmFeeFine" class="form-input num-input" placeholder="0" style="${inputStyle}" value="${defFine}" oninput="updateGmmMemberFeesDefaults('fine')" onfocus="this.select()" onkeydown="handleGmmBulkKeydown(event, this)">
                    </div>
                `;
            }
        }

        function filterGmmMembers(query) {
            const q = (query || '').toLowerCase().trim();
            const rows = document.querySelectorAll('#gmmMembersBody tr.gmm-row');
            let matched = 0;
            rows.forEach(r => {
                const nameInput = r.querySelector('.gmm-input-name');
                const nameVal = (nameInput ? nameInput.value : '').toLowerCase();
                if (!q || nameVal.includes(q)) {
                    r.style.display = '';
                    matched++;
                    if (q && nameInput) {
                        nameInput.style.background = '#fef08a';
                        nameInput.style.color = '#854d0e';
                    } else if (nameInput) {
                        nameInput.style.background = '#ffffff';
                        nameInput.style.color = '#0f172a';
                    }
                } else {
                    r.style.display = 'none';
                    if (nameInput) {
                        nameInput.style.background = '#ffffff';
                        nameInput.style.color = '#0f172a';
                    }
                }
            });

            const countElem = document.getElementById('gmmSearchCount');
            if (countElem) {
                if (q) {
                    countElem.textContent = `🔎 រកឃើញ ${matched}/${rows.length} នាក់`;
                } else {
                    countElem.textContent = `👥 សរុប ${rows.length} នាក់`;
                }
            }
        }

        function clearGmmSearch() {
            const input = document.getElementById('gmmSearchInput');
            if (input) {
                input.value = '';
                filterGmmMembers('');
                input.focus();
            }
        }

        function onGmmVisaIssuedChange(cb) {
            const isChecked = cb.checked;
            const lbl = cb.closest('label');
            const txt = lbl ? lbl.querySelector('.visa-issued-label') : null;
            if (isChecked) {
                if (lbl) {
                    lbl.style.background = '#ecfdf5';
                    lbl.style.color = '#047857';
                    lbl.style.borderColor = '#10b981';
                }
                if (txt) txt.textContent = '✅ ចេញរួច';
            } else {
                if (lbl) {
                    lbl.style.background = '#f8fafc';
                    lbl.style.color = '#64748b';
                    lbl.style.borderColor = '#cbd5e1';
                }
                if (txt) txt.textContent = '⏳ រង់ចាំ';
            }
        }

        function renderGmmPhotoCell(photoData) {
            if (photoData && photoData.trim()) {
                return `
                    <div class="gmm-photo-wrapper" style="position:relative; display:inline-flex; align-items:center; justify-content:center;">
                        <img src="${photoData}" class="gmm-photo-thumb" style="width:26px; height:26px; object-fit:cover; border-radius:4px; border:1.5px solid #0284c7; cursor:pointer; box-shadow:0 1px 2px rgba(0,0,0,0.15);" onclick="openMemberPhotoPreview(this)" title="ចុចដើម្បីមើលរូបច្បាស់ HD / ទាញយក">
                        <input type="hidden" class="gmm-input-photo" value="${photoData.replace(/"/g, '&quot;')}">
                    </div>
                `;
            } else {
                return `
                    <div class="gmm-photo-wrapper" style="position:relative; display:inline-flex; align-items:center; justify-content:center;">
                        <button type="button" class="btn-sys" style="font-size:10px; padding:1px 5px; height:24px; min-height:24px; background:#f0f9ff; color:#0284c7; font-weight:800; border-radius:4px; border:1.2px dashed #38bdf8; cursor:pointer; white-space:nowrap; display:inline-flex; align-items:center; gap:2px;" onclick="triggerRowPhotoUpload(this)" title="ចុចដើម្បីដាក់រូបថត">📷 +</button>
                        <input type="file" accept="image/*" style="display:none;" onchange="handleRowPhotoSelected(this, event)">
                        <input type="hidden" class="gmm-input-photo" value="">
                    </div>
                `;
            }
        }

        let currentPhotoRowElem = null;
        let currentPreviewPhotoData = '';
        let currentPreviewMemberName = '';

        function triggerRowPhotoUpload(btn) {
            const wrapper = btn.closest('.gmm-photo-wrapper');
            const fileInput = wrapper ? wrapper.querySelector('input[type="file"]') : null;
            if (fileInput) fileInput.click();
        }

        function handleRowPhotoSelected(input, event) {
            const file = input.files && input.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function(e) {
                const dataUrl = e.target.result;
                const wrapper = input.closest('.gmm-photo-wrapper');
                if (wrapper) {
                    wrapper.innerHTML = `
                        <img src="${dataUrl}" class="gmm-photo-thumb" style="width:26px; height:26px; object-fit:cover; border-radius:4px; border:1.5px solid #0284c7; cursor:pointer; box-shadow:0 1px 2px rgba(0,0,0,0.15);" onclick="openMemberPhotoPreview(this)" title="ចុចដើម្បីមើលរូបច្បាស់ HD / ទាញយក">
                        <input type="hidden" class="gmm-input-photo" value="${dataUrl.replace(/"/g, '&quot;')}">
                    `;
                }
            };
            reader.readAsDataURL(file);
        }

        function openMemberPhotoPreview(imgElem) {
            const wrapper = imgElem.closest('.gmm-photo-wrapper');
            const tr = imgElem.closest('tr');
            const photoInput = wrapper ? wrapper.querySelector('.gmm-input-photo') : null;
            const nameInput = tr ? tr.querySelector('.gmm-input-name') : null;
            const photoData = (photoInput ? photoInput.value : '') || imgElem.src;
            const memberName = (nameInput ? nameInput.value : '').trim() || 'Passport';
            const rNo = document.getElementById('gmmReceiptNo')?.value?.trim() || currentGmmReceiptNo || 'INV';

            currentPhotoRowElem = wrapper;
            currentPreviewPhotoData = photoData;
            currentPreviewMemberName = memberName;

            const modal = document.getElementById('memberPhotoModal');
            const previewImg = document.getElementById('mpmPreviewImg');
            const titleElem = document.getElementById('mpmTitle');

            if (previewImg) previewImg.src = photoData;
            if (titleElem) titleElem.textContent = `📷 រូបថតប៉ាសស្ព័រ: ${memberName} (${rNo})`;
            if (modal) {
                modal.style.display = 'flex';
                modal.classList.add('active');
            }
        }

        function closeMemberPhotoModal() {
            const modal = document.getElementById('memberPhotoModal');
            if (modal) {
                modal.style.display = 'none';
                modal.classList.remove('active');
            }
            currentPhotoRowElem = null;
            currentPreviewPhotoData = '';
        }

        function downloadCurrentPhotoHD() {
            if (!currentPreviewPhotoData) return;
            const rNo = document.getElementById('gmmReceiptNo')?.value?.trim() || currentGmmReceiptNo || 'INV';
            const cleanRNo = rNo.replace(/[^a-zA-Z0-9_-]/g, '_');
            const cleanName = currentPreviewMemberName.replace(/[^a-zA-Z0-9_-]/g, '_') || 'Passport';

            let ext = 'jpg';
            if (currentPreviewPhotoData.startsWith('data:image/png')) ext = 'png';
            else if (currentPreviewPhotoData.startsWith('data:image/webp')) ext = 'webp';

            const filename = `${cleanRNo}_${cleanName}.${ext}`;

            const a = document.createElement('a');
            a.href = currentPreviewPhotoData;
            a.download = filename;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        }

        function triggerReplacePhotoFromModal() {
            const inp = document.getElementById('mpmReplaceFileInput');
            if (inp) inp.click();
        }

        function handleModalPhotoReplaced(event) {
            const file = event.target.files && event.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function(e) {
                const dataUrl = e.target.result;
                currentPreviewPhotoData = dataUrl;
                const previewImg = document.getElementById('mpmPreviewImg');
                if (previewImg) previewImg.src = dataUrl;

                if (currentPhotoRowElem) {
                    currentPhotoRowElem.innerHTML = `
                        <img src="${dataUrl}" class="gmm-photo-thumb" style="width:26px; height:26px; object-fit:cover; border-radius:4px; border:1.5px solid #0284c7; cursor:pointer; box-shadow:0 1px 2px rgba(0,0,0,0.15);" onclick="openMemberPhotoPreview(this)" title="ចុចដើម្បីមើលរូបច្បាស់ HD / ទាញយក">
                        <input type="hidden" class="gmm-input-photo" value="${dataUrl.replace(/"/g, '&quot;')}">
                    `;
                }
            };
            reader.readAsDataURL(file);
            event.target.value = '';
        }

        function removePhotoFromModal() {
            if (confirm('តើអ្នកពិតជាចង់លុបរូបថតនេះមែនទេ?')) {
                if (currentPhotoRowElem) {
                    currentPhotoRowElem.innerHTML = `
                        <button type="button" class="btn-sys" style="font-size:10px; padding:1px 5px; height:24px; min-height:24px; background:#f0f9ff; color:#0284c7; font-weight:800; border-radius:4px; border:1.2px dashed #38bdf8; cursor:pointer; white-space:nowrap; display:inline-flex; align-items:center; gap:2px;" onclick="triggerRowPhotoUpload(this)" title="ចុចដើម្បីដាក់រូបថត">📷 +</button>
                        <input type="file" accept="image/*" style="display:none;" onchange="handleRowPhotoSelected(this, event)">
                        <input type="hidden" class="gmm-input-photo" value="">
                    `;
                }
                closeMemberPhotoModal();
            }
        }

        function handleGmmMultiPhotoUpload(event) {
            const files = Array.from(event.target.files || []);
            if (files.length === 0) return;

            const tbody = document.getElementById('gmmMembersBody');
            if (!tbody) return;

            let rows = Array.from(tbody.querySelectorAll('.gmm-row'));

            files.forEach((file, fIdx) => {
                let targetRow = rows[fIdx];
                if (!targetRow) {
                    addNewGmmMemberRow();
                    rows = Array.from(tbody.querySelectorAll('.gmm-row'));
                    targetRow = rows[rows.length - 1];
                }

                const reader = new FileReader();
                reader.onload = function(e) {
                    const dataUrl = e.target.result;
                    if (targetRow) {
                        const wrapper = targetRow.querySelector('.gmm-photo-wrapper');
                        if (wrapper) {
                            wrapper.innerHTML = `
                                <img src="${dataUrl}" class="gmm-photo-thumb" style="width:26px; height:26px; object-fit:cover; border-radius:4px; border:1.5px solid #0284c7; cursor:pointer; box-shadow:0 1px 2px rgba(0,0,0,0.15);" onclick="openMemberPhotoPreview(this)" title="ចុចដើម្បីមើលរូបច្បាស់ HD / ទាញយក">
                                <input type="hidden" class="gmm-input-photo" value="${dataUrl.replace(/"/g, '&quot;')}">
                            `;
                        }
                    }
                };
                reader.readAsDataURL(file);
            });
            event.target.value = '';
        }

        function renderGmmTableHeader(mode) {
            const head = document.getElementById('gmmTableHead');
            if (!head) return;

            if (mode === 'passport') {
                head.innerHTML = `
                    <tr style="background: #e2e8f0; color: #0f172a; font-size: 12px; font-weight: 800;">
                        <th style="width: 30px; text-align: center; padding: 4px 2px; white-space: nowrap;">ល.រ</th>
                        <th style="width: 34px; text-align: center; padding: 4px 2px; white-space: nowrap;"><input type="checkbox" id="gmmSelectAll" onchange="toggleGmmSelectAll(this)" style="cursor: pointer; width: 15px; height: 15px; vertical-align: middle; accent-color: #0284c7;" title="ជ្រើសរើសទាំងអស់"></th>
                        <th style="min-width: 170px; text-align: left; padding: 4px 8px; white-space: nowrap;">ឈ្មោះសមាជិក (Passport Name)</th>
                        <th style="width: 48px; text-align: center; padding: 4px 2px; white-space: nowrap;">📷 រូបថត</th>
                        <th style="width: 75px; text-align: center; padding: 4px 2px; white-space: nowrap;">ថ្លៃប៉ាស្ព័រ (฿)</th>
                        <th style="width: 75px; text-align: center; padding: 4px 2px; white-space: nowrap;">ថ្លៃនែមលិស (฿)</th>
                        <th style="width: 75px; text-align: center; padding: 4px 2px; white-space: nowrap;">ថ្លៃវីសា (฿)</th>
                        <th style="width: 75px; text-align: center; padding: 4px 2px; white-space: nowrap;">ខ្វះឯកសារ (฿)</th>
                        <th style="width: 82px; text-align: center; padding: 4px 2px; white-space: nowrap;">ថ្លៃវាយបិទវីសា (฿)</th>
                        <th style="width: 75px; text-align: center; padding: 4px 2px; white-space: nowrap;">សរុប (฿)</th>
                        <th style="width: 58px; text-align: center; padding: 4px 2px; white-space: nowrap;">សកម្មភាព</th>
                    </tr>
                `;
            } else if (mode === 'visa') {
                head.innerHTML = `
                    <tr style="background: #e2e8f0; color: #0f172a; font-size: 12px; font-weight: 800;">
                        <th style="width: 30px; text-align: center; padding: 4px 2px; white-space: nowrap;">ល.រ</th>
                        <th style="width: 34px; text-align: center; padding: 4px 2px; white-space: nowrap;"><input type="checkbox" id="gmmSelectAll" onchange="toggleGmmSelectAll(this)" style="cursor: pointer; width: 15px; height: 15px; vertical-align: middle; accent-color: #0284c7;" title="ជ្រើសរើសទាំងអស់"></th>
                        <th style="min-width: 190px; text-align: left; padding: 4px 8px; white-space: nowrap;">ឈ្មោះសមាជិក (Passport Name)</th>
                        <th style="width: 48px; text-align: center; padding: 4px 2px; white-space: nowrap;">📷 រូបថត</th>
                        <th style="width: 65px; text-align: center; padding: 4px 2px; white-space: nowrap;">ថ្លៃ VISA ($)</th>
                        <th style="width: 58px; text-align: center; padding: 4px 2px; color: #0369a1; white-space: nowrap;">ចំនួនខែ</th>
                        <th style="width: 65px; text-align: center; padding: 4px 2px; white-space: nowrap;">ថ្លៃវើក ($)</th>
                        <th style="width: 65px; text-align: center; padding: 4px 2px; white-space: nowrap;">ថ្លៃ VIP ($)</th>
                        <th style="width: 65px; text-align: center; padding: 4px 2px; white-space: nowrap;">ថ្លៃពិន័យ ($)</th>
                        <th style="width: 65px; text-align: center; padding: 4px 2px; white-space: nowrap;">សរុប ($)</th>
                        <th style="width: 88px; text-align: center; padding: 4px 2px; color: #047857; white-space: nowrap;">វីសាចេញ</th>
                        <th style="width: 58px; text-align: center; padding: 4px 2px; white-space: nowrap;">សកម្មភាព</th>
                    </tr>
                `;
            } else {
                head.innerHTML = `
                    <tr style="background: #e2e8f0; color: #0f172a; font-size: 12px; font-weight: 800;">
                        <th style="width: 30px; text-align: center; padding: 4px 2px; white-space: nowrap;">ល.រ</th>
                        <th style="width: 34px; text-align: center; padding: 4px 2px; white-space: nowrap;"><input type="checkbox" id="gmmSelectAll" onchange="toggleGmmSelectAll(this)" style="cursor: pointer; width: 15px; height: 15px; vertical-align: middle; accent-color: #0284c7;" title="ជ្រើសរើសទាំងអស់"></th>
                        <th style="min-width: 200px; text-align: left; padding: 4px 8px; white-space: nowrap;">ឈ្មោះសមាជិក (Passport Name)</th>
                        <th style="width: 48px; text-align: center; padding: 4px 2px; white-space: nowrap;">📷 រូបថត</th>
                        <th style="width: 68px; text-align: center; padding: 4px 2px; white-space: nowrap;">ថ្លៃ VIP ($)</th>
                        <th style="width: 72px; text-align: center; padding: 4px 2px; white-space: nowrap;">ថ្លៃក្លៀផ្លូវ ($)</th>
                        <th style="width: 68px; text-align: center; padding: 4px 2px; white-space: nowrap;">ថ្លៃឡាន ($)</th>
                        <th style="width: 68px; text-align: center; padding: 4px 2px; white-space: nowrap;">ថ្លៃពិន័យ ($)</th>
                        <th style="width: 68px; text-align: center; padding: 4px 2px; white-space: nowrap;">សរុប ($)</th>
                        <th style="width: 58px; text-align: center; padding: 4px 2px; white-space: nowrap;">សកម្មភាព</th>
                    </tr>
                `;
            }
        }

        function renderGmmRows(members, mode) {
            const tbody = document.getElementById('gmmMembersBody');
            if (!tbody) return;

            const inputStyleName = `width:100%; height:26px; padding:1px 8px; font-size:12.5px; background:#ffffff; border:1px solid #94a3b8; color:#0f172a; font-weight:700; border-radius:4px; box-sizing:border-box;`;
            const inputStyleFee = `width:100%; height:26px; padding:1px 2px; font-size:12px; background:#ffffff; border:1px solid #94a3b8; color:#0284c7; font-weight:700; text-align:center; border-radius:4px; box-sizing:border-box;`;
            const inputStyleUsd = `width:100%; height:26px; padding:1px 2px; font-size:12px; background:#ecfdf5; border:1px solid #10b981; color:#047857; font-weight:800; text-align:center; border-radius:4px; box-sizing:border-box;`;

            if (!members || members.length === 0) {
                if (mode === 'passport') {
                    const rawPassport = document.getElementById('gmmFeePassport')?.value?.trim();
                    const rawNamelist = document.getElementById('gmmFeeNamelist')?.value?.trim();
                    const rawVisa = document.getElementById('gmmFeeVisa')?.value?.trim();
                    const rawMissingDoc = document.getElementById('gmmFeeMissingDoc')?.value?.trim();
                    const rawStamping = document.getElementById('gmmFeeStamping')?.value?.trim();

                    const defPassport = rawPassport ? parseFloat(rawPassport) : 0;
                    const defNamelist = rawNamelist ? parseFloat(rawNamelist) : 0;
                    const defVisa = rawVisa ? parseFloat(rawVisa) : 0;
                    const defMissingDoc = rawMissingDoc ? parseFloat(rawMissingDoc) : 0;
                    const defStamping = rawStamping ? parseFloat(rawStamping) : 0;
                    const defUsd = (rawPassport || rawNamelist || rawVisa || rawMissingDoc || rawStamping) ? (defPassport + defNamelist + defVisa + defMissingDoc + defStamping) : 0;

                    tbody.innerHTML = `
                        <tr class="gmm-row" data-mode="passport">
                            <td style="text-align:center; font-weight:800; font-size:12.5px; color:#0284c7; padding: 1.5px 2px;" class="gmm-row-num">1</td>
                            <td style="text-align:center; vertical-align:middle; padding: 1.5px 2px;"><input type="checkbox" class="gmm-row-select" onchange="onGmmRowSelectionChange(this)" style="cursor:pointer; width:15px; height:15px; margin:0; accent-color:#0284c7;"></td>
                            <td style="padding: 1.5px 3px;"><input type="text" class="input-sys gmm-input-name" placeholder="ឈ្មោះសមាជិក" style="${inputStyleName}" value="" oninput="calculateGmmTotal()" onfocus="this.select()" onkeydown="handleGmmRowKeydown(event, this)" onpaste="handleGmmNamePaste(event, this)"></td>
                            <td style="text-align:center; vertical-align:middle; padding: 1.5px 2px;">${renderGmmPhotoCell('')}</td>
                            <td style="padding: 1.5px 2px;"><input type="number" step="0.01" class="input-sys gmm-input-passport" placeholder="" style="${inputStyleFee}" value="${rawPassport ? formatNumNoZero(defPassport) : ''}" oninput="onGmmRowFeeChanged(this)" onfocus="this.select()" onkeydown="handleGmmRowKeydown(event, this)"></td>
                            <td style="padding: 1.5px 2px;"><input type="number" step="0.01" class="input-sys gmm-input-namelist" placeholder="" style="${inputStyleFee}" value="${rawNamelist ? formatNumNoZero(defNamelist) : ''}" oninput="onGmmRowFeeChanged(this)" onfocus="this.select()" onkeydown="handleGmmRowKeydown(event, this)"></td>
                            <td style="padding: 1.5px 2px;"><input type="number" step="0.01" class="input-sys gmm-input-visa" placeholder="" style="${inputStyleFee}" value="${rawVisa ? formatNumNoZero(defVisa) : ''}" oninput="onGmmRowFeeChanged(this)" onfocus="this.select()" onkeydown="handleGmmRowKeydown(event, this)"></td>
                            <td style="padding: 1.5px 2px;"><input type="number" step="0.01" class="input-sys gmm-input-missing-doc" placeholder="" style="${inputStyleFee}" value="${rawMissingDoc ? formatNumNoZero(defMissingDoc) : ''}" oninput="onGmmRowFeeChanged(this)" onfocus="this.select()" onkeydown="handleGmmRowKeydown(event, this)"></td>
                            <td style="padding: 1.5px 2px;"><input type="number" step="0.01" class="input-sys gmm-input-stamping" placeholder="" style="${inputStyleFee}" value="${rawStamping ? formatNumNoZero(defStamping) : ''}" oninput="onGmmRowFeeChanged(this)" onfocus="this.select()" onkeydown="handleGmmRowKeydown(event, this)"></td>
                            <td style="padding: 1.5px 2px;"><input type="number" step="0.01" class="input-sys gmm-input-usd" placeholder="" style="${inputStyleUsd}" value="${defUsd > 0 ? formatNumNoZero(defUsd) : ''}" oninput="calculateGmmTotal()" onfocus="this.select()" onkeydown="handleGmmRowKeydown(event, this)"></td>
                            <td style="text-align:center; padding: 1.5px 2px;">
                                <button type="button" class="btn-sys btn-rose" style="font-size:10.5px; padding:1px 6px; height:24px; min-height:24px; background:#dc2626; color:#ffffff; font-weight:bold; border-radius:4px; border:none; cursor:pointer; white-space:nowrap; display:inline-flex; align-items:center; justify-content:center; gap:2px; box-sizing:border-box;" onclick="removeGmmRow(this)">🗑️ លុប</button>
                            </td>
                        </tr>
                    `;
                } else if (mode === 'visa') {
                    const rawVisa = document.getElementById('gmmFeeVisa')?.value?.trim();
                    const rawMonths = document.getElementById('gmmFeeMonths')?.value?.trim() || '';
                    const rawWork = document.getElementById('gmmFeeWork')?.value?.trim();
                    const rawVip = document.getElementById('gmmFeeVip')?.value?.trim();
                    const rawFine = document.getElementById('gmmFeeFine')?.value?.trim();

                    const defVisa = rawVisa ? parseFloat(rawVisa) : 0;
                    const defWork = rawWork ? parseFloat(rawWork) : 0;
                    const defVip = rawVip ? parseFloat(rawVip) : 0;
                    const defFine = rawFine ? parseFloat(rawFine) : 0;
                    const defUsd = (rawVisa || rawWork || rawVip || rawFine) ? (defVisa + defWork + defVip + defFine) : 0;

                    tbody.innerHTML = `
                        <tr class="gmm-row" data-mode="visa">
                            <td style="text-align:center; font-weight:800; font-size:12.5px; color:#0284c7; padding: 1.5px 2px;" class="gmm-row-num">1</td>
                            <td style="text-align:center; vertical-align:middle; padding: 1.5px 2px;"><input type="checkbox" class="gmm-row-select" onchange="onGmmRowSelectionChange(this)" style="cursor:pointer; width:15px; height:15px; margin:0; accent-color:#0284c7;"></td>
                            <td style="padding: 1.5px 3px;"><input type="text" class="input-sys gmm-input-name" placeholder="ឈ្មោះសមាជិក" style="${inputStyleName}" value="" oninput="calculateGmmTotal()" onfocus="this.select()" onkeydown="handleGmmRowKeydown(event, this)" onpaste="handleGmmNamePaste(event, this)"></td>
                            <td style="text-align:center; vertical-align:middle; padding: 1.5px 2px;">${renderGmmPhotoCell('')}</td>
                            <td style="padding: 1.5px 2px;"><input type="number" step="0.01" class="input-sys gmm-input-visa" placeholder="" style="${inputStyleFee}" value="${rawVisa ? formatNumNoZero(defVisa) : ''}" oninput="onGmmRowFeeChanged(this)" onfocus="this.select()" onkeydown="handleGmmRowKeydown(event, this)"></td>
                            <td style="padding: 1.5px 2px;"><input type="text" class="input-sys gmm-input-months" placeholder="ឧ. 1ខែ" style="${inputStyleFee}; color:#0f172a;" value="${rawMonths}" onfocus="this.select()" onkeydown="handleGmmRowKeydown(event, this)"></td>
                            <td style="padding: 1.5px 2px;"><input type="number" step="0.01" class="input-sys gmm-input-permit" placeholder="" style="${inputStyleFee}" value="${rawWork ? formatNumNoZero(defWork) : ''}" oninput="onGmmRowFeeChanged(this)" onfocus="this.select()" onkeydown="handleGmmRowKeydown(event, this)"></td>
                            <td style="padding: 1.5px 2px;"><input type="number" step="0.01" class="input-sys gmm-input-vip" placeholder="" style="${inputStyleFee}" value="${rawVip ? formatNumNoZero(defVip) : ''}" oninput="onGmmRowFeeChanged(this)" onfocus="this.select()" onkeydown="handleGmmRowKeydown(event, this)"></td>
                            <td style="padding: 1.5px 2px;"><input type="number" step="0.01" class="input-sys gmm-input-fine" placeholder="" style="${inputStyleFee}" value="${rawFine ? formatNumNoZero(defFine) : ''}" oninput="onGmmRowFeeChanged(this)" onfocus="this.select()" onkeydown="handleGmmRowKeydown(event, this)"></td>
                            <td style="padding: 1.5px 2px;"><input type="number" step="0.01" class="input-sys gmm-input-usd" placeholder="" style="${inputStyleUsd}" value="${defUsd > 0 ? formatNumNoZero(defUsd) : ''}" oninput="calculateGmmTotal()" onfocus="this.select()" onkeydown="handleGmmRowKeydown(event, this)"></td>
                            <td style="text-align:center; vertical-align:middle; padding: 1.5px 2px;">
                                <label style="display:inline-flex; align-items:center; justify-content:center; gap:3px; cursor:pointer; user-select:none; font-size:10.5px; font-weight:800; background:#f8fafc; color:#64748b; border:1px solid #cbd5e1; padding:1px 5px; height:24px; border-radius:4px; transition:all 0.15s; white-space:nowrap; box-sizing:border-box;">
                                    <input type="checkbox" class="gmm-input-visa-issued" onchange="onGmmVisaIssuedChange(this)" style="cursor:pointer; width:13px; height:13px; margin:0; accent-color:#10b981;">
                                    <span class="visa-issued-label" style="white-space:nowrap;">⏳ រង់ចាំ</span>
                                </label>
                            </td>
                            <td style="text-align:center; padding: 1.5px 2px;">
                                <button type="button" class="btn-sys btn-rose" style="font-size:10.5px; padding:1px 6px; height:24px; min-height:24px; background:#dc2626; color:#ffffff; font-weight:bold; border-radius:4px; border:none; cursor:pointer; white-space:nowrap; display:inline-flex; align-items:center; justify-content:center; gap:2px; box-sizing:border-box;" onclick="removeGmmRow(this)">🗑️ លុប</button>
                            </td>
                        </tr>
                    `;
                } else {
                    const rawVip = document.getElementById('gmmFeeVip')?.value?.trim();
                    const rawClearance = document.getElementById('gmmFeeClearance')?.value?.trim();
                    const rawCar = document.getElementById('gmmFeeCar')?.value?.trim();
                    const rawFine = document.getElementById('gmmFeeFine')?.value?.trim();

                    const defVip = rawVip ? parseFloat(rawVip) : 0;
                    const defClearance = rawClearance ? parseFloat(rawClearance) : 0;
                    const defCar = rawCar ? parseFloat(rawCar) : 0;
                    const defFine = rawFine ? parseFloat(rawFine) : 0;
                    const defUsd = (rawVip || rawClearance || rawCar || rawFine) ? (defVip + defClearance + defCar + defFine) : 0;

                    tbody.innerHTML = `
                        <tr class="gmm-row" data-mode="line">
                            <td style="text-align:center; font-weight:800; font-size:12.5px; color:#0284c7; padding: 1.5px 2px;" class="gmm-row-num">1</td>
                            <td style="text-align:center; vertical-align:middle; padding: 1.5px 2px;"><input type="checkbox" class="gmm-row-select" onchange="onGmmRowSelectionChange(this)" style="cursor:pointer; width:15px; height:15px; margin:0; accent-color:#0284c7;"></td>
                            <td style="padding: 1.5px 3px;"><input type="text" class="input-sys gmm-input-name" placeholder="ឈ្មោះសមាជិក" style="${inputStyleName}" value="" oninput="calculateGmmTotal()" onfocus="this.select()" onkeydown="handleGmmRowKeydown(event, this)" onpaste="handleGmmNamePaste(event, this)"></td>
                            <td style="text-align:center; vertical-align:middle; padding: 1.5px 2px;">${renderGmmPhotoCell('')}</td>
                            <td style="padding: 1.5px 2px;"><input type="number" step="0.01" class="input-sys gmm-input-vip" placeholder="" style="${inputStyleFee}" value="${rawVip ? formatNumNoZero(defVip) : ''}" oninput="onGmmRowFeeChanged(this)" onfocus="this.select()" onkeydown="handleGmmRowKeydown(event, this)"></td>
                            <td style="padding: 1.5px 2px;"><input type="number" step="0.01" class="input-sys gmm-input-clearance" placeholder="" style="${inputStyleFee}" value="${rawClearance ? formatNumNoZero(defClearance) : ''}" oninput="onGmmRowFeeChanged(this)" onfocus="this.select()" onkeydown="handleGmmRowKeydown(event, this)"></td>
                            <td style="padding: 1.5px 2px;"><input type="number" step="0.01" class="input-sys gmm-input-car" placeholder="" style="${inputStyleFee}" value="${rawCar ? formatNumNoZero(defCar) : ''}" oninput="onGmmRowFeeChanged(this)" onfocus="this.select()" onkeydown="handleGmmRowKeydown(event, this)"></td>
                            <td style="padding: 1.5px 2px;"><input type="number" step="0.01" class="input-sys gmm-input-fine" placeholder="" style="${inputStyleFee}" value="${rawFine ? formatNumNoZero(defFine) : ''}" oninput="onGmmRowFeeChanged(this)" onfocus="this.select()" onkeydown="handleGmmRowKeydown(event, this)"></td>
                            <td style="padding: 1.5px 2px;"><input type="number" step="0.01" class="input-sys gmm-input-usd" placeholder="" style="${inputStyleUsd}" value="${defUsd > 0 ? formatNumNoZero(defUsd) : ''}" oninput="calculateGmmTotal()" onfocus="this.select()" onkeydown="handleGmmRowKeydown(event, this)"></td>
                            <td style="text-align:center; padding: 1.5px 2px;">
                                <button type="button" class="btn-sys btn-rose" style="font-size:10.5px; padding:1px 6px; height:24px; min-height:24px; background:#dc2626; color:#ffffff; font-weight:bold; border-radius:4px; border:none; cursor:pointer; white-space:nowrap; display:inline-flex; align-items:center; justify-content:center; gap:2px; box-sizing:border-box;" onclick="removeGmmRow(this)">🗑️ លុប</button>
                            </td>
                        </tr>
                    `;
                }
            } else {
                tbody.innerHTML = members.map((m, idx) => {
                    const safeName = (m.full_english_name || m.english_name || m.name || '').replace(/"/g, '&quot;');
                    const photoData = m.photo_data || m.photo || m.image_url || '';
                    const passportFee = parseFloat(m.passport_fee || 0);
                    const namelistFee = parseFloat(m.namelist_fee || 0);
                    const missingDoc = parseFloat(m.missing_doc_fee || m.doc_fee || 0);
                    const stamping = parseFloat(m.visa_stamping_fee || m.stamping_fee || 0);
                    const visa = parseFloat(m.visa_fee || 0);
                    const monthsVal = (m.extension_months || m.months || m.visa_months || '').replace(/"/g, '&quot;');
                    const permit = parseFloat(m.work_permit || 0);
                    const vip = parseFloat(m.vip || 0);
                    const clearance = parseFloat(m.clearance_fee || m.clearance || 0);
                    const car = parseFloat(m.car_fee || m.car || 0);
                    const fine = parseFloat(m.overstay || m.fine_fee || 0);
                    const isIssued = (m.visa_issued === true || m.visa_issued === 'true' || m.visa_status === 'issued' || m.status === 'issued');
                    
                    let usd = parseFloat(m.usd || 0);
                    if (usd === 0) {
                        if (mode === 'passport') {
                            usd = passportFee + namelistFee + visa + missingDoc + stamping;
                        } else if (mode === 'visa') {
                            usd = visa + permit + vip + fine;
                        } else {
                            usd = vip + clearance + car + fine;
                        }
                    }

                    if (mode === 'passport') {
                        return `
                        <tr class="gmm-row" data-mode="passport">
                            <td style="text-align:center; font-weight:800; font-size:12.5px; color:#0284c7; padding: 1.5px 2px;" class="gmm-row-num">${idx + 1}</td>
                            <td style="text-align:center; vertical-align:middle; padding: 1.5px 2px;"><input type="checkbox" class="gmm-row-select" onchange="onGmmRowSelectionChange(this)" style="cursor:pointer; width:15px; height:15px; margin:0; accent-color:#0284c7;"></td>
                            <td style="padding: 1.5px 3px;"><input type="text" class="input-sys gmm-input-name" placeholder="ឈ្មោះសមាជិក" style="${inputStyleName}" value="${safeName}" oninput="calculateGmmTotal()" onfocus="this.select()" onkeydown="handleGmmRowKeydown(event, this)" onpaste="handleGmmNamePaste(event, this)"></td>
                            <td style="text-align:center; vertical-align:middle; padding: 1.5px 2px;">${renderGmmPhotoCell(photoData)}</td>
                            <td style="padding: 1.5px 2px;"><input type="number" step="0.01" class="input-sys gmm-input-passport" placeholder="" style="${inputStyleFee}" value="${formatNumNoZero(passportFee)}" oninput="onGmmRowFeeChanged(this)" onfocus="this.select()" onkeydown="handleGmmRowKeydown(event, this)"></td>
                            <td style="padding: 1.5px 2px;"><input type="number" step="0.01" class="input-sys gmm-input-namelist" placeholder="" style="${inputStyleFee}" value="${formatNumNoZero(namelistFee)}" oninput="onGmmRowFeeChanged(this)" onfocus="this.select()" onkeydown="handleGmmRowKeydown(event, this)"></td>
                            <td style="padding: 1.5px 2px;"><input type="number" step="0.01" class="input-sys gmm-input-visa" placeholder="" style="${inputStyleFee}" value="${formatNumNoZero(visa)}" oninput="onGmmRowFeeChanged(this)" onfocus="this.select()" onkeydown="handleGmmRowKeydown(event, this)"></td>
                            <td style="padding: 1.5px 2px;"><input type="number" step="0.01" class="input-sys gmm-input-missing-doc" placeholder="" style="${inputStyleFee}" value="${formatNumNoZero(missingDoc)}" oninput="onGmmRowFeeChanged(this)" onfocus="this.select()" onkeydown="handleGmmRowKeydown(event, this)"></td>
                            <td style="padding: 1.5px 2px;"><input type="number" step="0.01" class="input-sys gmm-input-stamping" placeholder="" style="${inputStyleFee}" value="${formatNumNoZero(stamping)}" oninput="onGmmRowFeeChanged(this)" onfocus="this.select()" onkeydown="handleGmmRowKeydown(event, this)"></td>
                            <td style="padding: 1.5px 2px;"><input type="number" step="0.01" class="input-sys gmm-input-usd" placeholder="" style="${inputStyleUsd}" value="${formatNumNoZero(usd)}" oninput="calculateGmmTotal()" onfocus="this.select()" onkeydown="handleGmmRowKeydown(event, this)"></td>
                            <td style="text-align:center; padding: 1.5px 2px;">
                                <button type="button" class="btn-sys btn-rose" style="font-size:10.5px; padding:1px 6px; height:24px; min-height:24px; background:#dc2626; color:#ffffff; font-weight:bold; border-radius:4px; border:none; cursor:pointer; white-space:nowrap; display:inline-flex; align-items:center; justify-content:center; gap:2px; box-sizing:border-box;" onclick="removeGmmRow(this)">🗑️ លុប</button>
                            </td>
                        </tr>
                        `;
                    } else if (mode === 'visa') {
                        return `
                        <tr class="gmm-row" data-mode="visa">
                            <td style="text-align:center; font-weight:800; font-size:12.5px; color:#0284c7; padding: 1.5px 2px;" class="gmm-row-num">${idx + 1}</td>
                            <td style="text-align:center; vertical-align:middle; padding: 1.5px 2px;"><input type="checkbox" class="gmm-row-select" onchange="onGmmRowSelectionChange(this)" style="cursor:pointer; width:15px; height:15px; margin:0; accent-color:#0284c7;"></td>
                            <td style="padding: 1.5px 3px;"><input type="text" class="input-sys gmm-input-name" placeholder="ឈ្មោះសមាជិក" style="${inputStyleName}" value="${safeName}" oninput="calculateGmmTotal()" onfocus="this.select()" onkeydown="handleGmmRowKeydown(event, this)" onpaste="handleGmmNamePaste(event, this)"></td>
                            <td style="text-align:center; vertical-align:middle; padding: 1.5px 2px;">${renderGmmPhotoCell(photoData)}</td>
                            <td style="padding: 1.5px 2px;"><input type="number" step="0.01" class="input-sys gmm-input-visa" placeholder="" style="${inputStyleFee}" value="${formatNumNoZero(visa)}" oninput="onGmmRowFeeChanged(this)" onfocus="this.select()" onkeydown="handleGmmRowKeydown(event, this)"></td>
                            <td style="padding: 1.5px 2px;"><input type="text" class="input-sys gmm-input-months" placeholder="ឧ. 1ខែ" style="${inputStyleFee}; color:#0f172a;" value="${monthsVal}" onfocus="this.select()" onkeydown="handleGmmRowKeydown(event, this)"></td>
                            <td style="padding: 1.5px 2px;"><input type="number" step="0.01" class="input-sys gmm-input-permit" placeholder="" style="${inputStyleFee}" value="${formatNumNoZero(permit)}" oninput="onGmmRowFeeChanged(this)" onfocus="this.select()" onkeydown="handleGmmRowKeydown(event, this)"></td>
                            <td style="padding: 1.5px 2px;"><input type="number" step="0.01" class="input-sys gmm-input-vip" placeholder="" style="${inputStyleFee}" value="${formatNumNoZero(vip)}" oninput="onGmmRowFeeChanged(this)" onfocus="this.select()" onkeydown="handleGmmRowKeydown(event, this)"></td>
                            <td style="padding: 1.5px 2px;"><input type="number" step="0.01" class="input-sys gmm-input-fine" placeholder="" style="${inputStyleFee}" value="${formatNumNoZero(fine)}" oninput="onGmmRowFeeChanged(this)" onfocus="this.select()" onkeydown="handleGmmRowKeydown(event, this)"></td>
                            <td style="padding: 1.5px 2px;"><input type="number" step="0.01" class="input-sys gmm-input-usd" placeholder="" style="${inputStyleUsd}" value="${formatNumNoZero(usd)}" oninput="calculateGmmTotal()" onfocus="this.select()" onkeydown="handleGmmRowKeydown(event, this)"></td>
                            <td style="text-align:center; vertical-align:middle; padding: 1.5px 2px;">
                                <label style="display:inline-flex; align-items:center; justify-content:center; gap:3px; cursor:pointer; user-select:none; font-size:10.5px; font-weight:800; background:${isIssued ? '#ecfdf5' : '#f8fafc'}; color:${isIssued ? '#047857' : '#64748b'}; border:1px solid ${isIssued ? '#10b981' : '#cbd5e1'}; padding:1px 5px; height:24px; border-radius:4px; transition:all 0.15s; white-space:nowrap; box-sizing:border-box;">
                                    <input type="checkbox" class="gmm-input-visa-issued" ${isIssued ? 'checked' : ''} onchange="onGmmVisaIssuedChange(this)" style="cursor:pointer; width:13px; height:13px; margin:0; accent-color:#10b981;">
                                    <span class="visa-issued-label" style="white-space:nowrap;">${isIssued ? '✅ ចេញរួច' : '⏳ រង់ចាំ'}</span>
                                </label>
                            </td>
                            <td style="text-align:center; padding: 1.5px 2px;">
                                <button type="button" class="btn-sys btn-rose" style="font-size:10.5px; padding:1px 6px; height:24px; min-height:24px; background:#dc2626; color:#ffffff; font-weight:bold; border-radius:4px; border:none; cursor:pointer; white-space:nowrap; display:inline-flex; align-items:center; justify-content:center; gap:2px; box-sizing:border-box;" onclick="removeGmmRow(this)">🗑️ លុប</button>
                            </td>
                        </tr>
                        `;
                    } else {
                        return `
                        <tr class="gmm-row" data-mode="line">
                            <td style="text-align:center; font-weight:800; font-size:12.5px; color:#0284c7; padding: 1.5px 2px;" class="gmm-row-num">${idx + 1}</td>
                            <td style="text-align:center; vertical-align:middle; padding: 1.5px 2px;"><input type="checkbox" class="gmm-row-select" onchange="onGmmRowSelectionChange(this)" style="cursor:pointer; width:15px; height:15px; margin:0; accent-color:#0284c7;"></td>
                            <td style="padding: 1.5px 3px;"><input type="text" class="input-sys gmm-input-name" placeholder="ឈ្មោះសមាជិក" style="${inputStyleName}" value="${safeName}" oninput="calculateGmmTotal()" onfocus="this.select()" onkeydown="handleGmmRowKeydown(event, this)" onpaste="handleGmmNamePaste(event, this)"></td>
                            <td style="text-align:center; vertical-align:middle; padding: 1.5px 2px;">${renderGmmPhotoCell(photoData)}</td>
                            <td style="padding: 1.5px 2px;"><input type="number" step="0.01" class="input-sys gmm-input-vip" placeholder="" style="${inputStyleFee}" value="${formatNumNoZero(vip)}" oninput="onGmmRowFeeChanged(this)" onfocus="this.select()" onkeydown="handleGmmRowKeydown(event, this)"></td>
                            <td style="padding: 1.5px 2px;"><input type="number" step="0.01" class="input-sys gmm-input-clearance" placeholder="" style="${inputStyleFee}" value="${formatNumNoZero(clearance)}" oninput="onGmmRowFeeChanged(this)" onfocus="this.select()" onkeydown="handleGmmRowKeydown(event, this)"></td>
                            <td style="padding: 1.5px 2px;"><input type="number" step="0.01" class="input-sys gmm-input-car" placeholder="" style="${inputStyleFee}" value="${formatNumNoZero(car)}" oninput="onGmmRowFeeChanged(this)" onfocus="this.select()" onkeydown="handleGmmRowKeydown(event, this)"></td>
                            <td style="padding: 1.5px 2px;"><input type="number" step="0.01" class="input-sys gmm-input-fine" placeholder="" style="${inputStyleFee}" value="${formatNumNoZero(fine)}" oninput="onGmmRowFeeChanged(this)" onfocus="this.select()" onkeydown="handleGmmRowKeydown(event, this)"></td>
                            <td style="padding: 1.5px 2px;"><input type="number" step="0.01" class="input-sys gmm-input-usd" placeholder="" style="${inputStyleUsd}" value="${formatNumNoZero(usd)}" oninput="calculateGmmTotal()" onfocus="this.select()" onkeydown="handleGmmRowKeydown(event, this)"></td>
                            <td style="text-align:center; padding: 1.5px 2px;">
                                <button type="button" class="btn-sys btn-rose" style="font-size:10.5px; padding:1px 6px; height:24px; min-height:24px; background:#dc2626; color:#ffffff; font-weight:bold; border-radius:4px; border:none; cursor:pointer; white-space:nowrap; display:inline-flex; align-items:center; justify-content:center; gap:2px; box-sizing:border-box;" onclick="removeGmmRow(this)">🗑️ លុប</button>
                            </td>
                        </tr>
                        `;
                    }
                }).join('');
            }
            calculateGmmTotal();
            updateGmmSelectionUI();
        }

        function toggleGmmSelectAll(masterCb) {
            const isChecked = masterCb ? masterCb.checked : false;
            const rows = document.querySelectorAll('#gmmMembersBody tr.gmm-row');
            rows.forEach(r => {
                if (r.style.display !== 'none') {
                    const cb = r.querySelector('.gmm-row-select');
                    if (cb) {
                        cb.checked = isChecked;
                        if (isChecked) {
                            r.style.backgroundColor = '#f0f9ff';
                        } else {
                            r.style.backgroundColor = '';
                        }
                    }
                }
            });
            updateGmmSelectionUI();
        }

        function onGmmRowSelectionChange(cb) {
            const tr = cb ? cb.closest('tr') : null;
            if (tr && cb) {
                if (cb.checked) {
                    tr.style.backgroundColor = '#f0f9ff';
                } else {
                    tr.style.backgroundColor = '';
                }
            }
            const allCbs = document.querySelectorAll('#gmmMembersBody .gmm-row-select');
            const checkedCbs = document.querySelectorAll('#gmmMembersBody .gmm-row-select:checked');
            const master = document.getElementById('gmmSelectAll');
            if (master) {
                if (checkedCbs.length === 0) {
                    master.checked = false;
                    master.indeterminate = false;
                } else if (checkedCbs.length === allCbs.length) {
                    master.checked = true;
                    master.indeterminate = false;
                } else {
                    master.checked = false;
                    master.indeterminate = true;
                }
            }
            updateGmmSelectionUI();
        }

        function updateGmmSelectionUI() {
            const checkedRows = document.querySelectorAll('#gmmMembersBody .gmm-row-select:checked');
            const count = checkedRows.length;
            
            const badge = document.getElementById('gmmSelectedBadge');
            if (badge) {
                badge.textContent = count;
                badge.style.display = count > 0 ? 'inline-block' : 'none';
            }

            const summary = document.getElementById('gmmSelectedSummary');
            const countSpan = document.getElementById('gmmSelectedCount');
            if (summary && countSpan) {
                countSpan.textContent = count;
                summary.style.display = count > 0 ? 'inline-flex' : 'none';
            }
        }

        let pendingSplitPayload = null;

        function openSplitGroupModal() {
            const checkedRows = Array.from(document.querySelectorAll('#gmmMembersBody tr.gmm-row')).filter(r => {
                const cb = r.querySelector('.gmm-row-select');
                return cb && cb.checked;
            });

            if (checkedRows.length === 0) {
                alert('⚠️ សូមជ្រើសរើស (☑️) សមាជិកយ៉ាងហោចណាស់ 1 នាក់ ដើម្បីបំបែកគ្រុបថ្មី!');
                return;
            }

            const allRows = document.querySelectorAll('#gmmMembersBody tr.gmm-row');
            if (checkedRows.length === allRows.length) {
                if (!confirm(`⚠️ អ្នកបានជ្រើសរើសសមាជិកទាំងអស់ (${checkedRows.length} នាក់)។ ប្រសិនបើបំបែកទាំងអស់ គ្រុបចាស់នឹងលែងមានសមាជិកឡើយ។ តើអ្នកពិតជាចង់បន្តមែនទេ?`)) {
                    return;
                }
            }

            const splitMembers = [];
            checkedRows.forEach(r => {
                const name = r.querySelector('.gmm-input-name')?.value?.trim() || '';
                const passport = parseFloat(r.querySelector('.gmm-input-passport')?.value || 0);
                const namelist = parseFloat(r.querySelector('.gmm-input-namelist')?.value || 0);
                const missingDoc = parseFloat(r.querySelector('.gmm-input-missing-doc')?.value || 0);
                const stamping = parseFloat(r.querySelector('.gmm-input-stamping')?.value || 0);
                const evisa = parseFloat(r.querySelector('.gmm-input-evisa')?.value || 0);
                const vip = parseFloat(r.querySelector('.gmm-input-vip')?.value || 0);
                const clearance = parseFloat(r.querySelector('.gmm-input-clearance')?.value || 0);
                const permit = parseFloat(r.querySelector('.gmm-input-permit')?.value || 0);
                const car = parseFloat(r.querySelector('.gmm-input-car')?.value || 0);
                const visa = parseFloat(r.querySelector('.gmm-input-visa')?.value || 0);
                const months = r.querySelector('.gmm-input-months')?.value?.trim() || '';
                const fine = parseFloat(r.querySelector('.gmm-input-fine')?.value || 0);
                let usd = parseFloat(r.querySelector('.gmm-input-usd')?.value || 0);
                if (usd === 0) {
                    if (currentGmmMode === 'passport') {
                        usd = passport + namelist + visa + missingDoc + stamping;
                    } else if (currentGmmMode === 'visa') {
                        usd = visa + permit + vip + fine + evisa;
                    } else {
                        usd = vip + clearance + car + fine + evisa;
                    }
                }
                const isVisaIssued = r.querySelector('.gmm-input-visa-issued')?.checked || false;

                if (name) {
                    splitMembers.push({
                        full_english_name: name,
                        name: name,
                        passport_fee: passport,
                        namelist_fee: namelist,
                        missing_doc_fee: missingDoc,
                        visa_stamping_fee: stamping,
                        extension_months: months,
                        months: months,
                        visa_months: months,
                        e_visa: evisa,
                        vip: vip,
                        clearance_fee: clearance,
                        work_permit: permit,
                        car_fee: car,
                        visa_fee: visa,
                        overstay: fine,
                        fine_fee: fine,
                        usd: usd,
                        visa_issued: isVisaIssued,
                        visa_status: isVisaIssued ? 'issued' : 'pending'
                    });
                }
            });

            if (splitMembers.length === 0) {
                alert('⚠️ មិនមានឈ្មោះសមាជិកត្រឹមត្រូវក្នុងជួរដែលបានជ្រើសរើសឡើយ!');
                return;
            }

            const curReceiptNo = document.getElementById('gmmReceiptNo')?.value?.trim() || currentGmmReceiptNo;
            const curSender = document.getElementById('gmmSenderName')?.value?.trim() || '';
            const curAgency = document.getElementById('gmmAgencyCompany')?.value?.trim() || '';
            const curDate = document.getElementById('gmmTravelDate')?.value || '';
            const curExchangeRate = parseFloat(document.getElementById('gmmExchangeRate')?.value || 33.90);
            const category = currentGmmMode || 'visa';

            // Auto fetch next receipt number
            fetch(`/api/next_no?category=${category}`)
                .then(r => r.json())
                .then(res => {
                    const nextNo = (res && res.next_no) ? res.next_no : (category === 'visa' ? 'VISA 00001' : 'INV 00001');
                    const sgmReceiptInp = document.getElementById('sgmNewReceiptNo');
                    if (sgmReceiptInp) sgmReceiptInp.value = nextNo;
                })
                .catch(() => {
                    const sgmReceiptInp = document.getElementById('sgmNewReceiptNo');
                    if (sgmReceiptInp && !sgmReceiptInp.value) {
                        sgmReceiptInp.value = (category === 'visa' ? 'VISA 00001' : 'INV 00001');
                    }
                });

            const sgmBadge = document.getElementById('sgmSelectedCountBadge');
            if (sgmBadge) sgmBadge.textContent = `${splitMembers.length} នាក់`;

            const previewElem = document.getElementById('sgmMembersListPreview');
            if (previewElem) {
                previewElem.innerHTML = splitMembers.map((m, i) => `
                    <div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid #f1f5f9; padding:2px 0;">
                        <span>${i + 1}. <strong style="color:#0f172a;">${m.full_english_name}</strong></span>
                        <span style="color:#059669; font-weight:800;">$${m.usd.toFixed(2)}</span>
                    </div>
                `).join('');
            }

            const senderInp = document.getElementById('sgmSenderName');
            if (senderInp) senderInp.value = curSender;

            const agencyInp = document.getElementById('sgmAgencyCompany');
            if (agencyInp) agencyInp.value = curAgency;

            const dateInp = document.getElementById('sgmTravelDate');
            if (dateInp) dateInp.value = curDate || formatIsoDateForInput(new Date());

            const remainingCount = allRows.length - splitMembers.length;
            const noticeElem = document.getElementById('sgmComparisonNotice');
            if (noticeElem) {
                noticeElem.innerHTML = `💡 គ្រុបចាស់ [<strong>${curReceiptNo}</strong>] នឹងនៅសល់ <strong>${remainingCount} នាក់</strong> | គ្រុបថ្មីនឹងមាន <strong>${splitMembers.length} នាក់</strong>`;
            }

            pendingSplitPayload = {
                source_receipt_no: curReceiptNo,
                split_members: splitMembers,
                service_category: category,
                exchange_rate: curExchangeRate
            };

            const splitModal = document.getElementById('splitGroupModal');
            if (splitModal) {
                splitModal.classList.add('active');
                splitModal.style.display = 'flex';
            }
        }

        function closeSplitGroupModal() {
            const splitModal = document.getElementById('splitGroupModal');
            if (splitModal) {
                splitModal.classList.remove('active');
                splitModal.style.display = 'none';
            }
        }

        function confirmExecuteSplitGroup() {
            if (!pendingSplitPayload) return;

            const newReceiptNo = document.getElementById('sgmNewReceiptNo')?.value?.trim();
            const senderName = document.getElementById('sgmSenderName')?.value?.trim();
            const travelDate = document.getElementById('sgmTravelDate')?.value || '';
            const agencyCompany = document.getElementById('sgmAgencyCompany')?.value?.trim() || '';

            if (!newReceiptNo) {
                alert('⚠️ សូមបញ្ចូលលេខវិក្កយបត្រថ្មី!');
                document.getElementById('sgmNewReceiptNo')?.focus();
                return;
            }

            if (!senderName) {
                alert('⚠️ សូមបញ្ចូលឈ្មោះអ្នកនាំ/បញ្ជូន!');
                document.getElementById('sgmSenderName')?.focus();
                return;
            }

            pendingSplitPayload.new_receipt_no = newReceiptNo;
            pendingSplitPayload.new_sender_name = senderName;
            pendingSplitPayload.new_travel_date = travelDate;
            pendingSplitPayload.new_agency_company = agencyCompany;

            const btnConfirm = document.getElementById('btnConfirmSplit');
            if (btnConfirm) {
                btnConfirm.disabled = true;
                btnConfirm.textContent = '⏳ កំពុងបំបែកគ្រុប...';
            }

            fetch('/api/split_group', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(pendingSplitPayload)
            })
            .then(r => r.json())
            .then(res => {
                if (btnConfirm) {
                    btnConfirm.disabled = false;
                    btnConfirm.textContent = '✂️ បញ្ជាក់ការបំបែកគ្រុប (Confirm Split)';
                }
                if (res.success) {
                    alert(`🎉 បានបំបែកគ្រុបថ្មី [${res.new_receipt_no}] ចំនួន ${res.new_count} នាក់ ដោយជោគជ័យ!\nគ្រុបចាស់ [${res.source_receipt_no}] នៅសល់ ${res.remaining_count} នាក់។`);
                    closeSplitGroupModal();
                    closeGroupMembersModal();
                    loadDatabaseRecords();
                    pendingSplitPayload = null;
                } else {
                    alert('បរាជ័យក្នុងការបំបែកគ្រុប៖ ' + (res.error || ''));
                }
            })
            .catch(err => {
                if (btnConfirm) {
                    btnConfirm.disabled = false;
                    btnConfirm.textContent = '✂️ បញ្ជាក់ការបំបែកគ្រុប (Confirm Split)';
                }
                alert('កំហុសក្នុងការផ្ញើទិន្នន័យ៖ ' + (err.message || err));
            });
        }

        function onGmmVisaIssuedChange(cb) {
            if (!cb) return;
            const parentLabel = cb.closest('label');
            const lblSpan = parentLabel ? parentLabel.querySelector('.visa-issued-label') : null;
            if (cb.checked) {
                if (lblSpan) lblSpan.textContent = '✅ ចេញរួច';
                if (parentLabel) {
                    parentLabel.style.background = '#ecfdf5';
                    parentLabel.style.color = '#047857';
                    parentLabel.style.borderColor = '#10b981';
                }
            } else {
                if (lblSpan) lblSpan.textContent = '⏳ រង់ចាំ';
                if (parentLabel) {
                    parentLabel.style.background = '#f8fafc';
                    parentLabel.style.color = '#64748b';
                    parentLabel.style.borderColor = '#cbd5e1';
                }
            }
        }

        function openGroupMembersModal(rNoEnc, idx) {
            const rNo = decodeURIComponent(rNoEnc || '');
            currentGmmReceiptNo = rNo;
            const item = getItemByRef(rNoEnc, idx);
            currentGmmCachedItem = item;
            
            if (item) {
                const titleElem = document.getElementById('gmmTitle');
                const subTitleElem = document.getElementById('gmmSubTitle');
                const sender = item.group_info?.sender_name || item.group_data?.sender_name || item.group_info?.group_name || item.sender || item.customer_name || item.customer?.full_english_name || 'N/A';
                const agency = item.group_info?.agency_company || item.group_data?.agency_company || item.agency_company || item.customer?.agency_company || '';
                const members = item.members || [];
                const rawDate = item.group_info?.travel_date || item.group_data?.travel_date || item.group_data?.date_str || item.travel_date || '';
                const isoDate = formatIsoDateForInput(rawDate);
                
                if (titleElem) titleElem.textContent = `📋 គ្រប់គ្រងសមាជិកក្រុម ${rNo} (${members.length} នាក់)`;
                if (subTitleElem) subTitleElem.textContent = `👤 អ្នកនាំ: ${sender} | 🏢 ក្រុមហ៊ុន: ${agency || '-'}`;

                const tDateInput = document.getElementById('gmmTravelDate');
                if (tDateInput) tDateInput.value = isoDate;

                const rNoInput = document.getElementById('gmmReceiptNo');
                if (rNoInput) rNoInput.value = rNo;

                const rateInput = document.getElementById('gmmExchangeRate');
                if (rateInput) rateInput.value = item.exchange_rate || item.group_data?.exchange_rate || '33.90';

                const senderInput = document.getElementById('gmmSenderName');
                if (senderInput) senderInput.value = sender;

                const agencyInput = document.getElementById('gmmAgencyCompany');
                if (agencyInput) agencyInput.value = agency;

                const gmmSearchInp = document.getElementById('gmmSearchInput');
                if (gmmSearchInp) gmmSearchInp.value = '';
                const countElem = document.getElementById('gmmSearchCount');
                if (countElem) countElem.textContent = `👥 សរុប ${members.length} នាក់`;
            }

            const masterCb = document.getElementById('gmmSelectAll');
            if (masterCb) {
                masterCb.checked = false;
                masterCb.indeterminate = false;
            }
            updateGmmSelectionUI();

            // Detect mode: Visa, Line (Car), or Passport
            let initialMode = 'line';
            if (item) {
                if (item.service_category === 'passport' || item.group_info?.service_category === 'passport' || isPassportRecord(item)) {
                    initialMode = 'passport';
                } else if (item.service_category === 'visa' || item.group_info?.service_category === 'visa') {
                    initialMode = 'visa';
                } else if (item.service_category === 'car' || item.group_info?.service_category === 'car') {
                    initialMode = 'line';
                } else if (currentServiceCategory === 'passport') {
                    initialMode = 'passport';
                } else if (currentServiceCategory === 'visa') {
                    initialMode = 'visa';
                } else if (currentServiceCategory === 'car') {
                    initialMode = 'line';
                } else {
                    initialMode = isPassportRecord(item) ? 'passport' : (isVisaRecord(item) ? 'visa' : 'line');
                }
            } else {
                initialMode = (currentServiceCategory === 'passport') ? 'passport' : ((currentServiceCategory === 'visa') ? 'visa' : 'line');
            }

            // Clear table body before loading new record
            const tbody = document.getElementById('gmmMembersBody');
            if (tbody) tbody.innerHTML = '';

            const members = (item && item.members && item.members.length > 0) ? item.members : [];

            // Set button text to: 💾 កែប្រែ & រក្សាទុក (Update & Save)
            const btnSave = document.getElementById('btnGmmSave');
            if (btnSave) {
                btnSave.textContent = '💾 កែប្រែ & រក្សាទុក (Update & Save)';
            }

            switchGmmMode(initialMode, members);

            const modal = document.getElementById('groupMembersModal');
            if (modal) {
                modal.classList.add('active');
                modal.style.display = 'flex';
            }
        }

        function handleGmmHeaderKeydown(event, input) {
            const headerIds = ['gmmTravelDate', 'gmmReceiptNo', 'gmmExchangeRate', 'gmmSenderName'];
            const idx = headerIds.indexOf(input.id);

            if (event.key === 'Enter' || event.key === 'ArrowRight') {
                if (input.type === 'text' && event.key === 'ArrowRight' && input.selectionStart < input.value.length) return;
                event.preventDefault();
                if (idx >= 0 && idx < headerIds.length - 1) {
                    const next = document.getElementById(headerIds[idx + 1]);
                    if (next) { next.focus(); setTimeout(() => next.select && next.select(), 10); }
                } else {
                    const mode = currentGmmMode;
                    const firstBulkId = (mode === 'visa') ? 'gmmFeeVisa' : 'gmmFeeVip';
                    const bulk = document.getElementById(firstBulkId);
                    if (bulk) { bulk.focus(); setTimeout(() => bulk.select(), 10); }
                }
            } else if (event.key === 'ArrowLeft') {
                if (input.type === 'text' && input.selectionStart > 0) return;
                event.preventDefault();
                if (idx > 0) {
                    const prev = document.getElementById(headerIds[idx - 1]);
                    if (prev) { prev.focus(); setTimeout(() => prev.select && prev.select(), 10); }
                }
            } else if (event.key === 'ArrowDown') {
                event.preventDefault();
                const mode = currentGmmMode;
                const firstBulkId = (mode === 'visa') ? 'gmmFeeVisa' : 'gmmFeeVip';
                const bulk = document.getElementById(firstBulkId);
                if (bulk) {
                    bulk.focus();
                    setTimeout(() => bulk.select(), 10);
                } else {
                    const firstName = document.querySelector('#gmmMembersBody .gmm-row .gmm-input-name');
                    if (firstName) { firstName.focus(); setTimeout(() => firstName.select(), 10); }
                }
            }
        }

        function handleGmmBulkKeydown(event, input) {
            const mode = currentGmmMode;
            const bulkIds = (mode === 'visa') 
                ? ['gmmFeeVisa', 'gmmFeeWork', 'gmmFeeVip', 'gmmFeeFine']
                : ['gmmFeeVip', 'gmmFeeClearance', 'gmmFeeCar', 'gmmFeeFine'];

            const colSelectors = (mode === 'visa')
                ? ['.gmm-input-visa', '.gmm-input-permit', '.gmm-input-vip', '.gmm-input-fine']
                : ['.gmm-input-vip', '.gmm-input-clearance', '.gmm-input-car', '.gmm-input-fine'];

            const currentIndex = bulkIds.indexOf(input.id);

            if (event.key === 'ArrowRight' || event.key === 'Enter') {
                event.preventDefault();
                if (currentIndex >= 0 && currentIndex < bulkIds.length - 1) {
                    const nextBulk = document.getElementById(bulkIds[currentIndex + 1]);
                    if (nextBulk) { nextBulk.focus(); setTimeout(() => nextBulk.select(), 10); }
                } else {
                    const firstRowName = document.querySelector('#gmmMembersBody .gmm-row .gmm-input-name');
                    if (firstRowName) { firstRowName.focus(); setTimeout(() => firstRowName.select(), 10); }
                }
            } else if (event.key === 'ArrowLeft') {
                event.preventDefault();
                if (currentIndex > 0) {
                    const prevBulk = document.getElementById(bulkIds[currentIndex - 1]);
                    if (prevBulk) { prevBulk.focus(); setTimeout(() => prevBulk.select(), 10); }
                } else {
                    const sender = document.getElementById('gmmSenderName');
                    if (sender) { sender.focus(); setTimeout(() => sender.select(), 10); }
                }
            } else if (event.key === 'ArrowDown') {
                event.preventDefault();
                const selector = currentIndex >= 0 ? colSelectors[currentIndex] : '.gmm-input-name';
                const firstRowCell = document.querySelector('#gmmMembersBody .gmm-row ' + selector);
                if (firstRowCell) {
                    firstRowCell.focus();
                    setTimeout(() => firstRowCell.select(), 10);
                } else {
                    const firstName = document.querySelector('#gmmMembersBody .gmm-row .gmm-input-name');
                    if (firstName) { firstName.focus(); setTimeout(() => firstName.select(), 10); }
                }
            } else if (event.key === 'ArrowUp') {
                event.preventDefault();
                const sender = document.getElementById('gmmSenderName');
                if (sender) { sender.focus(); setTimeout(() => sender.select(), 10); }
            }
        }

        function handleGmmRowKeydown(event, input) {
            const tr = input.closest('tr');
            if (!tr) return;

            const mode = currentGmmMode;
            const colSelectors = (mode === 'visa')
                ? ['.gmm-input-name', '.gmm-input-visa', '.gmm-input-permit', '.gmm-input-vip', '.gmm-input-fine']
                : (mode === 'passport'
                    ? ['.gmm-input-name', '.gmm-input-passport', '.gmm-input-namelist', '.gmm-input-visa', '.gmm-input-missing-doc', '.gmm-input-stamping']
                    : ['.gmm-input-name', '.gmm-input-vip', '.gmm-input-clearance', '.gmm-input-car', '.gmm-input-fine']);

            const bulkIds = (mode === 'visa')
                ? ['gmmSenderName', 'gmmFeeVisa', 'gmmFeeWork', 'gmmFeeVip', 'gmmFeeFine']
                : (mode === 'passport'
                    ? ['gmmSenderName', 'gmmFeePassport', 'gmmFeeNamelist', 'gmmFeeVisa', 'gmmFeeMissingDoc', 'gmmFeeStamping']
                    : ['gmmSenderName', 'gmmFeeVip', 'gmmFeeClearance', 'gmmFeeCar', 'gmmFeeFine']);

            const currentClass = Array.from(input.classList).find(c => c.startsWith('gmm-input-'));
            const colIndex = colSelectors.findIndex(s => s === '.' + currentClass);
            const isTextInput = input.type === 'text';

            if (event.key === 'ArrowRight') {
                if (isTextInput && input.selectionStart !== input.selectionEnd && input.selectionStart !== input.value.length) {
                    return;
                }
                if (isTextInput && input.selectionStart < input.value.length) {
                    return;
                }

                event.preventDefault();
                if (colIndex >= 0 && colIndex < colSelectors.length - 1) {
                    const nextCell = tr.querySelector(colSelectors[colIndex + 1]);
                    if (nextCell) {
                        nextCell.focus();
                        setTimeout(() => nextCell.select(), 10);
                    }
                } else if (colIndex === colSelectors.length - 1) {
                    const nextTr = tr.nextElementSibling;
                    if (nextTr) {
                        const firstCell = nextTr.querySelector(colSelectors[0]);
                        if (firstCell) {
                            firstCell.focus();
                            setTimeout(() => firstCell.select(), 10);
                        }
                    }
                }
            } else if (event.key === 'ArrowLeft') {
                if (isTextInput && input.selectionStart !== input.selectionEnd && input.selectionStart !== 0) {
                    return;
                }
                if (isTextInput && input.selectionStart > 0) {
                    return;
                }

                event.preventDefault();
                if (colIndex > 0) {
                    const prevCell = tr.querySelector(colSelectors[colIndex - 1]);
                    if (prevCell) {
                        prevCell.focus();
                        setTimeout(() => prevCell.select(), 10);
                    }
                } else if (colIndex === 0) {
                    const prevTr = tr.previousElementSibling;
                    if (prevTr) {
                        const lastCell = prevTr.querySelector(colSelectors[colSelectors.length - 1]);
                        if (lastCell) {
                            lastCell.focus();
                            setTimeout(() => lastCell.select(), 10);
                        }
                    }
                }
            } else if (event.key === 'ArrowDown') {
                event.preventDefault();
                const nextTr = tr.nextElementSibling;
                if (nextTr) {
                    const targetSelector = colIndex >= 0 ? colSelectors[colIndex] : '.gmm-input-name';
                    const targetInput = nextTr.querySelector(targetSelector);
                    if (targetInput) {
                        targetInput.focus();
                        setTimeout(() => targetInput.select(), 10);
                    }
                } else {
                    addNewGmmMemberRow();
                    const tbody = document.getElementById('gmmMembersBody');
                    const newTr = tbody ? tbody.lastElementChild : null;
                    if (newTr) {
                        const targetSelector = colIndex >= 0 ? colSelectors[colIndex] : '.gmm-input-name';
                        const targetInput = newTr.querySelector(targetSelector);
                        if (targetInput) {
                            targetInput.focus();
                            setTimeout(() => targetInput.select(), 10);
                        }
                    }
                }
            } else if (event.key === 'ArrowUp') {
                event.preventDefault();
                const prevTr = tr.previousElementSibling;
                if (prevTr) {
                    const targetSelector = colIndex >= 0 ? colSelectors[colIndex] : '.gmm-input-name';
                    const targetInput = prevTr.querySelector(targetSelector);
                    if (targetInput) {
                        targetInput.focus();
                        setTimeout(() => targetInput.select(), 10);
                    }
                } else {
                    const bulkId = colIndex >= 0 ? bulkIds[colIndex] : 'gmmSenderName';
                    const bulkInput = document.getElementById(bulkId);
                    if (bulkInput) {
                        bulkInput.focus();
                        setTimeout(() => bulkInput.select(), 10);
                    }
                }
            } else if (event.key === 'Enter') {
                event.preventDefault();
                if (colIndex === 0) {
                    const nextTr = tr.nextElementSibling;
                    if (nextTr) {
                        const nextName = nextTr.querySelector('.gmm-input-name');
                        if (nextName) {
                            nextName.focus();
                            setTimeout(() => nextName.select(), 10);
                        }
                    } else {
                        addNewGmmMemberRow();
                        const tbody = document.getElementById('gmmMembersBody');
                        const newTr = tbody ? tbody.lastElementChild : null;
                        if (newTr) {
                            const nextName = newTr.querySelector('.gmm-input-name');
                            if (nextName) {
                                nextName.focus();
                                setTimeout(() => nextName.select(), 10);
                            }
                        }
                    }
                } else if (colIndex >= 1 && colIndex < colSelectors.length - 1) {
                    const nextCell = tr.querySelector(colSelectors[colIndex + 1]);
                    if (nextCell) {
                        nextCell.focus();
                        setTimeout(() => nextCell.select(), 10);
                    }
                } else {
                    const nextTr = tr.nextElementSibling;
                    if (nextTr) {
                        const nextName = nextTr.querySelector('.gmm-input-name');
                        if (nextName) {
                            nextName.focus();
                            setTimeout(() => nextName.select(), 10);
                        }
                    } else {
                        addNewGmmMemberRow();
                        const tbody = document.getElementById('gmmMembersBody');
                        const newTr = tbody ? tbody.lastElementChild : null;
                        if (newTr) {
                            const nextName = newTr.querySelector('.gmm-input-name');
                            if (nextName) {
                                nextName.focus();
                                setTimeout(() => nextName.select(), 10);
                            }
                        }
                    }
                }
            }
        }

        function handleGmmNamePaste(event, input) {
            const text = (event.clipboardData || window.clipboardData)?.getData('text');
            if (!text || !text.includes('\n')) return;
            event.preventDefault();

            const lines = text.split(/\r?\n/).map(l => l.replace(/^\d+[\.\)]\s*/, '').trim()).filter(l => l.length > 0);
            if (lines.length === 0) return;

            input.value = lines[0];
            onGmmRowFeeChanged(input);

            const tr = input.closest('tr');
            let currentTr = tr;

            for (let i = 1; i < lines.length; i++) {
                let nextTr = currentTr ? currentTr.nextElementSibling : null;
                if (!nextTr) {
                    addNewGmmMemberRow();
                    const tbody = document.getElementById('gmmMembersBody');
                    nextTr = tbody ? tbody.lastElementChild : null;
                }
                if (nextTr) {
                    const nameInp = nextTr.querySelector('.gmm-input-name');
                    if (nameInp) {
                        nameInp.value = lines[i];
                        onGmmRowFeeChanged(nameInp);
                    }
                    currentTr = nextTr;
                }
            }
            calculateGmmTotal();
        }

        function updateGmmMemberFeesDefaults(targetField) {
            const passport = parseFloat(document.getElementById('gmmFeePassport')?.value || 0);
            const namelist = parseFloat(document.getElementById('gmmFeeNamelist')?.value || 0);
            const missingDoc = parseFloat(document.getElementById('gmmFeeMissingDoc')?.value || 0);
            const stamping = parseFloat(document.getElementById('gmmFeeStamping')?.value || 0);
            const vip = parseFloat(document.getElementById('gmmFeeVip')?.value || 0);
            const car = parseFloat(document.getElementById('gmmFeeCar')?.value || 0);
            const clearance = parseFloat(document.getElementById('gmmFeeClearance')?.value || 0);
            const visa = parseFloat(document.getElementById('gmmFeeVisa')?.value || 0);
            const months = document.getElementById('gmmFeeMonths')?.value || '';
            const permit = parseFloat(document.getElementById('gmmFeeWork')?.value || 0);
            const fine = parseFloat(document.getElementById('gmmFeeFine')?.value || 0);
            const fmtVal = v => (v > 0 ? (v % 1 === 0 ? v : v.toFixed(2)) : '');

            document.querySelectorAll('#gmmMembersBody tr.gmm-row').forEach(r => {
                if (!targetField || targetField === 'passport') {
                    const inp = r.querySelector('.gmm-input-passport');
                    if (inp) inp.value = fmtVal(passport);
                }
                if (!targetField || targetField === 'namelist') {
                    const inp = r.querySelector('.gmm-input-namelist');
                    if (inp) inp.value = fmtVal(namelist);
                }
                if (!targetField || targetField === 'missing_doc') {
                    const inp = r.querySelector('.gmm-input-missing-doc');
                    if (inp) inp.value = fmtVal(missingDoc);
                }
                if (!targetField || targetField === 'stamping') {
                    const inp = r.querySelector('.gmm-input-stamping');
                    if (inp) inp.value = fmtVal(stamping);
                }
                if (!targetField || targetField === 'vip') {
                    const inp = r.querySelector('.gmm-input-vip');
                    if (inp) inp.value = fmtVal(vip);
                }
                if (!targetField || targetField === 'car') {
                    const inp = r.querySelector('.gmm-input-car');
                    if (inp) inp.value = fmtVal(car);
                }
                if (!targetField || targetField === 'clearance') {
                    const inp = r.querySelector('.gmm-input-clearance');
                    if (inp) inp.value = fmtVal(clearance);
                }
                if (!targetField || targetField === 'visa') {
                    const inp = r.querySelector('.gmm-input-visa');
                    if (inp) inp.value = fmtVal(visa);
                }
                if (!targetField || targetField === 'months') {
                    const inp = r.querySelector('.gmm-input-months');
                    if (inp) inp.value = months;
                }
                if (!targetField || targetField === 'work' || targetField === 'permit') {
                    const inp = r.querySelector('.gmm-input-permit');
                    if (inp) inp.value = fmtVal(permit);
                }
                if (!targetField || targetField === 'fine') {
                    const inp = r.querySelector('.gmm-input-fine');
                    if (inp) inp.value = fmtVal(fine);
                }
                const anyInp = r.querySelector('.gmm-input-name') || r.querySelector('input');
                if (anyInp) onGmmRowFeeChanged(anyInp);
            });
            calculateGmmTotal();
        }

        function onGmmRowFeeChanged(elem) {
            const tr = elem.closest('tr');
            if (!tr) return;

            const passport = parseFloat(tr.querySelector('.gmm-input-passport')?.value || 0);
            const namelist = parseFloat(tr.querySelector('.gmm-input-namelist')?.value || 0);
            const missingDoc = parseFloat(tr.querySelector('.gmm-input-missing-doc')?.value || 0);
            const stamping = parseFloat(tr.querySelector('.gmm-input-stamping')?.value || 0);
            const visa = parseFloat(tr.querySelector('.gmm-input-visa')?.value || 0);
            const permit = parseFloat(tr.querySelector('.gmm-input-permit')?.value || 0);
            const vip = parseFloat(tr.querySelector('.gmm-input-vip')?.value || 0);
            const clearance = parseFloat(tr.querySelector('.gmm-input-clearance')?.value || 0);
            const car = parseFloat(tr.querySelector('.gmm-input-car')?.value || 0);
            const fine = parseFloat(tr.querySelector('.gmm-input-fine')?.value || 0);
            const evisa = parseFloat(tr.querySelector('.gmm-input-evisa')?.value || 0);

            let rowSum = 0;
            if (currentGmmMode === 'passport') {
                rowSum = passport + namelist + visa + missingDoc + stamping;
            } else if (currentGmmMode === 'visa') {
                rowSum = visa + permit + vip + fine + evisa;
            } else {
                rowSum = vip + clearance + car + fine + evisa;
            }

            const usdInput = tr.querySelector('.gmm-input-usd');
            if (usdInput) {
                usdInput.value = rowSum > 0 ? (rowSum % 1 === 0 ? rowSum.toFixed(0) : rowSum.toFixed(2)) : '';
            }
            calculateGmmTotal();
        }

        function calculateGmmTotal() {
            let sum = 0;
            const rows = document.querySelectorAll('#gmmMembersBody .gmm-row');
            rows.forEach(r => {
                const usd = parseFloat(r.querySelector('.gmm-input-usd')?.value || 0);
                sum += usd;
            });
            const ft = document.getElementById('gmmGrandTotalDisplay') || document.getElementById('gmmTotalFooter');
            if (ft) {
                if (currentGmmMode === 'passport') {
                    const formattedBaht = (sum % 1 === 0) ? sum.toLocaleString('en-US') : sum.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});
                    ft.innerHTML = `💵 សរុបទឹកប្រាក់ក្នុងក្រុម (${rows.length} នាក់)៖ <span style="font-size: 16px; font-weight: 800; color: #059669;">฿${formattedBaht}</span>`;
                } else {
                    ft.innerHTML = `💵 សរុបទឹកប្រាក់ក្នុងក្រុម (${rows.length} នាក់)៖ <span style="font-size: 16px; font-weight: 800; color: #059669;">$${sum.toFixed(2)}</span>`;
                }
            }
        }

        function addNewGmmMemberRow() {
            const tbody = document.getElementById('gmmMembersBody');
            if (!tbody) return;

            const inputStyleName = `width:100%; height:26px; padding:1px 8px; font-size:12.5px; background:#ffffff; border:1px solid #94a3b8; color:#0f172a; font-weight:700; border-radius:4px; box-sizing:border-box;`;
            const inputStyleFee = `width:100%; height:26px; padding:1px 2px; font-size:12px; background:#ffffff; border:1px solid #94a3b8; color:#0284c7; font-weight:700; text-align:center; border-radius:4px; box-sizing:border-box;`;
            const inputStyleUsd = `width:100%; height:26px; padding:1px 2px; font-size:12px; background:#ecfdf5; border:1px solid #10b981; color:#047857; font-weight:800; text-align:center; border-radius:4px; box-sizing:border-box;`;

            const currentCount = tbody.querySelectorAll('.gmm-row').length;
            const tr = document.createElement('tr');
            tr.className = 'gmm-row';

            if (currentGmmMode === 'passport') {
                const rawPassport = document.getElementById('gmmFeePassport')?.value?.trim();
                const rawNamelist = document.getElementById('gmmFeeNamelist')?.value?.trim();
                const rawVisa = document.getElementById('gmmFeeVisa')?.value?.trim();
                const rawMissingDoc = document.getElementById('gmmFeeMissingDoc')?.value?.trim();
                const rawStamping = document.getElementById('gmmFeeStamping')?.value?.trim();

                const defPassport = rawPassport ? parseFloat(rawPassport) : 0;
                const defNamelist = rawNamelist ? parseFloat(rawNamelist) : 0;
                const defVisa = rawVisa ? parseFloat(rawVisa) : 0;
                const defMissingDoc = rawMissingDoc ? parseFloat(rawMissingDoc) : 0;
                const defStamping = rawStamping ? parseFloat(rawStamping) : 0;
                const defUsd = (rawPassport || rawNamelist || rawVisa || rawMissingDoc || rawStamping) ? (defPassport + defNamelist + defVisa + defMissingDoc + defStamping) : 0;

                tr.setAttribute('data-mode', 'passport');
                tr.innerHTML = `
                    <td style="text-align:center; font-weight:800; font-size:12.5px; color:#0284c7; padding: 1.5px 2px;" class="gmm-row-num">${currentCount + 1}</td>
                    <td style="text-align:center; vertical-align:middle; padding: 1.5px 2px;"><input type="checkbox" class="gmm-row-select" onchange="onGmmRowSelectionChange(this)" style="cursor:pointer; width:15px; height:15px; margin:0; accent-color:#0284c7;"></td>
                    <td style="padding: 1.5px 3px;"><input type="text" class="input-sys gmm-input-name" placeholder="ឈ្មោះសមាជិក" style="${inputStyleName}" value="" oninput="calculateGmmTotal()" onfocus="this.select()" onkeydown="handleGmmRowKeydown(event, this)" onpaste="handleGmmNamePaste(event, this)"></td>
                    <td style="text-align:center; vertical-align:middle; padding: 1.5px 2px;">${renderGmmPhotoCell('')}</td>
                    <td style="padding: 1.5px 2px;"><input type="number" step="0.01" class="input-sys gmm-input-passport" placeholder="" style="${inputStyleFee}" value="${rawPassport ? formatNumNoZero(defPassport) : ''}" oninput="onGmmRowFeeChanged(this)" onfocus="this.select()" onkeydown="handleGmmRowKeydown(event, this)"></td>
                    <td style="padding: 1.5px 2px;"><input type="number" step="0.01" class="input-sys gmm-input-namelist" placeholder="" style="${inputStyleFee}" value="${rawNamelist ? formatNumNoZero(defNamelist) : ''}" oninput="onGmmRowFeeChanged(this)" onfocus="this.select()" onkeydown="handleGmmRowKeydown(event, this)"></td>
                    <td style="padding: 1.5px 2px;"><input type="number" step="0.01" class="input-sys gmm-input-visa" placeholder="" style="${inputStyleFee}" value="${rawVisa ? formatNumNoZero(defVisa) : ''}" oninput="onGmmRowFeeChanged(this)" onfocus="this.select()" onkeydown="handleGmmRowKeydown(event, this)"></td>
                    <td style="padding: 1.5px 2px;"><input type="number" step="0.01" class="input-sys gmm-input-missing-doc" placeholder="" style="${inputStyleFee}" value="${rawMissingDoc ? formatNumNoZero(defMissingDoc) : ''}" oninput="onGmmRowFeeChanged(this)" onfocus="this.select()" onkeydown="handleGmmRowKeydown(event, this)"></td>
                    <td style="padding: 1.5px 2px;"><input type="number" step="0.01" class="input-sys gmm-input-stamping" placeholder="" style="${inputStyleFee}" value="${rawStamping ? formatNumNoZero(defStamping) : ''}" oninput="onGmmRowFeeChanged(this)" onfocus="this.select()" onkeydown="handleGmmRowKeydown(event, this)"></td>
                    <td style="padding: 1.5px 2px;"><input type="number" step="0.01" class="input-sys gmm-input-usd" placeholder="" style="${inputStyleUsd}" value="${defUsd > 0 ? formatNumNoZero(defUsd) : ''}" oninput="calculateGmmTotal()" onfocus="this.select()" onkeydown="handleGmmRowKeydown(event, this)"></td>
                    <td style="text-align:center; padding: 1.5px 2px;">
                        <button type="button" class="btn-sys btn-rose" style="font-size:10.5px; padding:1px 6px; height:24px; min-height:24px; background:#dc2626; color:#ffffff; font-weight:bold; border-radius:4px; border:none; cursor:pointer; white-space:nowrap; display:inline-flex; align-items:center; justify-content:center; gap:2px; box-sizing:border-box;" onclick="removeGmmRow(this)">🗑️ លុប</button>
                    </td>
                `;
            } else if (currentGmmMode === 'visa') {
                const rawVisa = document.getElementById('gmmFeeVisa')?.value?.trim();
                const rawMonths = document.getElementById('gmmFeeMonths')?.value?.trim() || '';
                const rawWork = document.getElementById('gmmFeeWork')?.value?.trim();
                const rawVip = document.getElementById('gmmFeeVip')?.value?.trim();
                const rawFine = document.getElementById('gmmFeeFine')?.value?.trim();

                const defVisa = rawVisa ? parseFloat(rawVisa) : 0;
                const defWork = rawWork ? parseFloat(rawWork) : 0;
                const defVip = rawVip ? parseFloat(rawVip) : 0;
                const defFine = rawFine ? parseFloat(rawFine) : 0;
                const defUsd = (rawVisa || rawWork || rawVip || rawFine) ? (defVisa + defWork + defVip + defFine) : 0;

                tr.setAttribute('data-mode', 'visa');
                tr.innerHTML = `
                    <td style="text-align:center; font-weight:800; font-size:12.5px; color:#0284c7; padding: 1.5px 2px;" class="gmm-row-num">${currentCount + 1}</td>
                    <td style="text-align:center; vertical-align:middle; padding: 1.5px 2px;"><input type="checkbox" class="gmm-row-select" onchange="onGmmRowSelectionChange(this)" style="cursor:pointer; width:15px; height:15px; margin:0; accent-color:#0284c7;"></td>
                    <td style="padding: 1.5px 3px;"><input type="text" class="input-sys gmm-input-name" placeholder="ឈ្មោះសមាជិក" style="${inputStyleName}" value="" oninput="calculateGmmTotal()" onfocus="this.select()" onkeydown="handleGmmRowKeydown(event, this)" onpaste="handleGmmNamePaste(event, this)"></td>
                    <td style="text-align:center; vertical-align:middle; padding: 1.5px 2px;">${renderGmmPhotoCell('')}</td>
                    <td style="padding: 1.5px 2px;"><input type="number" step="0.01" class="input-sys gmm-input-visa" placeholder="" style="${inputStyleFee}" value="${rawVisa ? formatNumNoZero(defVisa) : ''}" oninput="onGmmRowFeeChanged(this)" onfocus="this.select()" onkeydown="handleGmmRowKeydown(event, this)"></td>
                    <td style="padding: 1.5px 2px;"><input type="text" class="input-sys gmm-input-months" placeholder="ឧ. 1ខែ" style="${inputStyleFee}; color:#0f172a;" value="${rawMonths}" onfocus="this.select()" onkeydown="handleGmmRowKeydown(event, this)"></td>
                    <td style="padding: 1.5px 2px;"><input type="number" step="0.01" class="input-sys gmm-input-permit" placeholder="" style="${inputStyleFee}" value="${rawWork ? formatNumNoZero(defWork) : ''}" oninput="onGmmRowFeeChanged(this)" onfocus="this.select()" onkeydown="handleGmmRowKeydown(event, this)"></td>
                    <td style="padding: 1.5px 2px;"><input type="number" step="0.01" class="input-sys gmm-input-vip" placeholder="" style="${inputStyleFee}" value="${rawVip ? formatNumNoZero(defVip) : ''}" oninput="onGmmRowFeeChanged(this)" onfocus="this.select()" onkeydown="handleGmmRowKeydown(event, this)"></td>
                    <td style="padding: 1.5px 2px;"><input type="number" step="0.01" class="input-sys gmm-input-fine" placeholder="" style="${inputStyleFee}" value="${rawFine ? formatNumNoZero(defFine) : ''}" oninput="onGmmRowFeeChanged(this)" onfocus="this.select()" onkeydown="handleGmmRowKeydown(event, this)"></td>
                    <td style="padding: 1.5px 2px;"><input type="number" step="0.01" class="input-sys gmm-input-usd" placeholder="" style="${inputStyleUsd}" value="${defUsd > 0 ? formatNumNoZero(defUsd) : ''}" oninput="calculateGmmTotal()" onfocus="this.select()" onkeydown="handleGmmRowKeydown(event, this)"></td>
                    <td style="text-align:center; vertical-align:middle; padding: 1.5px 2px;">
                        <label style="display:inline-flex; align-items:center; justify-content:center; gap:3px; cursor:pointer; user-select:none; font-size:10.5px; font-weight:800; background:#f8fafc; color:#64748b; border:1px solid #cbd5e1; padding:1px 5px; height:24px; border-radius:4px; transition:all 0.15s; white-space:nowrap; box-sizing:border-box;">
                            <input type="checkbox" class="gmm-input-visa-issued" onchange="onGmmVisaIssuedChange(this)" style="cursor:pointer; width:13px; height:13px; margin:0; accent-color:#10b981;">
                            <span class="visa-issued-label" style="white-space:nowrap;">⏳ រង់ចាំ</span>
                        </label>
                    </td>
                    <td style="text-align:center; padding: 1.5px 2px;">
                        <button type="button" class="btn-sys btn-rose" style="font-size:10.5px; padding:1px 6px; height:24px; min-height:24px; background:#dc2626; color:#ffffff; font-weight:bold; border-radius:4px; border:none; cursor:pointer; white-space:nowrap; display:inline-flex; align-items:center; justify-content:center; gap:2px; box-sizing:border-box;" onclick="removeGmmRow(this)">🗑️ លុប</button>
                    </td>
                `;
            } else {
                const rawVip = document.getElementById('gmmFeeVip')?.value?.trim();
                const rawClearance = document.getElementById('gmmFeeClearance')?.value?.trim();
                const rawCar = document.getElementById('gmmFeeCar')?.value?.trim();
                const rawFine = document.getElementById('gmmFeeFine')?.value?.trim();

                const defVip = rawVip ? parseFloat(rawVip) : 0;
                const defClearance = rawClearance ? parseFloat(rawClearance) : 0;
                const defCar = rawCar ? parseFloat(rawCar) : 0;
                const defFine = rawFine ? parseFloat(rawFine) : 0;
                const defUsd = (rawVip || rawClearance || rawCar || rawFine) ? (defVip + defClearance + defCar + defFine) : 0;

                tr.setAttribute('data-mode', 'line');
                tr.innerHTML = `
                    <td style="text-align:center; font-weight:800; font-size:12.5px; color:#0284c7; padding: 1.5px 2px;" class="gmm-row-num">${currentCount + 1}</td>
                    <td style="text-align:center; vertical-align:middle; padding: 1.5px 2px;"><input type="checkbox" class="gmm-row-select" onchange="onGmmRowSelectionChange(this)" style="cursor:pointer; width:15px; height:15px; margin:0; accent-color:#0284c7;"></td>
                    <td style="padding: 1.5px 3px;"><input type="text" class="input-sys gmm-input-name" placeholder="ឈ្មោះសមាជិក" style="${inputStyleName}" value="" oninput="calculateGmmTotal()" onfocus="this.select()" onkeydown="handleGmmRowKeydown(event, this)" onpaste="handleGmmNamePaste(event, this)"></td>
                    <td style="text-align:center; vertical-align:middle; padding: 1.5px 2px;">${renderGmmPhotoCell('')}</td>
                    <td style="padding: 1.5px 2px;"><input type="number" step="0.01" class="input-sys gmm-input-vip" placeholder="" style="${inputStyleFee}" value="${rawVip ? formatNumNoZero(defVip) : ''}" oninput="onGmmRowFeeChanged(this)" onfocus="this.select()" onkeydown="handleGmmRowKeydown(event, this)"></td>
                    <td style="padding: 1.5px 2px;"><input type="number" step="0.01" class="input-sys gmm-input-clearance" placeholder="" style="${inputStyleFee}" value="${rawClearance ? formatNumNoZero(defClearance) : ''}" oninput="onGmmRowFeeChanged(this)" onfocus="this.select()" onkeydown="handleGmmRowKeydown(event, this)"></td>
                    <td style="padding: 1.5px 2px;"><input type="number" step="0.01" class="input-sys gmm-input-car" placeholder="" style="${inputStyleFee}" value="${rawCar ? formatNumNoZero(defCar) : ''}" oninput="onGmmRowFeeChanged(this)" onfocus="this.select()" onkeydown="handleGmmRowKeydown(event, this)"></td>
                    <td style="padding: 1.5px 2px;"><input type="number" step="0.01" class="input-sys gmm-input-fine" placeholder="" style="${inputStyleFee}" value="${rawFine ? formatNumNoZero(defFine) : ''}" oninput="onGmmRowFeeChanged(this)" onfocus="this.select()" onkeydown="handleGmmRowKeydown(event, this)"></td>
                    <td style="padding: 1.5px 2px;"><input type="number" step="0.01" class="input-sys gmm-input-usd" placeholder="" style="${inputStyleUsd}" value="${defUsd > 0 ? formatNumNoZero(defUsd) : ''}" oninput="calculateGmmTotal()" onfocus="this.select()" onkeydown="handleGmmRowKeydown(event, this)"></td>
                    <td style="text-align:center; padding: 1.5px 2px;">
                        <button type="button" class="btn-sys btn-rose" style="font-size:10.5px; padding:1px 6px; height:24px; min-height:24px; background:#dc2626; color:#ffffff; font-weight:bold; border-radius:4px; border:none; cursor:pointer; white-space:nowrap; display:inline-flex; align-items:center; justify-content:center; gap:2px; box-sizing:border-box;" onclick="removeGmmRow(this)">🗑️ លុប</button>
                    </td>
                `;
            }

            tbody.appendChild(tr);
            calculateGmmTotal();
            updateGmmSelectionUI();
            setTimeout(() => {
                const nameInp = tr.querySelector('.gmm-input-name');
                if (nameInp) nameInp.focus();
            }, 10);
        }

        function removeGmmRow(btn) {
            const tr = btn.closest('tr');
            if (!tr) return;
            tr.remove();
            renumberGmmRows();
            calculateGmmTotal();
            updateGmmSelectionUI();
        }

        function renumberGmmRows() {
            const rows = document.querySelectorAll('#gmmMembersBody .gmm-row');
            rows.forEach((r, i) => {
                const numCell = r.querySelector('.gmm-row-num');
                if (numCell) numCell.textContent = i + 1;
            });
        }

        function saveGroupMembersChanges() {
            const editedReceiptNo = document.getElementById('gmmReceiptNo')?.value?.trim() || currentGmmReceiptNo;
            if (!editedReceiptNo) {
                alert('មិនស្គាល់លេខវិក្កយបត្រ!');
                return;
            }

            const senderInput = document.getElementById('gmmSenderName');
            const senderName = senderInput?.value?.trim() || '';
            if (!senderName) {
                alert('⚠️ សូមបញ្ចូលឈ្មោះអ្នកនាំ/បញ្ជូនជាមុនសិន ទើបអាចរក្សាទុកបាន!');
                if (senderInput) {
                    senderInput.focus();
                    senderInput.style.border = '2px solid #ef4444';
                    senderInput.style.boxShadow = '0 0 10px rgba(239, 68, 68, 0.4)';
                    setTimeout(() => {
                        senderInput.style.border = '1.5px solid #38bdf8';
                        senderInput.style.boxShadow = '';
                    }, 3500);
                }
                return;
            }

            const rawTravelDate = document.getElementById('gmmTravelDate')?.value || '';
            const travelDate = formatDisplayDate(rawTravelDate);
            const exchangeRate = parseFloat(document.getElementById('gmmExchangeRate')?.value || 33.90);
            const agencyCompany = document.getElementById('gmmAgencyCompany')?.value || '';

            const rows = document.querySelectorAll('#gmmMembersBody .gmm-row');
            const members = [];
            rows.forEach(r => {
                const name = r.querySelector('.gmm-input-name')?.value?.trim() || '';
                const passport = parseFloat(r.querySelector('.gmm-input-passport')?.value || 0);
                const namelist = parseFloat(r.querySelector('.gmm-input-namelist')?.value || 0);
                const missingDoc = parseFloat(r.querySelector('.gmm-input-missing-doc')?.value || 0);
                const stamping = parseFloat(r.querySelector('.gmm-input-stamping')?.value || 0);
                const evisa = parseFloat(r.querySelector('.gmm-input-evisa')?.value || 0);
                const vip = parseFloat(r.querySelector('.gmm-input-vip')?.value || 0);
                const clearance = parseFloat(r.querySelector('.gmm-input-clearance')?.value || 0);
                const permit = parseFloat(r.querySelector('.gmm-input-permit')?.value || 0);
                const car = parseFloat(r.querySelector('.gmm-input-car')?.value || 0);
                const visa = parseFloat(r.querySelector('.gmm-input-visa')?.value || 0);
                const months = r.querySelector('.gmm-input-months')?.value?.trim() || '';
                const fine = parseFloat(r.querySelector('.gmm-input-fine')?.value || 0);
                let usd = parseFloat(r.querySelector('.gmm-input-usd')?.value || 0);

                if (usd === 0) {
                    if (currentGmmMode === 'passport') {
                        usd = passport + namelist + visa + missingDoc + stamping;
                    } else if (currentGmmMode === 'visa') {
                        usd = visa + permit + vip + fine + evisa;
                    } else {
                        usd = vip + clearance + car + fine + evisa;
                    }
                }

                const isVisaIssued = r.querySelector('.gmm-input-visa-issued')?.checked || false;
                const photoData = r.querySelector('.gmm-input-photo')?.value || '';

                if (name || photoData || usd > 0 || passport > 0 || namelist > 0 || missingDoc > 0 || stamping > 0 || evisa > 0 || vip > 0 || clearance > 0 || permit > 0 || car > 0 || visa > 0 || fine > 0) {
                    const finalName = name || `Pax ${members.length + 1}`;
                    members.push({
                        full_english_name: finalName,
                        name: finalName,
                        photo: photoData,
                        photo_data: photoData,
                        passport_fee: passport,
                        namelist_fee: namelist,
                        missing_doc_fee: missingDoc,
                        visa_stamping_fee: stamping,
                        extension_months: months,
                        months: months,
                        visa_months: months,
                        e_visa: evisa,
                        vip: vip,
                        clearance_fee: clearance,
                        work_permit: permit,
                        car_fee: car,
                        visa_fee: visa,
                        overstay: fine,
                        fine_fee: fine,
                        usd: usd,
                        visa_issued: isVisaIssued,
                        visa_status: isVisaIssued ? 'issued' : 'pending'
                    });
                }
            });

            if (members.length === 0) {
                alert('⚠️ សូមបញ្ចូលឈ្មោះ ឬព័ត៌មានសមាជិកយ៉ាងហោចណាស់ 1 នាក់!');
                return;
            }

            pendingGmmSavePayload = {
                receipt_no: editedReceiptNo,
                exchange_rate: exchangeRate,
                members: members,
                travel_date: travelDate,
                sender_name: senderName,
                agency_company: agencyCompany
            };
            pendingSaveType = 'modal';

            let autoCategory = (typeof currentGmmMode !== 'undefined' && currentGmmMode) ? currentGmmMode : currentServiceCategory;
            if (!autoCategory || autoCategory === 'all') {
                if (currentModalReceiptData && currentModalReceiptData.service_category) {
                    autoCategory = currentModalReceiptData.service_category;
                } else if (currentModalReceiptData) {
                    autoCategory = isCarRecord(currentModalReceiptData) ? 'car' : (isPassportRecord(currentModalReceiptData) ? 'passport' : 'visa');
                } else {
                    autoCategory = (currentServiceCategory && currentServiceCategory !== 'all') ? currentServiceCategory : 'passport';
                }
            }
            if (autoCategory === 'line') autoCategory = 'car';
            executeGroupMembersModalSave(autoCategory || 'passport');
        }

        function executeGroupMembersModalSave(chosenCategory) {
            if (!pendingGmmSavePayload) return;
            pendingGmmSavePayload.service_category = chosenCategory;

            const btnSave = document.getElementById('btnGmmSave');
            if (btnSave) {
                btnSave.disabled = true;
                btnSave.textContent = '⏳ កំពុងរក្សាទុក...';
            }

            fetch('/api/update_members', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(pendingGmmSavePayload)
            })
            .then(r => r.json())
            .then(res => {
                if (btnSave) {
                    btnSave.disabled = false;
                    btnSave.textContent = '💾 កែប្រែ & រក្សាទុក (Update & Save)';
                }
                if (res.success) {
                    const catNameKh = chosenCategory === 'car' ? 'ផ្នែកឡាន (Car)' : (chosenCategory === 'passport' ? 'ផ្នែកប៉ាសស្ព័រ & ផ្សេងៗ (Passport)' : 'ផ្នែកវីសា (Visa)');
                    alert(`🎉 បានរក្សាទុកទិន្នន័យទៅក្នុង${catNameKh} បានជោគជ័យ!`);
                    pendingGmmSavePayload = null;
                    closeGroupMembersModal();
                    loadDatabaseRecords();
                } else {
                    alert('បរាជ័យក្នុងការរក្សាទុក៖ ' + (res.error || ''));
                }
            })
            .catch(err => {
                if (btnSave) {
                    btnSave.disabled = false;
                    btnSave.textContent = '💾 កែប្រែ & រក្សាទុក (Update & Save)';
                }
                alert('កំហុសក្នុងការផ្ញើទិន្នន័យ៖ ' + (err.message || err));
            });
        }

        function closeGroupMembersModal() {
            const modal = document.getElementById('groupMembersModal');
            if (modal) {
                modal.classList.remove('active');
                modal.style.display = 'none';
            }
        }

        function toggleStatus(rNo, newStatus, idx) {
            let url = `/api/toggle_status?no=${rNo}&status=${newStatus}`;
            if (idx !== undefined && idx !== null && idx !== '') {
                url += `&index=${idx}`;
            }
            fetch(url, { method: 'POST' })
                .then(r => r.json())
                .then(res => { if (res.success) loadDatabaseRecords(); });
        }

        function deleteRecord(rNo, recordId, originalIdx) {
            const rawNo = decodeURIComponent(rNo || '');
            const displayNo = (rawNo && rawNo !== 'N/A') ? rawNo : 'កំណត់ត្រានេះ';
            if (confirm(`តើអ្នកពិតជាចង់លុបទិន្នន័យ ${displayNo} នេះមែនទេ?`)) {
                let url = `/api/delete?no=${encodeURIComponent(rNo || '')}`;
                if (recordId !== undefined && recordId !== null && recordId !== '') {
                    url += `&id=${encodeURIComponent(recordId)}`;
                }
                if (originalIdx !== undefined && originalIdx !== null && originalIdx !== '') {
                    url += `&index=${originalIdx}`;
                }
                fetch(url, { method: 'POST' })
                    .then(r => r.json())
                    .then(res => { 
                        if (res.success) {
                            showToast("🗑️ បានលុបទិន្នន័យដោយជោគជ័យ!");
                            loadDatabaseRecords();
                        } else {
                            alert("មិនអាចលុបទិន្នន័យបានឡើយ៖ " + (res.error || "Receipt not found"));
                        }
                    })
                    .catch(err => {
                        alert("មិនអាចលុបបានឡើយ៖ " + err);
                    });
            }
        }

        function clearAllRecords() {
            if (confirm("⚠️ តើអ្នកពិតជាចង់លុបទិន្នន័យទាំងអស់ក្នុងប្រព័ន្ធមែនទេ?")) {
                fetch('/api/clear_all', { method: 'POST' })
                    .then(r => r.json())
                    .then(res => {
                        if (res.success) {
                            showToast("🗑️ បានលុបទិន្នន័យទាំងអស់រួចរាល់!");
                            loadDatabaseRecords();
                        } else {
                            alert("មិនអាចសម្អាតទិន្នន័យបានទេ៖ " + (res.error || "Error clearing records"));
                        }
                    })
                    .catch(err => {
                        alert("មិនអាចសម្អាតបានឡើយ៖ " + err);
                    });
            }
        }

        function resetSearch() {
            document.getElementById('searchInput').value = '';
            renderDatabaseTable();
        }

        function loadRecordIntoForm(rNoEnc, idx) {
            const item = getItemByRef(rNoEnc, idx);
            if (!item) return;

            currentEditingReceiptNo = decodeURIComponent(rNoEnc || '') || item.group_data?.receipt_no || item.customer?.receipt_no || item.receipt_no || '';
            const sender = item.group_info?.sender_name || item.group_data?.sender_name || item.group_info?.group_name || item.sender || item.customer_name || '';
            document.getElementById('senderName').value = sender;
            document.getElementById('travelDate').value = formatIsoDateForInput(item.group_info?.travel_date || item.group_data?.travel_date || item.group_data?.date_str || item.travel_date || '');
            document.getElementById('agencyCompany').value = item.group_info?.agency_company || item.group_data?.agency_company || item.agency_company || item.customer?.agency_company || '';

            let members = (item.members && item.members.length > 0) ? item.members : [];
            if (members.length === 0 && item.group_data?.items) {
                members = item.group_data.items.map(it => ({
                    full_english_name: it.name || it.description || '',
                    vip: it.vip,
                    clearance_fee: it.clearance_fee,
                    car_fee: it.car_fee,
                    work_permit: it.work_permit,
                    visa_fee: it.visa,
                    e_visa: it.e_visa,
                    overstay: it.overstay,
                    fine_fee: it.fine_fee || it.fine
                }));
            }

            let firstMemberName = (members.length > 0 ? (members[0].full_english_name || members[0].name) : (item.group_info?.customer_name || item.customer_name || '')) || '';
            firstMemberName = firstMemberName.replace(/^\d+[\.\)]\s*/, '').replace(/\s*\(\+\d+\s*នាក់\)/gi, '').trim();

            setCustNamePassportValue(firstMemberName);

            if (members.length > 0) {
                document.getElementById('paxInput').value = members.length;
                const countLbl = document.getElementById('paxCountLabel');
                if (countLbl) countLbl.textContent = members.length;

                const tbody = document.getElementById('groupMembersBody');
                if (tbody) {
                    tbody.innerHTML = '';
                    members.forEach((m, mIdx) => {
                        let cleanName = m.full_english_name || m.english_name || m.name || '';
                        cleanName = cleanName.replace(/^\d+[\.\)]\s*/, '').replace(/\s*\(\+\d+\s*នាក់\)/gi, '').trim();
                        addMemberRow(mIdx + 1, cleanName, m.passport_no || '');
                        // populate fees if available
                        const lastRow = tbody.lastElementChild;
                        if (lastRow) {
                            const vVisa = getFeeNum(m.visa_fee || m.visa);
                            const vEvisa = getFeeNum(m.e_visa || m.evisa);
                            const vVip = getFeeNum(m.vip);
                            const vCar = getFeeNum(m.car_fee || m.car);
                            const vClear = getFeeNum(m.clearance_fee || m.clearance);
                            const vWork = getFeeNum(m.work_permit || m.work);
                            const vFine = getFeeNum(m.overstay || m.fine_fee || m.fine);

                            if (vVisa > 0) lastRow.querySelector('.input-m-visa').value = vVisa;
                            if (vEvisa > 0) lastRow.querySelector('.input-m-evisa').value = vEvisa;
                            if (vVip > 0) lastRow.querySelector('.input-m-vip').value = vVip;
                            if (vCar > 0) lastRow.querySelector('.input-m-car').value = vCar;
                            if (vClear > 0) lastRow.querySelector('.input-m-clearance').value = vClear;
                            if (vWork > 0) lastRow.querySelector('.input-m-work').value = vWork;
                            if (vFine > 0) lastRow.querySelector('.input-m-fine').value = vFine;

                            calcMemberTotal(lastRow.querySelector('.input-m-vip') || lastRow.querySelector('.input-m-name'));
                        }
                    });
                }
            }
            window.scrollTo({ top: 0, behavior: 'smooth' });
            if (typeof showToast === 'function') {
                showToast(`✅ បាន Load ទិន្នន័យវិក្កយបត្រ ${decodeURIComponent(rNoEnc || '')} ចូលក្នុង Form (អ្នកអាចកែប្រែ រួចចុច រក្សាទុក ដើម្បី Update)!`);
            }
        }

        /* Passport Multi-File & Drag-and-Drop Batch AI OCR Scanner via Multipart FormData */
        function setupDropZone() {
            const dz = document.getElementById('dropZone');
            ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(ev => dz.addEventListener(ev, e => { e.preventDefault(); e.stopPropagation(); }));

            dz.addEventListener('drop', e => {
                let files = e.dataTransfer.files;
                if (files.length > 0) handleImageFiles(files);
            });
        }

        function handleImageFiles(filesList) {
            if (!filesList || filesList.length === 0) return;

            const files = Array.from(filesList);
            reader.onload = e => {
                document.getElementById('previewImage').src = e.target.result;
                document.getElementById('imagePreviewBox').style.display = 'block';
                document.getElementById('batchScanCountLabel').textContent = `✅ ស្កេនបានចំនួន ${files.length} រូបភាព Passport`;
            };
            reader.readAsDataURL(files[0]);

            // Construct FormData for 100% loss-less raw file upload
            let formData = new FormData();
            files.forEach(file => formData.append('images', file));

            fetch('/api/ocr_scan', {
                method: 'POST',
                body: formData
            })
            .then(r => r.json())
            .then(res => {
                document.getElementById('ocrSpinner').style.display = 'none';
                if (res.success && res.results && res.results.length > 0) {
                    processExtractedPassportResults(res.results);
                }
            })
            .catch(err => {
                document.getElementById('ocrSpinner').style.display = 'none';
                console.log("OCR Error:", err);
            });
        }

        function processExtractedPassportResults(results) {
            const tbody = document.getElementById('groupMembersBody');
            if (!tbody || !results || results.length === 0) return;

            tbody.innerHTML = '';

            const extractedNames = [];
            results.forEach((res, idx) => {
                let name = res.full_english_name || `PASSPORT CUSTOMER ${idx + 1}`;
                name = name.replace(/^\d+[\.\)]\s*/, '').replace(/\s*\(\+\d+\s*នាក់\)/gi, '').trim();
                const passNo = res.passport_no || '';

                addMemberRow(idx + 1, name, passNo);
                extractedNames.push(name);
            });

            if (results.length > 0) {
                const firstRes = results[0];
                const name = (firstRes.full_english_name || extractedNames[0] || '').replace(/^\d+[\.\)]\s*/, '').replace(/\s*\(\+\d+\s*នាក់\)/gi, '').trim();
                setCustNamePassportValue(name);
            }

            doUpdatePaxCount(tbody.children.length);
            document.getElementById('paxInput').value = tbody.children.length;
            calcTotals();
        }

        /* ==========================================================================
           Printable Receipt Modal & Sharing Controls
           ========================================================================== */
        function openReceiptModal(rNoEnc, idx) {
            const item = getItemByRef(rNoEnc, idx);
            if (!item) {
                alert('⚠️ មិនអាចស្វែងរកទិន្នន័យវិក្កយបត្រនេះបានទេ!');
                return;
            }
            currentModalReceiptData = item;

            const isGroup = item.group_info || item.group_data || (item.members && item.members.length > 0);
            const recNo = item.receipt_no || item.group_info?.receipt_no || item.group_data?.receipt_no || item.customer?.receipt_no || (item.passport_no ? ('🛂 ' + item.passport_no) : (decodeURIComponent(rNoEnc || '') || 'INV'));
            const status = (item.payment_status || 'UNPAID').toUpperCase();

            const mRec = document.getElementById('mReceiptNo');
            if (mRec) mRec.textContent = recNo;

            const sender = item.group_info?.sender_name || item.group_info?.group_name || item.group_data?.sender_name || item.sender_name || item.sender || item.customer?.full_english_name || '-';
            const mSender = document.getElementById('mSenderName');
            if (mSender) mSender.textContent = sender;

            const agency = item.group_info?.agency_company || item.group_data?.agency_company || item.agency_company || item.customer?.agency_company || '-';
            const mAgency = document.getElementById('mAgencyName');
            if (mAgency) mAgency.textContent = agency;

            const isVisa = isVisaRecord(item);
            const isPassport = isPassportRecord(item);
            const dateLabel = isVisa ? 'Visa Date:' : (isPassport ? 'Date:' : 'Travel Date:');
            const mDateLbl = document.getElementById('mReceiptDateLabel');
            if (mDateLbl) mDateLbl.textContent = dateLabel;

            const rawTravel = item.group_info?.travel_date || item.group_data?.travel_date || item.group_data?.date_str || item.travel_date || '-';
            const mTravel = document.getElementById('mTravelDate');
            if (mTravel) mTravel.textContent = formatDisplayDate(rawTravel);

            const mSaved = document.getElementById('mDateSaved');
            if (mSaved) mSaved.textContent = decodeURIComponent(item.date_saved || item.updated_at || '-');

            const rate = parseFloat(item.group_data?.exchange_rate || item.fees?.exchange_rate || item.exchange_rate || 33.90);
            const mRate = document.getElementById('mRate');
            if (mRate) mRate.textContent = `1 USD = ${rate.toFixed(2)} THB`;

            const members = item.members || [];
            let grandUSD = parseFloat(item.group_data?.totals?.usd || item.totals?.usd || 0);
            if ((!grandUSD || isNaN(grandUSD)) && members.length > 0) {
                grandUSD = members.reduce((sum, m) => {
                    const visa = parseFloat(m.visa_fee || m.visa || m.price || 0);
                    const evisa = parseFloat(m.e_visa || m.evisa || 0);
                    const vip = parseFloat(m.vip || 0);
                    const car = parseFloat(m.car_fee || m.car || 0);
                    const clear = parseFloat(m.clearance_fee || m.clearance || 0);
                    const work = parseFloat(m.work_permit || m.work || 0);
                    const pass = parseFloat(m.passport_fee || 0);
                    const nameFee = parseFloat(m.namelist_fee || 0);
                    const missFee = parseFloat(m.missing_doc_fee || m.doc_fee || 0);
                    const stampFee = parseFloat(m.visa_stamping_fee || m.stamping_fee || 0);
                    return sum + (parseFloat(m.usd) || (visa + evisa + vip + car + clear + work + pass + nameFee + missFee + stampFee));
                }, 0);
            }
            if ((!grandUSD || isNaN(grandUSD)) && item.fees) {
                const f = item.fees;
                grandUSD = (parseFloat(f.visa_fee || f.visa || 0) + parseFloat(f.e_visa || f.evisa || 0) + parseFloat(f.vip_fee || f.vip || 0) + parseFloat(f.car_fee || f.car || 0) + parseFloat(f.clearance_fee || f.clearance || 0) + parseFloat(f.work_permit || f.work || 0));
            }
            const grandTHB = parseFloat(item.group_data?.totals?.baht || item.totals?.baht || (isPassport ? grandUSD : (grandUSD * rate)));

            const mGUSD = document.getElementById('mGrandUSD');
            if (mGUSD) mGUSD.textContent = isPassport ? ('฿' + grandTHB.toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2})) : ('$' + grandUSD.toFixed(2));

            const mGTHB = document.getElementById('mGrandTHB');
            if (mGTHB) mGTHB.textContent = '฿' + grandTHB.toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2});

            const thead = document.getElementById('mReceiptItemsHead');
            const tbody = document.getElementById('mReceiptItemsBody');

            let membersList = (item.members && item.members.length > 0) ? item.members : [];
            if (membersList.length === 0 && item.group_data?.items) {
                membersList = item.group_data.items.map(it => ({
                    full_english_name: it.name || it.description || '',
                    vip: it.vip,
                    clearance_fee: it.clearance_fee,
                    car_fee: it.car_fee,
                    work_permit: it.work_permit,
                    visa_fee: it.visa,
                    e_visa: it.e_visa,
                    overstay: it.overstay,
                    fine_fee: it.fine_fee || it.fine,
                    passport_fee: it.passport_fee,
                    namelist_fee: it.namelist_fee,
                    missing_doc_fee: it.missing_doc_fee,
                    visa_stamping_fee: it.visa_stamping_fee,
                    usd: it.usd
                }));
            }

            if (membersList.length === 0) {
                const fees = item.fees || item;
                membersList = [{
                    full_english_name: item.passport_no || item.customer?.passport_no || item.customer_name || item.customer?.full_english_name || 'Guest',
                    visa_fee: fees.visa_fee || fees.visa || fees.price || 0,
                    e_visa: fees.e_visa || fees.evisa || 0,
                    vip: fees.vip_fee || fees.vip || 0,
                    car_fee: fees.car_fee || fees.car || 0,
                    clearance_fee: fees.clearance_fee || fees.clearance || 0,
                    work_permit: fees.work_permit || fees.work || 0,
                    fine_fee: fees.overstay || fees.fine || 0,
                    usd: item.totals?.usd || 0
                }];
            }

            // Check which fee columns have active non-zero values
            const hasVisa = membersList.some(m => getFeeNum(m.visa_fee || m.visa || m.price) > 0);
            const hasEvisa = membersList.some(m => getFeeNum(m.e_visa || m.evisa) > 0);
            const hasVip = membersList.some(m => getFeeNum(m.vip) > 0);
            const hasClear = membersList.some(m => getFeeNum(m.clearance_fee || m.clearance) > 0);
            const hasCar = membersList.some(m => getFeeNum(m.car_fee || m.car) > 0);
            const hasWork = membersList.some(m => getFeeNum(m.work_permit || m.work) > 0);
            const hasFine = membersList.some(m => getFeeNum(m.overstay || m.fine_fee || m.fine) > 0);
            const hasPassport = membersList.some(m => getFeeNum(m.passport_fee) > 0);
            const hasNamelist = membersList.some(m => getFeeNum(m.namelist_fee) > 0);
            const hasMissingDoc = membersList.some(m => getFeeNum(m.missing_doc_fee || m.doc_fee) > 0);
            const hasStamping = membersList.some(m => getFeeNum(m.visa_stamping_fee || m.stamping_fee) > 0);

            // Define dynamic active columns - only show columns that have values!
            const cols = [];
            if (isPassport) {
                if (hasPassport) cols.push({ key: 'passport', title: 'Passport', width: '65px' });
                if (hasNamelist) cols.push({ key: 'namelist', title: 'Namelist', width: '65px' });
                if (hasVisa) cols.push({ key: 'visa', title: 'Visa', width: '60px' });
                if (hasMissingDoc) cols.push({ key: 'missing_doc', title: 'Doc Fee', width: '65px' });
                if (hasStamping) cols.push({ key: 'stamping', title: 'Stamping', width: '65px' });
                if (cols.length === 0) cols.push({ key: 'passport', title: 'Passport', width: '65px' });
            } else if (isVisa) {
                if (hasVisa) cols.push({ key: 'visa', title: 'VISA', width: '60px' });
                if (hasEvisa) cols.push({ key: 'evisa', title: 'E-VISA', width: '65px' });
                if (hasVip) cols.push({ key: 'vip', title: 'VIP', width: '55px' });
                if (hasWork) cols.push({ key: 'work', title: 'Work', width: '60px' });
                if (hasFine) cols.push({ key: 'fine', title: 'Fine', width: '55px' });
                if (cols.length === 0) cols.push({ key: 'visa', title: 'VISA', width: '60px' });
            } else {
                if (hasVip) cols.push({ key: 'vip', title: 'VIP', width: '60px' });
                if (hasClear) cols.push({ key: 'clear', title: 'Clearance', width: '75px' });
                if (hasCar) cols.push({ key: 'car', title: 'Car Fee', width: '65px' });
                if (hasFine) cols.push({ key: 'fine', title: 'Fine', width: '55px' });
                if (cols.length === 0) cols.push({ key: 'car', title: 'Car Fee', width: '65px' });
            }

            const headerColor = isVisa ? 'linear-gradient(135deg, #4f46e5, #6366f1)' : 'linear-gradient(135deg, #0284c7, #0369a1)';
            const borderCol = isVisa ? '#4338ca' : '#0284c7';

            if (thead) {
                let ths = cols.map(c => `<th style="padding: 6px 4px; border: 1px solid ${borderCol}; width: ${c.width}; text-align: right; white-space: nowrap;">${c.title}</th>`).join('');
                thead.innerHTML = `
                    <tr style="background: ${headerColor}; color: #ffffff; font-size: 0.78rem;">
                        <th style="padding: 6px 3px; border: 1px solid ${borderCol}; width: 30px; text-align: center; white-space: nowrap;">No</th>
                        <th style="padding: 6px 8px; border: 1px solid ${borderCol}; text-align: left;">Customer Name</th>
                        ${ths}
                        <th style="padding: 6px 6px; border: 1px solid ${borderCol}; width: 70px; text-align: right; white-space: nowrap;">Total</th>
                    </tr>
                `;
            }

            let html = '';
            const fmtVal = v => {
                if (isPassport) return v > 0 ? ('฿' + (v % 1 === 0 ? v.toFixed(0) : v.toFixed(2))) : '-';
                return v > 0 ? ('$' + (v % 1 === 0 ? v.toFixed(0) : v.toFixed(2))) : '-';
            };
            const fmtTot = v => {
                if (isPassport) return '฿' + (v % 1 === 0 ? v.toFixed(0) : v.toFixed(2));
                return '$' + (v % 1 === 0 ? v.toFixed(0) : v.toFixed(2));
            };

            membersList.forEach((m, mIdx) => {
                const custDisplay = m.full_english_name || m.english_name || m.name || m.passport_no || `Pax #${mIdx + 1}`;
                const valMap = {
                    passport: getFeeNum(m.passport_fee),
                    namelist: getFeeNum(m.namelist_fee),
                    missing_doc: getFeeNum(m.missing_doc_fee || m.doc_fee),
                    stamping: getFeeNum(m.visa_stamping_fee || m.stamping_fee),
                    visa: getFeeNum(m.visa_fee || m.visa || m.price),
                    evisa: getFeeNum(m.e_visa || m.evisa),
                    vip: getFeeNum(m.vip),
                    clear: getFeeNum(m.clearance_fee || m.clearance),
                    car: getFeeNum(m.car_fee || m.car),
                    work: getFeeNum(m.work_permit || m.work),
                    fine: getFeeNum(m.overstay || m.fine_fee || m.fine)
                };

                const tot = getFeeNum(m.usd) || (valMap.passport + valMap.namelist + valMap.missing_doc + valMap.stamping + valMap.visa + valMap.evisa + valMap.vip + valMap.clear + valMap.car + valMap.work + valMap.fine);
                const totColor = isVisa ? '#4f46e5' : '#0284c7';

                let tds = cols.map(c => `<td style="padding:5px 4px; border:1px solid #cbd5e1; text-align:right; white-space:nowrap;">${fmtVal(valMap[c.key])}</td>`).join('');

                html += `
                    <tr style="border-bottom:1px solid #cbd5e1;">
                        <td style="padding:5px 3px; text-align:center; border:1px solid #cbd5e1;">${mIdx + 1}</td>
                        <td style="padding:5px 8px; border:1px solid #cbd5e1; font-weight:600;">${custDisplay}</td>
                        ${tds}
                        <td style="padding:5px 6px; border:1px solid #cbd5e1; text-align:right; font-weight:bold; color:${totColor}; white-space:nowrap;">${fmtTot(tot)}</td>
                    </tr>
                `;
            });

            if (tbody) tbody.innerHTML = html;

            const mPax = document.getElementById('mPaxCount');
            if (mPax) mPax.textContent = membersList.length + ' Pax';

            const modal = document.getElementById('receiptModal');
            if (modal) {
                modal.style.display = 'flex';
                modal.classList.add('active');
            }
        }

        function openShareAction(rNoEnc, idx) {
            openReceiptModal(rNoEnc, idx);
            if (typeof showToast === 'function') {
                showToast('🚀 កំពុងរៀបចំការចែករំលែកទៅកាន់ Telegram...', true);
            }
            setTimeout(() => {
                shareReceiptTelegram();
            }, 350);
        }

        function closeReceiptModal() {
            const modal = document.getElementById('receiptModal');
            if (modal) {
                modal.classList.remove('active');
                modal.style.display = 'none';
            }
        }

        function openReceiptInNewTab() {
            if (!currentModalReceiptData) return;
            const rNo = currentModalReceiptData.receipt_no || currentModalReceiptData.group_info?.receipt_no || currentModalReceiptData.group_data?.receipt_no || currentModalReceiptData.customer?.receipt_no || '';
            window.open('/view_receipt.html?no=' + encodeURIComponent(rNo), '_blank');
        }

        async function downloadReceiptPNG() {
            let tDate = document.getElementById('mTravelDate')?.textContent?.trim() || '';
            const rNo = document.getElementById('mReceiptNo')?.textContent?.trim() || 'Receipt';
            tDate = tDate.replace(/\//g, '-').replace(/[^a-zA-Z0-9\-]/g, '');
            if (!tDate || tDate === '-') {
                const today = new Date();
                const dd = String(today.getDate()).padStart(2, '0');
                const mm = String(today.getMonth() + 1).padStart(2, '0');
                const yyyy = today.getFullYear();
                tDate = `${dd}-${mm}-${yyyy}`;
            }

            const cleanRNo = rNo.replace(/[^a-zA-Z0-9_-]/g, '_').trim();
            const defaultFileName = `Receipt_${cleanRNo}_${tDate}.png`;

            const receiptEl = document.getElementById('printableReceiptArea');
            if (!receiptEl) return;

            // 1. Call showSaveFilePicker IMMEDIATELY while user click gesture is 100% active
            if ('showSaveFilePicker' in window) {
                let fileHandle = null;
                try {
                    fileHandle = await window.showSaveFilePicker({
                        suggestedName: defaultFileName,
                        types: [{
                            description: 'PNG Image (*.png)',
                            accept: { 'image/png': ['.png'] }
                        }]
                    });
                } catch (err) {
                    if (err.name === 'AbortError') {
                        // User cancelled the file picker dialog
                        return;
                    }
                    console.warn('showSaveFilePicker error:', err);
                }

                if (fileHandle) {
                    try {
                        const canvas = await html2canvas(receiptEl, { scale: 2, backgroundColor: '#ffffff', useCORS: true });
                        const blob = await new Promise(resolve => canvas.toBlob(resolve, 'image/png'));
                        const writable = await fileHandle.createWritable();
                        await writable.write(blob);
                        await writable.close();
                        if (typeof showToast === 'function') {
                            showToast('🎉 បានរក្សាទុករូបភាពវិក្កយបត្រដោយជោគជ័យ!');
                        }
                        return;
                    } catch (err) {
                        console.error('Error writing to fileHandle:', err);
                        alert('កំហុសក្នុងការសរសេរទិន្នន័យរូបភាព៖ ' + (err.message || err));
                        return;
                    }
                }
            }

            // 2. Fallback for older browsers & mobile
            try {
                const canvas = await html2canvas(receiptEl, { scale: 2, backgroundColor: '#ffffff', useCORS: true });
                const link = document.createElement('a');
                link.download = defaultFileName;
                link.href = canvas.toDataURL('image/png');
                link.click();
            } catch (err) {
                console.error("Error generating receipt PNG:", err);
                alert('កំហុសក្នុងការបង្កើតរូបភាព៖ ' + (err.message || err));
            }
        }

        function getTelegramShareUrl(textStr) {
            const encoded = typeof textStr === 'string' && (textStr.includes('%20') || textStr.includes('%0A')) ? textStr : encodeURIComponent(textStr);
            const isLocal = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1';
            if (!isLocal && window.location.protocol === 'https:') {
                return `tg://msg_url?url=${encodeURIComponent(window.location.href)}&text=${encoded}`;
            }
            return `tg://msg_url?text=${encoded}`;
        }

        async function shareReceiptTelegram() {
            const rNo = document.getElementById('mReceiptNo')?.textContent || 'INV';
            const sender = document.getElementById('mSenderName')?.textContent || '';
            const total = document.getElementById('mGrandUSD')?.textContent || '';
            const receiptEl = document.getElementById('printableReceiptArea');

            if (typeof showToast === 'function') {
                showToast('⏳ កំពុងរៀបចំរូបភាពវិក្កយបត្រ...', true);
            }

            if (receiptEl && typeof html2canvas !== 'undefined') {
                try {
                    const canvas = await html2canvas(receiptEl, { scale: 2, useCORS: true, backgroundColor: '#ffffff' });
                    const blob = await new Promise(resolve => canvas.toBlob(resolve, 'image/png'));

                    if (!blob) {
                        downloadAndOpenTgFallback(canvas, rNo, sender, total);
                        return;
                    }

                    const isMobileDevice = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);

                    // 1. Android & Mobile Native Share
                    if (isMobileDevice && navigator.share && navigator.canShare) {
                        try {
                            const file = new File([blob], `Receipt_${rNo.replace(/[^a-zA-Z0-9_-]/g, '_')}.png`, { type: 'image/png' });
                            if (navigator.canShare({ files: [file] })) {
                                await navigator.share({
                                    files: [file],
                                    title: `Receipt ${rNo}`,
                                    text: `🧾 VIP Border Receipt: ${rNo}\n👤 Customer/Group: ${sender}\n💰 Total: ${total}`
                                });
                                if (typeof showToast === 'function') showToast('✅ បាន Share វិក្កយបត្ររួចរាល់!');
                                return;
                            }
                        } catch (err) {
                            console.log('Mobile share canceled or rejected, using fallback:', err);
                        }
                    }

                    // 2. Desktop PC Clipboard Copy
                    if (!isMobileDevice && navigator.clipboard && window.ClipboardItem) {
                        try {
                            const item = new ClipboardItem({ 'image/png': blob });
                            await navigator.clipboard.write([item]);
                            alert(`🚀 បាន Copy រូបភាពវិក្កយបត្រ (${rNo}) ចូល Clipboard រួចរាល់!\n\nសូមចុច Ctrl + V ក្នុង Telegram Chat ដើម្បី Paste ផ្ញើរូបភាព!`);
                            window.location.href = 'tg://msg';
                            return;
                        } catch (err) {
                            console.warn('Clipboard write failed, using download fallback:', err);
                        }
                    }

                    // 3. Fallback for all devices
                    downloadAndOpenTgFallback(canvas, rNo, sender, total);
                } catch (err) {
                    console.error("html2canvas share error:", err);
                    downloadAndOpenTgFallback(null, rNo, sender, total);
                }
            } else {
                const text = `🧾 VIP Border Receipt: ${rNo}\n👤 Customer/Group: ${sender}\n💰 Total: ${total}\n🏢 Golden Mekong Commercial Service`;
                window.location.href = getTelegramShareUrl(text);
            }
        }

        function downloadAndOpenTgFallback(canvas, rNo, sender, total) {
            let tDate = document.getElementById('mTravelDate')?.textContent?.trim() || '';
            tDate = tDate.replace(/\//g, '-').replace(/[^a-zA-Z0-9\-]/g, '');
            if (!tDate || tDate === '-') {
                const today = new Date();
                const dd = String(today.getDate()).padStart(2, '0');
                const mm = String(today.getMonth() + 1).padStart(2, '0');
                const yyyy = today.getFullYear();
                tDate = `${dd}-${mm}-${yyyy}`;
            }
            if (canvas) {
                const link = document.createElement('a');
                link.download = `Receipt_${tDate}.png`;
                link.href = canvas.toDataURL('image/png');
                link.click();
            }
            alert(`📥 បានទាញយករូបភាពវិក្កយបត្រ (${tDate})!\n\nលោកអ្នកអាច Drag/Upload រូបភាព PNG នេះចូល Telegram Chat បាន!`);
            window.location.href = 'tg://msg';
        }

/* ==========================================================================
   Telegram Bot Live Auto-Sync & Global Paste (Ctrl+V) Integration
   ========================================================================== */
function showToast(message, isSuccess = true) {
    const container = document.getElementById('toastContainer');
    if (!container) return;
    const toast = document.createElement('div');
    toast.style.background = isSuccess ? '#064e3b' : '#7f1d1d';
    toast.style.color = '#ffffff';
    toast.style.border = `1.5px solid ${isSuccess ? '#10b981' : '#f87171'}`;
    toast.style.padding = '10px 16px';
    toast.style.borderRadius = '8px';
    toast.style.fontSize = '13px';
    toast.style.fontWeight = '600';
    toast.style.boxShadow = '0 4px 12px rgba(0,0,0,0.25)';
    toast.style.transition = 'all 0.3s ease';
    toast.style.pointerEvents = 'auto';
    toast.innerHTML = message;

    container.appendChild(toast);
    setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.transform = 'translateY(-10px)';
        setTimeout(() => toast.remove(), 300);
    }, 4500);
}

// Global Clipboard Paste Handler (Ctrl + V)
document.addEventListener('paste', function(e) {
    const items = (e.clipboardData || window.clipboardData)?.items;
    if (!items) return;
    const files = [];
    for (let item of items) {
        if (item.kind === 'file' && item.type.startsWith('image/')) {
            files.push(item.getAsFile());
        }
    }
    if (files.length > 0) {
        e.preventDefault();
        showToast('📋 បាន Paste រូបភាពប៉ាស្ព័រពី Clipboard! កំពុងដំណើរការ AI OCR...');
        handleImageFiles(files);
    }
});

// Telegram Bot Real-Time Polling & Status Sync
let lastTelegramScanId = null;

function pollTelegramScans() {
    fetch(`/api/latest_telegram_scans${lastTelegramScanId ? '?since=' + lastTelegramScanId : ''}`)
    .then(r => r.json())
    .then(res => {
        if (res.success && res.scans && res.scans.length > 0) {
            res.scans.forEach(scan => {
                lastTelegramScanId = scan.id;
                showToast(`📥 <b>បានទទួលប៉ាស្ព័រថ្មីពី Telegram!</b><br>👤 ឈ្មោះ: <b>${scan.customer_name}</b> (${scan.passport_no || 'N/A'})`);
                processExtractedPassportResults([{
                    full_english_name: scan.customer_name,
                    passport_no: scan.passport_no,
                    nationality: scan.nationality,
                    dob: scan.dob,
                    sex: scan.sex
                }]);
                if (typeof fetchSavedCustomers === 'function') {
                    fetchSavedCustomers();
                }
            });
        }
    })
    .catch(() => {});
}

function checkTelegramBotStatus() {
    fetch('/api/telegram_bot_status')
    .then(r => r.json())
    .then(res => {
        const badge = document.getElementById('tgBotStatusBadge');
        if (badge && res.success && res.status) {
            if (res.status.running) {
                badge.style.background = '#f0fdf4';
                badge.style.borderColor = '#16a34a';
                badge.style.color = '#15803d';
                badge.style.whiteSpace = 'nowrap';
                badge.style.flexShrink = '0';
                badge.innerHTML = `🟢 Telegram Bot Live`;
                badge.title = `@${res.status.bot_username || 'imvoi_passport_scanner_bot'} (Active)`;
            } else {
                badge.style.background = '#fef2f2';
                badge.style.borderColor = '#ef4444';
                badge.style.color = '#b91c1c';
                badge.style.whiteSpace = 'nowrap';
                badge.style.flexShrink = '0';
                badge.innerHTML = `🔴 Bot Offline`;
            }
        }
    })
    .catch(() => {});
}

// Global Clipboard Image Paste Listener for Group Members
document.addEventListener('paste', function(e) {
    const modal = document.getElementById('groupMembersModal');
    if (!modal || modal.style.display === 'none') return;
    const items = (e.clipboardData || e.originalEvent?.clipboardData)?.items;
    if (!items) return;
    for (let i = 0; i < items.length; i++) {
        if (items[i].type.indexOf('image') !== -1) {
            const blob = items[i].getAsFile();
            if (!blob) continue;
            const reader = new FileReader();
            reader.onload = function(evt) {
                const dataUrl = evt.target.result;
                const activeElem = document.activeElement;
                let targetTr = activeElem ? activeElem.closest('tr.gmm-row') : null;
                if (!targetTr) {
                    const emptyWrapper = Array.from(document.querySelectorAll('#gmmMembersBody .gmm-photo-wrapper')).find(w => !w.querySelector('.gmm-input-photo')?.value);
                    targetTr = emptyWrapper ? emptyWrapper.closest('tr') : document.querySelector('#gmmMembersBody tr.gmm-row:last-child');
                }
                if (targetTr) {
                    const wrapper = targetTr.querySelector('.gmm-photo-wrapper');
                    if (wrapper) {
                        wrapper.innerHTML = `
                            <img src="${dataUrl}" class="gmm-photo-thumb" style="width:26px; height:26px; object-fit:cover; border-radius:4px; border:1.5px solid #0284c7; cursor:pointer; box-shadow:0 1px 2px rgba(0,0,0,0.15);" onclick="openMemberPhotoPreview(this)" title="ចុចដើម្បីមើលរូបច្បាស់ HD / ទាញយក">
                            <input type="hidden" class="gmm-input-photo" value="${dataUrl.replace(/"/g, '&quot;')}">
                        `;
                    }
                }
            };
            reader.readAsDataURL(blob);
            break;
        }
    }
});

    
</script>

