        <div class="modal-card" style="max-width: 900px; width: 95%; background: #ffffff; border-radius: 12px; padding: 20px 24px; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.5);">
            <div class="modal-toolbar" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; padding-bottom: 12px; border-bottom: 1px solid #e2e8f0; flex-wrap: wrap; gap: 10px;">
                <div style="font-weight: 800; font-size: 16px; color: #0f172a; display: flex; align-items: center; gap: 6px;">📄 Official Receipt Preview</div>
                <div style="display: flex; gap: 10px; align-items: center; flex-wrap: nowrap;">
                    <button type="button" class="btn-sys" style="background: #4f46e5; color: #ffffff; padding: 7px 16px; border-radius: 6px; font-weight: 700; font-size: 13px; border: none; cursor: pointer; display: flex; align-items: center; gap: 6px;" onclick="window.print()">🖨️ បោះពុម្ព (Print)</button>
                    <button type="button" class="btn-sys" style="background: #059669; color: #ffffff; padding: 7px 16px; border-radius: 6px; font-weight: 700; font-size: 13px; border: none; cursor: pointer; display: flex; align-items: center; gap: 6px;" onclick="downloadReceiptPNG()">🖼️ PNG Image</button>
                    <button type="button" class="btn-sys" style="background: #8b5cf6; color: #ffffff; padding: 7px 16px; border-radius: 6px; font-weight: 700; font-size: 13px; border: none; cursor: pointer; display: flex; align-items: center; gap: 6px;" onclick="shareReceiptTelegram()">✈️ Telegram</button>
                    <button type="button" class="btn-sys" style="background: #ffffff; color: #0f172a; border: 1.5px solid #cbd5e1; padding: 7px 16px; border-radius: 6px; font-weight: 700; font-size: 13px; cursor: pointer; display: flex; align-items: center; gap: 6px; box-shadow: 0 1px 2px rgba(0,0,0,0.05);" onclick="closeReceiptModal()">❌ បិទ (Close)</button>
