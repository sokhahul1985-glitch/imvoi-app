<!DOCTYPE html>
<html lang="km">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI OCR Passport Scanner & VIP Border Service Receipt System</title>
    <style>
/* ==========================================================================
   CMP Golden Mekong Commercial Service - Exact Desktop App Web UI Replica
   ========================================================================== */

@import url('https://fonts.googleapis.com/css2?family=Kantumruy+Pro:wght@400;500;600;700&family=Noto+Sans+Khmer:wght@400;500;600;700&display=swap');

:root {
    --bg-main: #f8fafc;
    --bg-card: #ffffff;
    --bg-input: #ffffff;
    --border-color: #cbd5e1;
    --border-highlight: #2563eb;
    
    --text-main: #0f172a;
    --text-muted: #334155;
    --text-sub: #475569;

    --accent-indigo: #4f46e5;
    --accent-cyan: #0284c7;
    --accent-emerald: #059669;
    --accent-amber: #d97706;
    --accent-rose: #dc2626;
    --accent-purple: #7c3aed;

    --font-family: 'Kantumruy Pro', 'Noto Sans Khmer', system-ui, sans-serif;
}

html, body {
    height: 100vh;
    overflow: hidden;
}

body {
    background-color: var(--bg-main);
    color: var(--text-main);
    font-family: var(--font-family);
    font-size: 13.5px;
    padding: 8px;
    display: flex;
    flex-direction: column;
    gap: 6px;
}

/* Custom Scrollbar for Customer Database Table */
#dbTableContainer::-webkit-scrollbar {
    width: 9px;
    height: 9px;
}
#dbTableContainer::-webkit-scrollbar-track {
    background: #f1f5f9;
    border-radius: 4px;
}
#dbTableContainer::-webkit-scrollbar-thumb {
    background: #0284c7;
    border-radius: 4px;
}
#dbTableContainer::-webkit-scrollbar-thumb:hover {
    background: #0369a1;
}

#groupMembersTableContainer::-webkit-scrollbar {
    width: 7px;
    height: 7px;
}
#groupMembersTableContainer::-webkit-scrollbar-track {
    background: #f1f5f9;
    border-radius: 4px;
}
#groupMembersTableContainer::-webkit-scrollbar-thumb {
    background: #0284c7;
    border-radius: 4px;
}

/* App Header / Top Window Bar */
.app-topbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: #ffffff;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 10px 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
}

.topbar-title {
    font-size: 15px;
    font-weight: 800;
    color: #0f172a;
    display: flex;
    align-items: center;
    gap: 8px;
}

.status-badge {
    background: #e0f2fe;
    border: 1px solid #0284c7;
    color: #0369a1;
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 12.5px;
    font-weight: 700;
}

/* Main Splitter Layout */
.workspace-grid {
    display: grid;
    grid-template-columns: 380px 1fr;
    gap: 10px;
    margin-bottom: 10px;
    position: sticky;
    top: 0;
    z-index: 90;
}

@media (max-width: 1024px) {
    html, body {
        height: auto !important;
        min-height: 100vh !important;
        overflow-y: auto !important;
        overflow-x: hidden !important;
    }

    #mainWorkspaceContainer {
        height: auto !important;
        min-height: 100vh !important;
        overflow: visible !important;
    }

    .workspace-grid {
        grid-template-columns: 1fr !important;
        position: static !important;
        margin-bottom: 12px;
    }

    .dropzone-box {
        min-height: 120px !important;
        padding: 16px 10px !important;
    }

    #bottomDbPanel {
        flex: none !important;
        min-height: 450px !important;
        overflow: visible !important;
    }

    #dbTableContainer {
        max-height: 480px !important;
        -webkit-overflow-scrolling: touch;
    }

    #groupMembersTableContainer {
        max-height: 320px !important;
        -webkit-overflow-scrolling: touch;
    }

    #topUnifiedFormRow {
        flex-wrap: wrap !important;
        gap: 8px 6px !important;
    }

    /* Group Members Modal on Mobile - Large, spacious & easy to read/tap */
    #groupMembersModal .modal-card {
        width: 98% !important;
        max-width: 100% !important;
        padding: 6px 8px !important;
        border-radius: 12px !important;
    }

    #groupMembersModal .modal-toolbar {
        padding: 8px 10px !important;
    }

    #groupMembersModal .modal-toolbar input,
    #groupMembersModal .modal-toolbar select {
        height: 34px !important;
        font-size: 13px !important;
    }

    #groupMembersModal .table-container {
        max-height: 52vh !important;
        -webkit-overflow-scrolling: touch;
    }

    #groupMembersModal table.app-table {
        min-width: 820px !important;
    }

    #groupMembersModal table.app-table th {
        height: 38px !important;
        font-size: 13.5px !important;
        padding: 6px 6px !important;
    }

    #groupMembersModal table.app-table td {
        height: 44px !important;
        padding: 4px 4px !important;
    }

    #groupMembersModal .gmm-row {
        height: 44px !important;
    }

    #groupMembersModal .gmm-input-name {
        height: 40px !important;
        font-size: 15px !important;
        font-weight: 800 !important;
        min-width: 230px !important;
        padding: 4px 10px !important;
        border: 1.5px solid #64748b !important;
        border-radius: 6px !important;
    }

    #groupMembersModal .input-sys,
    #groupMembersModal input[type="number"],
    #groupMembersModal .gmm-input-months {
        height: 40px !important;
        font-size: 14.5px !important;
        font-weight: 800 !important;
        border-radius: 6px !important;
    }

    #groupMembersModal .gmm-row-select,
    #groupMembersModal #gmmSelectAll {
        width: 22px !important;
        height: 22px !important;
    }

    #groupMembersModal .gmm-row-num {
        font-size: 14px !important;
        font-weight: 800 !important;
    }

    #groupMembersModal .btn-sys {
        min-height: 40px !important;
        font-size: 13.5px !important;
        padding: 8px 14px !important;
    }

    #groupMembersModal .gmm-photo-thumb {
        width: 36px !important;
        height: 36px !important;
    }

    /* Official Receipt Modal on Mobile */
    #receiptModal .modal-card {
        width: 98% !important;
        max-width: 100% !important;
        padding: 10px 8px !important;
    }

    #receiptModal .modal-toolbar {
        padding: 6px 4px !important;
        gap: 6px !important;
        flex-wrap: wrap !important;
    }

    #receiptModal .modal-toolbar .btn-sys {
        padding: 6px 10px !important;
        font-size: 12px !important;
        min-height: 32px !important;
    }

    .receipt-paper-wrapper {
        justify-content: flex-start !important;
        padding: 8px 4px !important;
    }
}

/* Cards & Panel Boxes */
.panel-box {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    padding: 14px;
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -2px rgba(0, 0, 0, 0.05);
}

.panel-title {
    font-size: 15px;
    font-weight: 800;
    color: #1e3a8a;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 6px;
    letter-spacing: 0.3px;
}

/* Left Panel Scanner Dropzone */
.dropzone-box {
    border: 2px dashed #94a3b8;
    border-radius: 10px;
    background: #f8fafc;
    padding: 30px 14px;
    text-align: center;
    color: #475569;
    min-height: 240px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    flex: 1;
}

.dropzone-box:hover {
    border-color: var(--accent-indigo);
    background: #f1f5f9;
}

.scanner-btn-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-top: 10px;
}

/* Inputs & Form Controls */
.form-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 8px;
    margin-bottom: 8px;
}

.form-group-sm {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.form-group-sm label {
    font-size: 13.5px;
    font-weight: 700;
    color: #0f172a;
}

.form-input {
    background: var(--bg-input);
    border: 1px solid #94a3b8;
    border-radius: 6px;
    padding: 7px 10px;
    color: #0f172a;
    font-family: inherit;
    font-size: 13.5px;
    font-weight: 700;
    width: 100%;
}

.form-input::placeholder {
    color: #64748b;
    opacity: 0.85;
    font-size: 12.5px;
    font-weight: 500;
}

/* Hide spinbox up/down arrows on number inputs */
input[type="number"]::-webkit-outer-spin-button,
input[type="number"]::-webkit-inner-spin-button {
    -webkit-appearance: none !important;
    -moz-appearance: none !important;
    appearance: none !important;
    display: none !important;
    margin: 0 !important;
}
input[type="number"] {
    -webkit-appearance: textfield !important;
    -moz-appearance: textfield !important;
    appearance: textfield !important;
}

input[type="date"] {
    color-scheme: light;
    cursor: pointer;
}

.form-input:focus {
    outline: none;
    border-color: var(--accent-indigo);
    background: #ffffff;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
}

.form-input.highlight-input {
    color: #0284c7;
    font-weight: 800;
    border-color: #0284c7;
    background: #f0f9ff;
}

/* Control Row with Save Button */
.control-bar {
    background: #f1f5f9;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 8px 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 10px 0;
    flex-wrap: wrap;
    gap: 8px;
}

.save-btn-green {
    width: 100%;
    background: linear-gradient(90deg, #059669 0%, #10b981 100%);
    color: #ffffff;
    font-size: 15px;
    font-weight: 800;
    line-height: 1.4;
    padding: 12px 20px;
    min-height: 44px;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: all 0.2s ease;
    margin-bottom: 10px;
    white-space: nowrap;
}

.save-btn-green:hover {
    background: linear-gradient(90deg, #047857 0%, #059669 100%);
    transform: translateY(-1px);
}

/* Custom Web Tables */
.table-container {
    overflow-x: auto;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    background: #ffffff;
}

.app-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
}

.app-table th {
    position: sticky;
    top: 0;
    z-index: 10;
    background: #f1f5f9;
    color: #0f172a;
    font-weight: 800;
    font-size: 13px;
    padding: 9px 12px;
    border: 1px solid var(--border-color);
    text-align: left;
    white-space: nowrap;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
}

.app-table td {
    padding: 8px 10px;
    border: 1px solid #e2e8f0;
    background: #ffffff;
    color: #0f172a;
    font-weight: 600;
    font-size: 13px;
}

.app-table tr:hover td {
    background: #f8fafc;
}

/* Group Members Modal Table Styling */
#groupMembersModal .table-container {
    max-height: 480px;
    overflow-x: auto;
    overflow-y: auto;
    border: 1.5px solid #cbd5e1;
    border-radius: 8px;
    background: #ffffff;
    -webkit-overflow-scrolling: touch;
}

#groupMembersModal table.app-table {
    width: 100%;
    min-width: 820px;
    border-collapse: collapse !important;
    border-spacing: 0 !important;
}

#groupMembersModal table.app-table th {
    padding: 6px 5px !important;
    font-size: 13px !important;
    line-height: 1.2 !important;
    white-space: nowrap !important;
    vertical-align: middle !important;
    background: #e2e8f0 !important;
    border: 1px solid #cbd5e1 !important;
    height: 32px !important;
    font-weight: 800 !important;
}

#groupMembersModal table.app-table td {
    padding: 2px 3px !important;
    border: 1px solid #e2e8f0 !important;
    vertical-align: middle !important;
    height: 32px !important;
}

#groupMembersModal .gmm-row {
    height: 32px !important;
}

#groupMembersModal .gmm-row:hover td {
    background: #f1f5f9 !important;
}

/* Action Buttons */
.btn-sys {
    padding: 8px 14px;
    border-radius: 6px;
    font-size: 13.5px;
    font-weight: 700;
    line-height: 1.4;
    min-height: 36px;
    white-space: nowrap;
    cursor: pointer;
    border: 1px solid transparent;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    color: #fff;
    transition: all 0.15s ease;
}

.btn-indigo { background: linear-gradient(90deg, #4f46e5, #6366f1); }
.btn-emerald { background: linear-gradient(90deg, #059669, #10b981); }
.btn-amber { background: linear-gradient(90deg, #d97706, #f59e0b); }
.btn-rose { background: linear-gradient(90deg, #e11d48, #f43f5e); }
.btn-cyan { background: linear-gradient(90deg, #0284c7, #38bdf8); color: #ffffff; font-weight: 700; }
.btn-purple { background: linear-gradient(90deg, #7c3aed, #8b5cf6); }
.btn-dark { background: #f1f5f9; border-color: #cbd5e1; color: #0f172a; font-weight: 700; }

.btn-sys:hover { opacity: 0.9; transform: translateY(-1px); }

.btn-action-sm {
    padding: 6px 12px;
    font-size: 12.5px;
    font-weight: 700;
    line-height: 1.4;
    min-height: 32px;
    white-space: nowrap;
    border-radius: 5px;
}

/* Badges */
.badge-status {
    padding: 6px 12px;
    border-radius: 5px;
    font-size: 12.5px;
    font-weight: 700;
    line-height: 1.4;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    cursor: pointer;
    min-height: 30px;
}

.badge-paid-st { background: #dcfce7; color: #15803d; border: 1px solid #16a34a; font-weight: 800; }
.badge-unpaid-st { background: #ffe4e6; color: #be123c; border: 1px solid #f43f5e; font-weight: 800; }

/* Modal Printable Receipt Popup */
.modal-overlay {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    bottom: 0 !important;
    width: 100vw !important;
    height: 100vh !important;
    background: rgba(15, 23, 42, 0.85) !important;
    backdrop-filter: blur(6px) !important;
    -webkit-backdrop-filter: blur(6px) !important;
    display: none !important;
    align-items: center !important;
    justify-content: center !important;
    z-index: 999999 !important;
    padding: 20px !important;
    box-sizing: border-box !important;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
}

.modal-overlay.active {
    display: flex !important;
    opacity: 1 !important;
    pointer-events: auto !important;
}

.modal-card {
    background: #ffffff;
    color: #0f172a;
    width: 100%;
    max-width: 860px;
    max-height: 90vh;
    overflow-y: auto;
    border-radius: 12px;
    padding: 28px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    position: relative;
    font-family: 'Kantumruy Pro', 'Noto Sans Khmer', sans-serif;
}

.modal-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid #e2e8f0;
}

@media print {
    body { background: #fff !important; color: #000 !important; padding: 0 !important; }
    .app-topbar, .workspace-grid, .panel-box, .modal-toolbar { display: none !important; }
    .modal-overlay { position: static !important; background: none !important; opacity: 1 !important; pointer-events: auto !important; }
    .modal-card { box-shadow: none !important; max-width: 100% !important; padding: 0 !important; }
}

/* Official Golden Mekong CMP Invoice Exact Layout Styles */
.cmp-receipt-paper, #printableReceiptArea {
    background: #ffffff !important;
    color: #000000 !important;
    width: 720px !important;
    min-width: 720px !important;
    max-width: 720px !important;
    margin: 0 auto !important;
    padding: 36px 42px !important;
    border-radius: 8px !important;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2) !important;
    font-family: 'Kantumruy Pro', 'Noto Sans Khmer', Arial, sans-serif !important;
    position: relative !important;
    box-sizing: border-box !important;
}

.receipt-paper-wrapper {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    padding: 10px 4px;
    display: flex;
    justify-content: center;
    background: #e2e8f0;
    border-radius: 8px;
    box-sizing: border-box;
}


.cmp-header-grid {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
}

.cmp-logo-box {
    width: 85px;
    height: 85px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.cmp-logo-box img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
}

.cmp-header-center {
    flex: 1;
    text-align: center;
    padding: 0 10px;
}

.cmp-company-th {
    font-size: 1.2rem;
    font-weight: 700;
    color: #0a52be;
    line-height: 1.2;
    margin-bottom: 3px;
}

.cmp-addr-line {
    font-size: 0.8rem;
    color: #475569;
    line-height: 1.3;
}

.cmp-title-invoice {
    font-size: 1.35rem;
    font-weight: 800;
    color: #0f172a;
    text-decoration: underline;
    margin-top: 6px;
    letter-spacing: 1px;
}

.cmp-sub-grid {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-top: 10px;
    margin-bottom: 12px;
    font-size: 0.85rem;
    color: #000000;
    line-height: 1.4;
}

.cmp-sub-left {
    text-align: left;
}

.cmp-sub-right {
    text-align: right;
    font-weight: 500;
}

.cmp-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 12px;
}

.cmp-table th {
    background-color: #f1f5f9;
    color: #000000;
    border: 1px solid #000000;
    padding: 4px 3px;
    font-size: 0.72rem;
    font-weight: 700;
    text-align: center;
    vertical-align: middle;
    line-height: 1.15;
}

.cmp-table td {
    border: 1px solid #000000;
    padding: 2px 4px;
    font-size: 0.75rem;
    color: #000000;
    height: 20px;
    vertical-align: middle;
}

.cmp-table tr.summary-row td {
    height: 24px;
    font-size: 0.8rem;
}

.cmp-bg-blue {
    background-color: #bfdbfe !important;
}

.cmp-bg-grey {
    background-color: #e2e8f0 !important;
}

.cmp-footer-grid {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-top: 14px;
    font-size: 0.82rem;
    color: #000000;
    line-height: 1.35;
}

.cmp-footer-left {
    text-align: left;
}

.cmp-footer-right {
    text-align: right;
}

.stamp-badge-absolute {
    position: absolute;
    top: 25px;
    right: 25px;
    z-index: 10;
}

.stamp-paid {
    display: inline-block;
    border: 3px solid #10b981;
    color: #10b981;
    font-size: 1.2rem;
    font-weight: 800;
    padding: 3px 12px;
    border-radius: 6px;
    transform: rotate(-5deg);
    letter-spacing: 1px;
}

.stamp-unpaid {
    display: inline-block;
    border: 3px solid #ef4444;
    color: #ef4444;
    font-size: 1.2rem;
    font-weight: 800;
    padding: 3px 12px;
    border-radius: 6px;
    transform: rotate(-5deg);
    letter-spacing: 1px;
}



        /* Ultra-Luxury VIP Transfers Poster Card Styling (Exact Match) */
        .vip-poster-card-luxury {
            width: 100%;
            max-width: 520px;
            margin: 0 auto;
            background: linear-gradient(180deg, #070d1d 0%, #050811 100%);
            border: 2px solid #00d2ff;
            border-radius: 24px;
            padding: 24px 20px 20px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.8), 0 0 35px rgba(0, 210, 255, 0.35);
            color: #ffffff;
            font-family: 'Montserrat', 'Noto Sans Khmer', sans-serif;
            position: relative;
            box-sizing: border-box;
        }

        .vip-poster-top-header {
            text-align: center;
            margin-bottom: 14px;
        }

        .vip-crown-img {
            width: 68px;
            height: auto;
            margin-bottom: 6px;
            filter: drop-shadow(0 4px 12px rgba(251, 191, 36, 0.6));
        }

        .vip-gold-sub-title {
            font-family: 'Cinzel', serif;
            font-size: 20px;
            font-weight: 900;
            color: #fbbf24;
            letter-spacing: 2px;
            margin-bottom: 2px;
            text-shadow: 0 2px 10px rgba(251, 191, 36, 0.5);
        }

        .vip-sub-text-gold {
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 2.5px;
            color: #fde047;
            text-transform: uppercase;
            margin-bottom: 8px;
        }

        .vip-main-headline {
            font-family: 'Playfair Display', 'Cinzel', serif;
            font-size: 24px;
            font-weight: 900;
            letter-spacing: 1px;
            color: #ffffff;
            text-shadow: 0 0 15px rgba(255, 255, 255, 0.4), 0 2px 8px rgba(0, 0, 0, 0.8);
