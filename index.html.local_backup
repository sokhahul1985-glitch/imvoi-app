        /* Top Unified Form Row Responsive Styling */
        #topUnifiedFormRow {
            display: flex;
            gap: 6px;
            align-items: flex-end;
            flex-wrap: nowrap;
            width: 100%;
        }

        /* Service Category Selection Portal Styles */
        #categorySelectionScreen {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            z-index: 100000;
            background: radial-gradient(circle at 50% 25%, #1e293b 0%, #0f172a 65%, #020617 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            box-sizing: border-box;
            overflow-y: auto;
            font-family: var(--font-family);
        }

        .portal-container {
            max-width: 1080px;
            width: 100%;
            text-align: center;
            animation: portalFadeIn 0.35s cubic-bezier(0.16, 1, 0.3, 1);
            margin: auto;
        }

        @keyframes portalFadeIn {
            from { opacity: 0; transform: translateY(18px) scale(0.97); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }

        .portal-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(2, 132, 199, 0.18);
            border: 1.5px solid rgba(56, 189, 248, 0.45);
