            <!-- Receipt Document Content -->
            <div id="printableReceiptArea" style="background: #ffffff; color: #0f172a; padding: 40px 48px; border-radius: 12px; box-sizing: border-box; width: 100%; max-width: 850px; margin: 0 auto;">
                <div style="border-bottom: 2px double #cbd5e1; padding-bottom: 12px; margin-bottom: 16px; display: flex; justify-content: space-between;">

                    <div>
                        <div style="font-size: 0.85rem; font-weight: 700; color: #0284c7;">ក្រុមហ៊ុន ហ្គោលដិន មេគង្គ ខមមើសល សឺវីស</div>
                        <div style="font-size: 0.92rem; font-weight: 700; color: #0f172a;">GOLDEN MEKONG COMMERCIAL SERVICE CO., LTD.</div>

                        <div style="font-size: 0.75rem; color: #475569; margin-top: 4px;">
                            📍 ចំការដូង ខណ្ឌដង្កោ រាជធានីភ្នំពេញ (Chamkar Dong, Dangkao, Phnom Penh)<br>
                            📞 Tel: 0888022656 / 081662083
                        </div>

