<!-- Tail Scripts for VIP Poster Studio Interactivity & Sync -->
    <script>
        // Active Quotation Category State
        window.currentQuoteCategory = 'car';

        function getActivePosterCard() {
            const cat = window.currentQuoteCategory || 'car';
            if (cat === 'vip') return document.getElementById('posterCard_vip');
            if (cat === 'visa') return document.getElementById('posterCard_visa');
            return document.getElementById('posterCard_car');
        }

        window.selectQuoteCategoryTab = function(cat, switchView) {
            window.currentQuoteCategory = cat || 'car';
            const cur = window.currentQuoteCategory;
            try { localStorage.setItem('activeQuoteCategoryTab', cur); } catch(e){}

            if (switchView) {
                const portal = document.getElementById('categorySelectionScreen');
                const ws = document.getElementById('mainWorkspaceContainer');
                const quoteStudio = document.getElementById('quoteStudioContainer');
                const grid = document.getElementById('workspaceGrid');
                const bottomDb = document.getElementById('bottomDbPanel');

                if (portal) portal.style.display = 'none';
                if (ws) ws.style.display = 'flex';
                if (quoteStudio) quoteStudio.style.display = 'flex';
                if (grid) grid.style.display = 'none';
                if (bottomDb) bottomDb.style.display = 'none';
                try { sessionStorage.setItem('imvoi_selected_service', 'quote'); } catch(e){}
            }

            const btnCar = document.getElementById('btnTabQuoteCar');
            const btnVip = document.getElementById('btnTabQuoteVip');
            const btnVisa = document.getElementById('btnTabQuoteVisa');

            const postCar = document.getElementById('posterCard_car');
            const postVip = document.getElementById('posterCard_vip');
            const postVisa = document.getElementById('posterCard_visa');

            const hCol1 = document.getElementById('histHeaderCol1');
            const hCol2 = document.getElementById('histHeaderCol2');

            const resetBtn = function(btn) {
                if (btn) {
                    btn.style.background = '#ffffff';
                    btn.style.color = '#334155';
                    btn.style.border = '1.5px solid #cbd5e1';
                    btn.style.boxShadow = 'none';
                    btn.style.fontWeight = '800';
                }
            };
            const activeBtn = function(btn, borderColor, glowColor) {
                if (btn) {
                    btn.style.background = 'linear-gradient(135deg, #1e293b, #0f172a)';
                    btn.style.color = '#fbbf24';
                    btn.style.border = '2px solid ' + borderColor;
                    btn.style.boxShadow = '0 4px 16px ' + glowColor;
                    btn.style.fontWeight = '900';
                }
            };

            resetBtn(btnCar);
            resetBtn(btnVip);
            resetBtn(btnVisa);

            if (postCar) postCar.style.display = 'none';
            if (postVip) postVip.style.display = 'none';
            if (postVisa) postVisa.style.display = 'none';

            if (cur === 'car') {
                activeBtn(btnCar, '#f59e0b', 'rgba(245, 158, 11, 0.4)');
                if (postCar) postCar.style.display = 'block';
                if (hCol1) hCol1.textContent = 'ភ្នំពេញ ⇄ ប៉ោយប៉ែត';
                if (hCol2) hCol2.textContent = 'សៀមរាប ⇄ ប៉ោយប៉ែត';
            } else if (cur === 'vip') {
                activeBtn(btnVip, '#ec4899', 'rgba(236, 72, 153, 0.4)');
                if (postVip) postVip.style.display = 'block';
                if (hCol1) hCol1.textContent = 'ភ្នំពេញ (PNH VIP)';
                if (hCol2) hCol2.textContent = 'សៀមរាប (SAI VIP)';
            } else if (cur === 'visa') {
                activeBtn(btnVisa, '#10b981', 'rgba(16, 185, 129, 0.4)');
                if (postVisa) postVisa.style.display = 'block';
                if (hCol1) hCol1.textContent = 'Tourist & Biz Visa';
                if (hCol2) hCol2.textContent = 'Visa Extension';
            }

            // Highlight corresponding section in settings modal
            const mSecCar = document.getElementById('modalSec_car');
            const mSecVip = document.getElementById('modalSec_vip');
            const mSecVisa = document.getElementById('modalSec_visa');
            if (mSecCar) mSecCar.style.display = (cur === 'car') ? 'flex' : 'none';
            if (mSecVip) mSecVip.style.display = (cur === 'vip') ? 'flex' : 'none';
            if (mSecVisa) mSecVisa.style.display = (cur === 'visa') ? 'flex' : 'none';

            try { syncAllQuotePrices(); } catch(e){}
            try { renderPriceHistoryTable(); } catch(e){}
        };

        function openQuoteSettingsModal() {
            const m = document.getElementById('quoteSettingsModal');
            if (m) {
                m.style.display = 'flex';
                loadLatestPricesFromStorage();
                const cur = window.currentQuoteCategory || 'car';
                const mSecCar = document.getElementById('modalSec_car');
                const mSecVip = document.getElementById('modalSec_vip');
                const mSecVisa = document.getElementById('modalSec_visa');
                if (mSecCar) mSecCar.style.display = (cur === 'car') ? 'flex' : 'none';
                if (mSecVip) mSecVip.style.display = (cur === 'vip') ? 'flex' : 'none';
                if (mSecVisa) mSecVisa.style.display = (cur === 'visa') ? 'flex' : 'none';
            }
        }

        function closeQuoteSettingsModal(shouldLog = false) {
            const m = document.getElementById('quoteSettingsModal');
            if (m) m.style.display = 'none';
            if (shouldLog) {
                recordCurrentPriceLog();
            }
        }

        // Real-time synchronization of prices between modal and all 3 poster designs
        function syncAllQuotePrices() {
            const formatD = function(val) {
                if (!val) return '$0';
                let s = String(val).trim();
                if (!s.startsWith('$')) s = '$' + s;
                return s;
            };

            const syncVal = function(cfgId, dspId) {
                const cfg = document.getElementById(cfgId);
                const dsp = document.getElementById(dspId);
                if (cfg && dsp) {
                    const formatted = formatD(cfg.value);
                    dsp.textContent = formatted;
                }
            };

            // 1. Sync Car Transfers
            syncVal('cfgPpSuv', 'dspPpSuv');
            syncVal('cfgPpAlphard', 'dspPpAlphard');
            syncVal('cfgPpHiace', 'dspPpHiace');
            syncVal('cfgSrSuv', 'dspSrSuv');
            syncVal('cfgSrAlphard', 'dspSrAlphard');
            syncVal('cfgSrHiace', 'dspSrHiace');

            // 2. Sync VIP Fast Track
            syncVal('cfgVipPpIn', 'dspVipPpIn');
            syncVal('cfgVipPpVisaEb', 'dspVipPpVisaEb');
            syncVal('cfgVipPpOut', 'dspVipPpOut');
            syncVal('cfgVipPpEscort', 'dspVipPpEscort');
            syncVal('cfgVipSrIn', 'dspVipSrIn');
            syncVal('cfgVipSrVisaEb', 'dspVipSrVisaEb');
            syncVal('cfgVipSrOut', 'dspVipSrOut');
            syncVal('cfgVipSrEscort', 'dspVipSrEscort');

            // 3. Sync Visa Services
            syncVal('cfgVisaEb1M', 'dspVisaEb1M');
            syncVal('cfgVisaEb3M', 'dspVisaEb3M');
            syncVal('cfgVisaEb6M', 'dspVisaEb6M');
            syncVal('cfgVisaEb1Y', 'dspVisaEb1Y');
            syncVal('cfgVisaExt1M', 'dspVisaExt1M');
            syncVal('cfgVisaExt3M', 'dspVisaExt3M');
            syncVal('cfgVisaExt6M', 'dspVisaExt6M');
            syncVal('cfgVisaExt1Y', 'dspVisaExt1Y');

            initPosterQrCode();
            saveLatestPricesToStorage();
        }

        window.syncAllQuotePrices = syncAllQuotePrices;
        window.syncCustomizedPoster = syncAllQuotePrices;

        function saveLatestPricesToStorage() {
            const keys = [
                'cfgPpSuv', 'cfgPpAlphard', 'cfgPpHiace', 'cfgSrSuv', 'cfgSrAlphard', 'cfgSrHiace',
                'cfgVipPpIn', 'cfgVipPpVisaEb', 'cfgVipPpOut', 'cfgVipPpEscort',
                'cfgVipSrIn', 'cfgVipSrVisaEb', 'cfgVipSrOut', 'cfgVipSrEscort',
                'cfgVisaEb1M', 'cfgVisaEb3M', 'cfgVisaEb6M', 'cfgVisaEb1Y', 'cfgVisaExt1M', 'cfgVisaExt3M', 'cfgVisaExt6M', 'cfgVisaExt1Y',
                'cfgTgHandle'
            ];
            const data = {};
            keys.forEach(function(k) {
                const el = document.getElementById(k);
                if (el) data[k] = el.value;
            });
            try { localStorage.setItem('imvoi_latest_quote_prices', JSON.stringify(data)); } catch(e){}
        }

        function loadLatestPricesFromStorage() {
            try {
                const saved = localStorage.getItem('imvoi_latest_quote_prices');
                if (!saved) return;
                const data = JSON.parse(saved);
                Object.keys(data).forEach(function(k) {
                    const el = document.getElementById(k);
                    if (el) el.value = data[k];
                });
            } catch(e){}
        }

        // QR Code Generator (Initializes for all visible cards)
        function initPosterQrCode() {
            const boxes = document.querySelectorAll('.boxPosterQrCode');
            const tgTexts = document.querySelectorAll('.txtPosterTgHandle');
            const tg = document.getElementById('cfgTgHandle')?.value || '@SOKHALION';
            const cleanUser = tg.replace('@', '').trim();
            const qrUrl = `https://t.me/${cleanUser}`;

            tgTexts.forEach(function(el) { el.textContent = tg; });

            boxes.forEach(function(box) {
                box.innerHTML = '';
                if (typeof QRCode !== 'undefined') {
                    new QRCode(box, {
                        text: qrUrl,
                        width: 46,
                        height: 46,
                        colorDark: '#000000',
                        colorLight: '#ffffff',
                        correctLevel: QRCode.CorrectLevel.H
                    });
                } else {
                    const qrImg = document.createElement('img');
                    qrImg.src = `https://api.qrserver.com/v1/create-qr-code/?size=92x92&data=${encodeURIComponent(qrUrl)}`;
                    qrImg.style.width = '46px';
                    qrImg.style.height = '46px';
                    qrImg.style.display = 'block';
                    qrImg.style.borderRadius = '4px';
                    box.appendChild(qrImg);
                }
            });
        }

        // High Fidelity Poster Download & Copy Functions
        function downloadPosterImage() {
            const card = getActivePosterCard();
            if (!card) return;

            html2canvas(card, {
                scale: 3,
                useCORS: true,
                allowTaint: true,
                backgroundColor: '#071226',
                logging: false
            }).then(function(canvas) {
                const link = document.createElement('a');
                link.download = `VIP_${window.currentQuoteCategory.toUpperCase()}_Quotation_${Date.now()}.png`;
                link.href = canvas.toDataURL('image/png', 1.0);
                link.click();
            }).catch(function(err) {
                console.error("Poster download error:", err);
                alert("មិនអាចទាញយករូបភាពបានទេ សូមសាកល្បងម្តងទៀត!");
            });
        }

        function copyPosterToClipboard() {
            const card = getActivePosterCard();
            if (!card) return;

            html2canvas(card, {
                scale: 3,
                useCORS: true,
                allowTaint: true,
                backgroundColor: '#071226',
                logging: false
            }).then(function(canvas) {
                canvas.toBlob(function(blob) {
                    if (navigator.clipboard && navigator.clipboard.write) {
                        const item = new ClipboardItem({ "image/png": blob });
                        navigator.clipboard.write([item]).then(function() {
                            alert("✅ បាន Copy រូបភាព Poster ទៅក្នុង Clipboard រួចរាល់!");
                        }).catch(function(e) {
                            downloadPosterImage();
                        });
                    } else {
                        downloadPosterImage();
                    }
                }, "image/png", 1.0);
            }).catch(function(err) {
                console.error("Poster copy error:", err);
                downloadPosterImage();
            });
        }

        // Price History Log System
        function getPriceHistoryList() {
            try {
                const data = localStorage.getItem('imvoi_price_history_logs');
                return data ? JSON.parse(data) : [];
            } catch(e) {
                return [];
            }
        }

        function savePriceHistoryList(list) {
            try {
                localStorage.setItem('imvoi_price_history_logs', JSON.stringify(list));
            } catch(e){}
        }

        function recordCurrentPriceLog(note = 'កែប្រែដោយដៃ') {
            const now = new Date();
            const pad = function(n){ return String(n).padStart(2, '0'); };
            const timestamp = `${pad(now.getDate())}/${pad(now.getMonth()+1)}/${now.getFullYear()} ${pad(now.getHours())}:${pad(now.getMinutes())}`;
            
            const cur = window.currentQuoteCategory || 'car';
            const getV = function(id){ return document.getElementById(id)?.value || ''; };

            let col1Val = '';
            let col2Val = '';

            if (cur === 'car') {
                col1Val = `${getV('cfgPpSuv')} | ${getV('cfgPpAlphard')} | ${getV('cfgPpHiace')}`;
                col2Val = `${getV('cfgSrSuv')} | ${getV('cfgSrAlphard')} | ${getV('cfgSrHiace')}`;
            } else if (cur === 'vip') {
                col1Val = `${getV('cfgVipPpIn')} | ${getV('cfgVipPpVisaEb')} | ${getV('cfgVipPpOut')} | ${getV('cfgVipPpEscort')}`;
                col2Val = `${getV('cfgVipSrIn')} | ${getV('cfgVipSrVisaEb')} | ${getV('cfgVipSrOut')} | ${getV('cfgVipSrEscort')}`;
            } else if (cur === 'visa') {
                col1Val = `${getV('cfgVisaTour')} | ${getV('cfgVisaBiz')} | ${getV('cfgVisaExp')}`;
                col2Val = `${getV('cfgVisaExt1M')} | ${getV('cfgVisaExt3M')} | ${getV('cfgVisaExt6M')}`;
            }

            const item = {
                id: Date.now(),
                category: cur,
                timestamp: timestamp,
                note: note,
                pricesData: { col1Val: col1Val, col2Val: col2Val }
            };

            const list = getPriceHistoryList();
            list.unshift(item);
            if (list.length > 50) list.pop();
            savePriceHistoryList(list);
            renderPriceHistoryTable();
        }

        function renderPriceHistoryTable() {
            const tbody = document.getElementById('priceHistoryTableBody');
            const totalCount = document.getElementById('priceHistoryTotalCount');
            if (!tbody) return;

            const cur = window.currentQuoteCategory || 'car';
            const list = getPriceHistoryList().filter(function(it){ return (it.category || 'car') === cur; });

            if (totalCount) totalCount.textContent = list.length;
            tbody.innerHTML = '';

            if (list.length === 0) {
                tbody.innerHTML = `<tr><td colspan="4" style="text-align: center; color: #94a3b8; padding: 18px 0; font-weight: 600;">មិនទាន់មានប្រវត្តិកត់ត្រាតម្លៃសម្រាប់ផ្នែកនេះនៅឡើយទេ</td></tr>`;
                return;
            }

            list.forEach(function(item) {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td style="font-weight: 700; color: #1e293b; white-space: nowrap; font-size: 11px;">📅 ${item.timestamp}</td>
                    <td style="color: #0284c7; font-weight: 800; text-align: center; font-size: 11px;">${item.pricesData?.col1Val || '-'}</td>
                    <td style="color: #059669; font-weight: 800; text-align: center; font-size: 11px;">${item.pricesData?.col2Val || '-'}</td>
                    <td style="text-align: center; white-space: nowrap;">
                        <button type="button" onclick="applyPriceHistoryLog(${item.id})" title="ប្រើតម្លៃកាលបរិច្ឆេទនេះ" style="background: #3b82f6; color: #ffffff; border: none; border-radius: 4px; padding: 3px 7px; font-size: 10.5px; font-weight: 800; cursor: pointer; margin-right: 4px;">🔄 ប្រើ</button>
                        <button type="button" onclick="deletePriceHistoryLog(${item.id})" title="លុបកំណត់ត្រានេះ" style="background: #fee2e2; color: #ef4444; border: 1px solid #fca5a5; border-radius: 4px; padding: 3px 7px; font-size: 10.5px; font-weight: 800; cursor: pointer;">🗑️</button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function applyPriceHistoryLog(id) {
            const list = getPriceHistoryList();
            const found = list.find(function(it) { return it.id === id; });
            if (!found) return;

            const setV = function(elemId, val) { const el = document.getElementById(elemId); if (el) el.value = val; };
            const pData = found.pricesData || {};

            if (found.category === 'car' || !found.category) {
                if (pData.col1Val) {
                    const parts1 = pData.col1Val.split('|').map(function(s){ return s.trim(); });
                    if (parts1[0]) setV('cfgPpSuv', parts1[0]);
                    if (parts1[1]) setV('cfgPpAlphard', parts1[1]);
                    if (parts1[2]) setV('cfgPpHiace', parts1[2]);
                }
                if (pData.col2Val) {
                    const parts2 = pData.col2Val.split('|').map(function(s){ return s.trim(); });
                    if (parts2[0]) setV('cfgSrSuv', parts2[0]);
                    if (parts2[1]) setV('cfgSrAlphard', parts2[1]);
                    if (parts2[2]) setV('cfgSrHiace', parts2[2]);
                }
            } else if (found.category === 'vip') {
                if (pData.col1Val) {
                    const parts1 = pData.col1Val.split('|').map(function(s){ return s.trim(); });
                    if (parts1[0]) setV('cfgVipPpIn', parts1[0]);
                    if (parts1[1]) setV('cfgVipPpVisaEb', parts1[1]);
                    if (parts1[2]) setV('cfgVipPpOut', parts1[2]);
                    if (parts1[3]) setV('cfgVipPpEscort', parts1[3]);
                }
                if (pData.col2Val) {
                    const parts2 = pData.col2Val.split('|').map(function(s){ return s.trim(); });
                    if (parts2[0]) setV('cfgVipSrIn', parts2[0]);
                    if (parts2[1]) setV('cfgVipSrVisaEb', parts2[1]);
                    if (parts2[2]) setV('cfgVipSrOut', parts2[2]);
                    if (parts2[3]) setV('cfgVipSrEscort', parts2[3]);
                }
            } else if (found.category === 'visa') {
                if (pData.col1Val) {
                    const parts1 = pData.col1Val.split('|').map(function(s){ return s.trim(); });
                    if (parts1[0]) setV('cfgVisaTour', parts1[0]);
                    if (parts1[1]) setV('cfgVisaBiz', parts1[1]);
                    if (parts1[2]) setV('cfgVisaExp', parts1[2]);
                }
                if (pData.col2Val) {
                    const parts2 = pData.col2Val.split('|').map(function(s){ return s.trim(); });
                    if (parts2[0]) setV('cfgVisaExt1M', parts2[0]);
                    if (parts2[1]) setV('cfgVisaExt3M', parts2[1]);
                    if (parts2[2]) setV('cfgVisaExt6M', parts2[2]);
                }
            }

            syncAllQuotePrices();
            alert('✅ បានប្តូរមកប្រើតម្លៃកាលពីថ្ងៃ: ' + found.timestamp + ' រួចរាល់!');
        }

        function deletePriceHistoryLog(id) {
            if (!confirm('តើអ្នកពិតជាចង់លុបកំណត់ត្រាតម្លៃនេះមែនទេ?')) return;
            let list = getPriceHistoryList();
            list = list.filter(function(it) { return it.id !== id; });
            savePriceHistoryList(list);
            renderPriceHistoryTable();
        }

        function clearAllPriceLogs() {
            const cur = window.currentQuoteCategory || 'car';
            if (!confirm('តើអ្នកពិតជាចង់សម្អាតប្រវត្តិទាំងអស់នៃផ្នែកនេះមែនទេ?')) return;
            let list = getPriceHistoryList().filter(function(it){ return (it.category || 'car') !== cur; });
            savePriceHistoryList(list);
            renderPriceHistoryTable();
        }

        // Auto Initialize
        document.addEventListener('DOMContentLoaded', function() {
            loadLatestPricesFromStorage();
            syncAllQuotePrices();
            const savedCat = localStorage.getItem('activeQuoteCategoryTab') || 'car';
            window.selectQuoteCategoryTab(savedCat, false);
            if (getPriceHistoryList().length === 0) recordCurrentPriceLog('តម្លៃដំបូង');
            renderPriceHistoryTable();
        });
    </script>
</body>
</html>
